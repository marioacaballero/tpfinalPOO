raphics.LayoutFrame} 935 0 131 0 1049 0 152 0 ) 					#name: #ActionButton3 					#model: #eliminarPelicula 					#label: 'Eliminar' 					#defaultable: true ) 				#(#{UI.ActionButtonSpec} 					#layout: #(#{Graphics.LayoutFrame} 36 0 415 0 148 0 436 0 ) 					#name: #ActionButton4 					#model: #'aspPeliculaObra detalles' 					#label: 'Detalles Avanzados' 					#defaultable: true ) 				#(#{UI.ActionButtonSpec} 					#layout: #(#{Graphics.LayoutFrame} 173 0 416 0 281 0 437 0 ) 					#name: #ActionButton5 					#model: #'aspPeliculaObra critica' 					#label: 'Criticas' 					#defaultable: true ) ) ) )</body></methods><methods><class-id>WListaPeliculaObra</class-id> <category>actions</category><body package="Ventanas" selector="modificarPelicula">modificarPelicula	| pro ventanaProduccion |	pro := self aspPeliculasObras selection.	pro isNil		ifTrue: [Dialog warn: 'No hay produccion seleccionada']		ifFalse: 			[ventanaProduccion := WPelicula new.			ventanaProduccion pelicula: pro.			ventanaProduccion open.			ventanaProduccion acepto				ifTrue: 					[adm modificarPelicula: ventanaProduccion aspPelicula value.					aspPeliculasObras list: adm peliculas]]</body></methods><methods><class-id>Administrador</class-id> <category>accessing</category><body package="TPFinal" selector="peliculas">peliculas	^peliculas select: [:pel | pel borrado not]</body></methods><methods><class-id>PeliculaObra</class-id> <category>initialize-release</category><body package="TPFinal" selector="initialize">initialize	"Initialize a newly created instance. This method must answer the receiver."	super initialize.	" *** Edit the following to properly initialize instance variables ***"	id := nil.	titulo := nil.	descripcion := nil.	duracion := nil.	clasificacion := nil.	tipo := nil.	elenco := nil.	director := nil.	estado := nil.	banner:=nil.	borrado:=false.	criticas := OrderedCollection new.	" *** And replace this comment with additional initialization code *** "	^self</body></methods><methods><class-id>Administrador</class-id> <category>accessing</category><body package="TPFinal" selector="peliculas">peliculas	^peliculas reject: [:pel | pel borrado == true]</body></methods><do-it>'----SNAPSHOT----'</do-it><do-it>"#('c:\Users\Asus\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im' 'May 1, 2026' '1:13:40 PM')""An image file c:\Users\Asus\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im was created at 13:13:40 on 1 de mayo de 2026."</do-it>