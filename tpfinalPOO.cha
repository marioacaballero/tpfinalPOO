	| ventanaSocios ventanaFunciones ventanaDisponibilidad
	  socioSeleccionado funcionSeleccionada salaDeFuncion |
	ventanaSocios := WSeleccionarSocio new.
	ventanaSocios adm: adm.
	ventanaSocios open.
	ventanaSocios accept value ifFalse: [^self].
	socioSeleccionado := ventanaSocios aspSocios selection.

	ventanaFunciones := WSeleccionarFuncion new.
	ventanaFunciones adm: adm.
	ventanaFunciones open.
	ventanaFunciones accept value ifFalse: [^self].
	funcionSeleccionada := ventanaFunciones aspFunciones selection.

	salaDeFuncion := adm salaConId: funcionSeleccionada idSala.

	ventanaDisponibilidad := WDisponibilidadSala new.
	ventanaDisponibilidad adm: adm.
	ventanaDisponibilidad salaSeleccionada: salaDeFuncion.
	ventanaDisponibilidad funcionSeleccionada: funcionSeleccionada.
	ventanaDisponibilidad open.
	ventanaDisponibilidad accept value ifFalse: [^self].

