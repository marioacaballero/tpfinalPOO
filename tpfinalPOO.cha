<category>accessing</category><body package="EjParcial2023" selector="cantidadDeAutoresPorArticulo">cantidadDeAutoresPorArticulo	| cantidadAutores autPorArt listaAutoresPorArt |	listaAutoresPorArt := OrderedCollection new.	articulos do: 			[:art |			cantidadAutores := 0.			cantidadAutores := (asignaciones						select: [:asig | asig idArticulo = art id &amp; (asig rol = #autor)]) size.			autPorArt := (AutoresPorArticulo new)						idArticulo: art id;						titulo: art titulo;						cantidadAutores: cantidadAutores.			listaAutoresPorArt add: autPorArt]</body></methods><methods><class-id>OCS</class-id> <category>accessing</category><body package="EjParcial2023" selector="cantidadDeAutoresPorArticulo">cantidadDeAutoresPorArticulo	| cantidadAutores autPorArt listaAutoresPorArt |	listaAutoresPorArt := OrderedCollection new.	articulos do: 			[:art |			cantidadAutores := 0.			cantidadAutores := (asignaciones						select: [:asig | asig idArticulo = art id &amp; (asig rol = #autor)]) size.			autPorArt := (AutoresPorArticulo new)						idArticulo: art id;						titulo: art titulo;						cantidadAutores: cantidadAutores.			listaAutoresPorArt add: autPorArt].	^listaAutoresPorArt		asSortedCollection: [:x :y | x cantidadAutores &gt; y cantidadAutores]</body></methods><methods><class-id>OCS</class-id> <category>accessing</category><body package="EjParcial2023" selector="proponerEvaluadoresParaArticulo:">proponerEvaluadoresParaArticulo: idArticuloasignaciones select: [:asig | asig idArticulo = idArticulo]</body></methods><methods><class-id>OCS</class-id> <category>accessing</category><body package="EjParcial2023" selector="proponerEvaluadoresParaArticulo:">proponerEvaluadoresParaArticulo: idArticulo| asigDeArticulo |	asigDeArticulo := asignaciones select: [:asig | asig idArticulo = idArticulo]</body></methods><methods><class-id>OCS</class-id> <category>accessing</category><body package="EjParcial2023" selector="proponerEvaluadoresParaArticulo:">proponerEvaluadoresParaArticulo: idArticulo| asigDeArticulo personasQueEvaluaron |	asigDeArticulo := asignaciones select: [:asig | asig idArticulo = idArticulo].	personasQueEvaluaron := asigDeArticulo collect: [:asig | personas detect: [:per | per id = asig idPersona]].			</body></methods><methods><class-id>OCS</class-id> <category>accessing</category><body package="EjParcial2023" selector="proponerEvaluadoresParaArticulo:">proponerEvaluadoresParaArticulo: idArticulo	| asigDeArticulo personasQueEvaluaron |	asigDeArticulo := asignaciones				select: [:asig | asig idArticulo = idArticulo &amp; (asig rol = #evaluador)].	personasQueEvaluaron := asigDeArticulo				collect: [:asig | personas detect: [:per | per id = asig idPersona]]</body></methods><methods><class-id>OCS</class-id> <category>accessing</category><body package="EjParcial2023" selector="proponerEvaluadoresParaArticulo:">proponerEvaluadoresParaArticulo: idArticulo	| asigDeArticulo personasQueEvaluaron posiblesPersonas |	asigDeArticulo := asignaciones				select: [:asig | asig idArticulo = idArticulo &amp; (asig rol = #evaluador)].	personasQueEvaluaron := asigDeArticulo				collect: [:asig | personas detect: [:per | per id = asig idPersona]].					posiblesPersonas := personas reject: [:per | (personasQueEvaluaron includes: per) not].		"falta verificar que no esten en mas de tres de articulos"</body></methods><methods><class-id>OCS</class-id> <category>accessing</category><body package="EjParcial2023" selector="proponerEvaluadoresParaArticulo:">proponerEvaluadoresParaArticulo: idArticulo	| asigDeArticulo personasQueEvaluaron posiblesPersonas |	asigDeArticulo := asignaciones				select: [:asig | asig idArticulo = idArticulo &amp; (asig rol = #evaluador)].	personasQueEvaluaron := asigDeArticulo				collect: [:asig | personas detect: [:per | per id = asig idPersona]].	posiblesPersonas := personas				reject: [:per | (personasQueEvaluaron includes: per) not].	^posiblesPersonas	"falta verificar que no esten en mas de tres de articulos"</body></methods><component-created><name>EjParcial2023</name> <type>package</type></component-created><class><name>OCS</name><environment>Smalltalk</environment><super>Core.Object</super><private>false</private><indexed-type>none</indexed-type><inst-vars>personas articulos asignaciones </inst-vars><class-inst-vars></class-inst-vars><imports></imports><category></category><attributes><package>BOSS</package></attributes></class><class><name>PersonaOCS</name><environment>Smalltalk</environment><super>Core.Object</super><private>false</private><indexed-type>none</indexed-type><inst-vars>id nombre dni domicilio celular puedeSerEvaluador </inst-vars><class-inst-vars></class-inst-vars><imports></imports><category></category><attributes><package>BOSS</package></attributes></class><class><name>ArticuloOCS</name><environment>Smalltalk</environment><super>Core.Object</super><private>false</private><indexed-type>none</indexed-type><inst-vars>id titulo fechaEnvio estadoRevision </inst-vars><class-inst-vars></class-inst-vars><imports></imports><category></category><attributes><package>BOSS</package></attributes></class><class><name>AsignacionOCS</name><environment>Smalltalk</environment><super>Core.Object</super><private>false</private><indexed-type>none</indexed-type><inst-vars>idPersona rol idArticulo resultado </inst-vars><class-inst-vars></class-inst-vars><imports></imports><category></category><attributes><package>BOSS</package></attributes></class><class><name>AutoresPorArticulo</name><environment>Smalltalk</environment><super>Core.Object</super><private>false</private><indexed-type>none</indexed-type><inst-vars>idArticulo titulo cantidadAutores </inst-vars><class-inst-vars></class-inst-vars><imports></imports><category></category><attributes><package>BOSS</package></attributes></class><methods><class-id>OCS class<