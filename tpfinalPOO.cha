    | butacas anchoButaca altoButaca margen x y color etiqueta rect |
    sala isNil ifTrue: [^self].
    funcion isNil ifTrue: [^self].
    butacas     := sala butacas.
    anchoButaca := 100.
    altoButaca  := 80.
    margen      := 16.
    butacas do: [:butaca |
        x := (margen + ((butaca posicion  - 1) * (anchoButaca + margen))) truncated.
        y := (margen + ((butaca posicionY - 1) * (altoButaca  + margen))) truncated.
        rect := x @ y extent: anchoButaca @ altoButaca.
        "Relleno con color"
        color := (adm estaReservadaButaca: butaca paraFuncion: funcion)
                    ifTrue:  [ColorValue red]
                    ifFalse: [ColorValue green].
        aGraphicsContext paint: color.
        aGraphicsContext displayRectangle: rect.
        "Borde negro encima"
        aGraphicsContext paint: ColorValue black.
        aGraphicsContext displayRectangularBorder: rect.
        "Etiqueta"
        etiqueta := (String with: butaca fila), butaca numero printString.
        aGraphicsContext paint: ColorValue black.
        aGraphicsContext displayString: etiqueta at: (x + 5) @ (y + 10)
    ]</body></methods><class><name>WDisponibilidadSala</name><environment>Smalltalk</environment><super>UI.SimpleDialog</super><private>false</private><indexed-type>none</indexed-type><inst-vars>salaSeleccionada adm </inst-vars><class-inst-vars></class-inst-vars><imports></imports><category></category><attributes><package>Ventanas</package></attributes></class><do-it>WDisponibilidadSala addInstVarName: 'adm'</do-it><methods><class-id>WDisponibilidadSala</class-id> <category>accessing</category><body package="Ventanas" selector="adm">adm
