pplication false ) 							#model: #'aspPeliculaObra tipo' 							#label: 'Tipo' 							#labelIsImage: false 							#width: 80 							#rendererType: #Text 							#editorType: #None 							#type: #object 							#noScroll: false 							#formatString: '' ) 						#(#{UI.DataSetColumnSpec} 							#properties: #(#{UI.PropertyListDictionary} #allowSorting true #labelFromApplication false ) 							#model: #'aspPeliculaObra estado' 							#label: 'Estado' 							#labelIsImage: false 							#width: 80 							#rendererType: #Text 							#editorType: #None 							#type: #object 							#noScroll: false 							#formatString: '' ) ) ) 				#(#{UI.ActionButtonSpec} 					#layout: #(#{Graphics.LayoutFrame} 935 0 50 0 1052 0 71 0 ) 					#name: #ActionButton1 					#model: #'aspPeliculaObra altaPelicula' 					#label: 'Agregar' 					#defaultable: true ) 				#(#{UI.ActionButtonSpec} 					#layout: #(#{Graphics.LayoutFrame} 934 0 92 0 1049 0 113 0 ) 					#name: #ActionButton2 					#model: #'aspPeliculaObra modificarPelicula' 					#label: 'Modificar' 					#defaultable: true ) 				#(#{UI.ActionButtonSpec} 					#layout: #(#{Graphics.LayoutFrame} 935 0 131 0 1049 0 152 0 ) 					#name: #ActionButton3 					#model: #'aspPeliculaObra eliminarPelicula' 					#label: 'Eliminar' 					#defaultable: true ) 				#(#{UI.ActionButtonSpec} 					#layout: #(#{Graphics.LayoutFrame} 36 0 415 0 148 0 436 0 ) 					#name: #ActionButton4 					#model: #'aspPeliculaObra detalles' 					#label: 'Detalles Avanzados' 					#defaultable: true ) 				#(#{UI.ActionButtonSpec} 					#layout: #(#{Graphics.LayoutFrame} 173 0 416 0 281 0 437 0 ) 					#name: #ActionButton5 					#model: #'aspPeliculaObra critica' 					#label: 'Criticas' 					#defaultable: true ) ) ) )</body></methods><methods><class-id>WListaPeliculaObra</class-id> <category>As yet unclassified</category><body package="Ventanas" selector="altaPelicula">altaPelicula	| ventanaPelicula nuevaPelicula |	ventanaPelicu