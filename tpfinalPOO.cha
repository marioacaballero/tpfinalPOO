    | butacas anchoButaca altoButaca margen x y color |
    sala isNil ifTrue: [^self].
    butacas       := sala butacas.   "coleccion de butacas"
    anchoButaca   := 35.
    altoButaca    := 28.
    margen        := 6.

    butacas do: [:butaca |
        x := margen + ((butaca columna - 1) * (anchoButaca + margen)).
        y := margen + ((butaca fila    - 1) * (altoButaca  + margen)).

        "--- fondo verde=disponible, rojo=ocupada ---"
        color := butaca estaDisponible
                    ifTrue:  [ColorValue green]
                    ifFalse: [ColorValue red].
        aGraphicsContext paint: color.
        aGraphicsContext
            fillRectangle: (x @ y extent: anchoButaca @ altoButaca).

        "--- borde negro ---"
        aGraphicsContext paint: ColorValue black.
        aGraphicsContext
            displayRectangle: (x @ y extent: anchoButaca @ altoButaca).

        "--- número de butaca centrado ---"
        aGraphicsContext
            displayString: butaca numero printString
            at: (x + 8) @ (y + 9)
    ]</body></methods><methods><class-id>ButacasGridView</class-id> <category>displaying</category><body package="Ventanas" selector="displayOn:">displayOn: aGraphicsContext    | butacas anchoButaca altoButaca margen x y color |    sala isNil ifTrue: [^self].    butacas       := sala butacas.   "coleccion de butacas"    anchoButaca   := 35.    altoButaca    := 28.    margen        := 6.    butacas do: [:butaca |        x := margen + ((butaca butacasFila - 1) * (anchoButaca + margen)).        y := margen + ((butaca fila    - 1) * (altoButaca  + margen)).        "--- fondo verde=disponible, rojo=ocupada ---"        color := butaca es                    ifTrue:  [ColorValue green]                    ifFalse: [ColorValue red].        aGraphicsContext paint: color.        aGraphicsContext            fillRectangle: (x @ y extent: anchoButaca @ altoButaca).        "--- borde negro ---"        aGraphicsContext paint: ColorValue black.        aGraphicsContext            displayRectangle: (x @ y extent: anchoButaca @ altoButaca).        "--- número de butaca centrado ---"        aGraphicsContext            displayString: butaca numero printString            at: (x + 8) @ (y + 9)    ]</body></methods><class><name>Butaca</name><environment>Smalltalk</environment><super>Core.Object</super><private>false</private><indexed-type>none</indexed-type><inst-vars>fila numero posicion posicionY id estaDisponible </inst-vars><class-inst-vars></class-inst-vars><imports></imports><category></category><attributes><package>TPFinal</package></attributes></class><methods><class-id>Butaca</class-id> <category>accessing</category><body package="TPFinal" selector="estaDisponible">estaDisponible	^estaDisponible</body></methods><methods><class-id>Butaca</class-id> <category>accessing</category><body package="TPFinal" selector="estaDisponible:">estaDisponible: anObject	estaDisponible := anObject</body></methods><methods><class-id>B