ackage="Ventanas" selector="aspImagenBanner">aspImagenBanner
    "Aspecto para el Label de la imagen"
    ^aspImagenBanner isNil
        ifTrue: [aspImagenBanner := Image new asValue]
        ifFalse: [aspImagenBanner]</body></methods><methods><class-id>WListaPeliculaObra</class-id> <category>actions</category><body package="Ventanas" selector="imagenActual">imagenActual
    "Este es el método que pide tu windowSpec"
    ^self aspImagenBanner</body></methods><methods><class-id>WListaPeliculaObra</class-id> <category>aspects</category><body package="Ventanas" selector="aspPeliculasObras">aspPeliculasObras
    ^aspPeliculasObras isNil
        ifTrue: [
            aspPeliculasObras := SelectionInList new.
            "Cuando cambia la selección, actualizamos la película actual y su imagen"
            aspPeliculasObras selectionIndexHolder compute: [:v | 
                | peli |
                peli := aspPeliculasObras selection.
                self aspPeliculaObra value: peli.
                
                "Actualizamos el ValueHolder de la imagen"
                (peli isNil or: [peli banner isNil])
                    ifTrue: [self aspImagenBanner value: Image new]
                    ifFalse: [self aspImagenBanner value: peli banner].
            ].
            aspPeliculasObras]
        ifFalse: [aspPeliculasObras]</body></methods><methods><class-id>WListaPeliculaObra class</class-id> <category>interface specs</category><body package="Ventanas" selector="windowSpec">windowSpec	"Tools.UIPainter new openOnClass: self andSelector: #windowSpec"	&lt;resource: #canvas&gt;	^#(#{UI.FullSpec} 		#window: 		#(#{UI.WindowSpec} 			#label: 'Peliculas/Obras' 			#bounds: #(#{Graphics.Rectangle} 107 31 1259 776 ) ) 		#component: 		#(#{UI.SpecCollection} 			#collection: #(				#(#{UI.DataSetSpec} 					#properties: #(#{UI.PropertyListDictionary} #showHorizontalLines true #allowColumnResizing true #allowColumnReordering false #showVerticalLines true ) 					#layout: #(#{Graphics.LayoutFrame} 30 0 120 0 536 0 445 0 ) 					#name: #Dataset1 					#columns: #(						#(#{UI.DataSetColumnSpec} 							#properties: #(#{UI.PropertyListDictionary} #allowSorting true #labelFromApplication false ) 							#model: #'aspPeliculaObra id' 							#label: 'id' 							#labelIsImage: false 							#width: 80 							#rendererType: #Text 							#editorType: #None 							#type: #number 							#noScroll: false ) 						#(#{UI.DataSetColumnSpec} 							#properties: #(#{UI.PropertyListDictionary} #allowSorting true #labelFromApplication false ) 							#model: #'aspPeliculaObra nombre' 							#label: 'titulo' 							#labelIsImage: false 							#width: 80 							#rendererType: #Text 							#editorType: #None 							#noScroll: false ) 						#(#{UI.DataSetColumnSpec} 							#properties: #(#{UI.PropertyListDictionary} #allowSorting true #labelFromApplication false ) 							#model: #'aspPeliculaObra duracion' 							#label: 'duracion' 							#labelIsImage: false 							#width: 80 							#rendererType: #Text 							#editorType: #None 							#type: #number 							#noScroll: false ) 						#(#{UI.DataSetColumnSpec} 							#properties: #(#{UI.PropertyListDictionary} #allowSorting true #labelFromApplication false ) 							#model: #'aspPeliculaObra clasificacion' 							#label: 'clasificacion' 							#labelIsImage: false 							#width: 80 							#rendererType: #Text 							#editorType: #None 							#noScroll: false ) 						#(#{UI.DataSetColumnSpec} 							#properties: #(#{UI.PropertyListDictionary} #allowSorting true #labelFromApplication false ) 							#model: #aspPeliculaObra 							#label: 'tipo' 							#labelIsImage: false 							#width: 80 							#rendererType: #Text 							#editorType: #None 							#noScroll: false ) 						#(#{UI.DataSetColumnSpec} 							#properties: #(#{UI.PropertyListDictionary} #allowSorting true #labelFromApplication false ) 							#model: #'aspPeliculaObra estado' 							#label: 'estado' 							#labelIsImage: false 							#width: 80 							#rendererType: #Text 							#editorType: #None 							#type: #object 							#noScroll: false 							#formatString: '' ) ) ) 				#(#{UI.LabelSpec} 					#properties: #(#{UI.PropertyListDictionary} #labelFromApplication true ) 					#layout: #(#{Graphics.LayoutOrigin} 695 0 71 0 ) 					#name: #Label1 					#label: #imagenActual 					#style: #default 					#hasCharacterOrientedLabel: false ) ) ) )</body></methods><methods><class-id>WListaPeliculaObra</class-id> <category>actions</category><body package="Ventanas" selector="imagenActual">imagenActual
        | peli |
        peli := self aspPeliculaObra value.
        ^(peli isNil or: [peli banner isNil])
            ifTrue: [Image new] "Imagen vacía para evitar el crash"
            ifFalse: [peli banner]
    
   
 </body></methods><methods><class-id>WListaPeliculaObra</class-id> <category>aspects</category><body package="Ventanas" selector="aspPeliculasObras"> aspPeliculasObras
        ^aspPeliculasObras isNil
            ifTrue: [
                aspPeliculasObras := SelectionInList new.
                aspPeliculasObras selectionIndexHolder compute: [:v |
                    self aspPeliculaObra value: aspPeliculasObras selection.
                    "Buscamos el widget por su ID (#Label1) y le inyectamos la imagen"
                    (self builder componentAt: #Label1) ifNotNil: [:wrapper |
                        wrapper widget label: self imagenActual.
                        wrapper widget redisplay].
                ].
                aspPeliculasObras]
            ifFalse: [aspPeliculasObras]</body></methods><methods><class-id>WListaPeliculaObra</class-id> <category>actions</category><body package="Ventanas" selector="imagenActual">imagenActual
    "Este método lo llama el Builder al abrir o refrescar"
    | pelicula |
    pelicula := self aspPeliculaObra value.
    
    "Si no hay selección o la película no tiene banner, devolvemos una imagen vacía"
    (pelicula isNil or: [pelicula banner isNil])
        ifTrue: [ ^Image new ].
        
    ^pelicula banner</body></methods><methods><class-id>WListaPeliculaObra</class-id> <category>aspects</category><body package="Ventanas" selector="aspPeliculasObras">aspPeliculasObras
    ^aspPeliculasObras isNil
        ifTrue: [
            aspPeliculasObras := SelectionInList new.
            aspPeliculasObras selectionIndexHolder compute: [:v | 
                "1. Actualizamos el valor de la película actual"
                self aspPeliculaObra value: aspPeliculasObras selection.
                
                "2. Forzamos al Label a pedir la imagen de nuevo y redibujarse"
                (self builder componentAt: #Label1) ifNotNil: [:wrapper |
                    wrapper widget label: self imagenActual.
                    wrapper widget redisplay].
            ].
            aspPeliculasObras]
        ifFalse: [aspPeliculasObras]</body></methods><methods><class-id>WListaPeliculaObra</class-id> <category>actions</category><body package="Ventanas" selector="imagenActual">imagenActual    "Este método lo llama el Builder al abrir o refrescar"    | pelicula |    pelicula := self aspPeliculaObra value.        "Si no hay selección o la película no tiene banner, devolvemos una imagen vacía"    (pelicula isNil or: [pelicula banner isNil])        ifTrue: [ ^Image new asValue ].            ^pelicula banner asValue</body></methods><methods><class-id>WListaPeliculaObra</class-id> <category>actions</category><body package="Ventanas" selector="imagenActual">imagenActual    "Este método lo llama el Builder al abrir o refrescar"    | pelicula |    pelicula := self aspPeliculaObra value.        "Si no hay selección o la película no tiene banner, devolvemos una imagen vacía"    (pelicula isNil or: [pelicula banner isNil])        ifTrue: [ ^Image new ].            ^pelicula banner </body></methods><methods><class-id>WListaPeliculaObra</class-id> <category>actions</category><body package="Ventanas" selector="imagenActual">imagenActual
    | peli |
    peli := self aspPeliculaObra value.

    "Si no hay película o banner, devolvemos un cuadrado blanco de 1x1"
    (peli isNil or: [peli banner isNil]) ifTrue: [
        ^Image extent: 1@1 
               depth: 1 
               palette: (MappedPalette withColors: (Array with: Glorp white)) 
               bits: (ByteArray with: 0)
    ].

    ^peli banner</body></methods><methods><class-id>WListaPeliculaObra</class-id> <category>actions</category><body package="Ventanas" selector="imagenActual">imagenActual
    | peli |
    peli := self aspPeliculaObra value.
    
    "Si no hay película o banner, creamos una imagen mínima con rutas absolutas"
    (peli isNil or: [peli banner isNil]) ifTrue: [
        ^Graphics.Image 
            extent: 1@1 
            depth: 1 
            palette: Graphics.MonoMappedPalette blackWhite 
            bits: (Core.ByteArray with: 0).
    ].
    
    ^peli banner</body></methods><methods><class-id>WListaPeliculaObra</class-id> <category>actions</category><body package="Ventanas" selector="imagenActual">imagenActual
    | peli |
    peli := self aspPeliculaObra value.
    
    "Si no hay película o banner, devolvemos una imagen mínima válida"
    (peli isNil or: [peli banner isNil]) ifTrue: [
        ^(Graphics.Image extent: 1@1)
            palette: Graphics.MonoMappedPalette blackWhite;
            yourself.
    ].
    
    ^peli banner</body></methods><methods><class-id>WListaPeliculaObra</class-id> <category>actions</category><body package="Ventanas" selector="imagenActual">imagenActual
    | peli |
    peli := self aspPeliculaObra value.
    
    "Si no hay película o el banner es nil"
    (peli isNil or: [peli banner isNil]) ifTrue: [
        "Creamos una imagen de 1x1 píxel, profundidad de 1 bit, 
         usando una paleta monocromática y un array de 1 byte"
        ^Graphics.Image 
            extent: 1@1 
            depth: 1 
            palette: Graphics.MonoMappedPalette blackWhite 
            bits: (Core.ByteArray with: 0).
    ].
    
    ^peli banner</body></methods><class><name>WListaPeliculaObra</name><environment>Smalltalk</environment><super>UI.ApplicationModel</super><private>false</private><indexed-type>none</indexed-type><inst-vars></inst-vars><class-inst-vars></class-inst-vars><imports></imports><category></category><attributes><package>Ventanas</package></attributes></class><methods><class-id>WListaPeliculaObra class</class-id> <category>interface specs</category><body package="Ventanas" selector="windowSpec">windowSpec	"Tools.UIPainter new openOnClass: self andSelector: #windowSpec"	&lt;resource: #canvas&gt;	^#(#{UI.FullSpec} 		#window: 		#(#{UI.WindowSpec} 			#label: 'Peliculas y Obras' 			#bounds: #(#{Graphics.Rectangle} 0 23 1152 768 ) 			#flags: 8 ) 		#component: 		#(#{UI.SpecCollection} 			#collection: #(				#(#{UI.DataSetSpec} 					#properties: #(#{UI.PropertyListDictionary} #showHorizontalLines true #allowColumnResizing true #showVerticalLines true ) 					#layout: #(#{Graphics.LayoutFrame} 23 0 24 0 532 0 354 0 ) 					#name: #Dataset1 					#columns: #(						#(#{UI.DataSetColumnSpec} 							#properties: #(#{UI.PropertyListDictionary} #labelFromApplication false #allowSorting true ) 							#model: #aspPeliculaObra 							#label: 'Id' 							#labelIsImage: false 							#width: 80 							#rendererType: #Text 							#editorType: #None 							#type: #number 							#noScroll: false ) 						#(#{UI.DataSetColumnSpec} 							#properties: #(#{UI.PropertyListDictionary} #labelFromApplication false #allowSorting true ) 							#model: #'aspPeliculaObra titulo' 							#label: 'Titulo' 							#labelIsImage: false 							#width: 80 							#rendererType: #Text 							#editorType: #None 							#noScroll: false ) 						#(#{UI.DataSetColumnSpec} 							#properties: #(#{UI.PropertyListDictionary} #labelFromApplication false #allowSorting true ) 							#model: #'aspSala Duracion' 							#label: 'Duracion' 							#labelIsImage: false 						