ackage="TPFinal" selector="iniciarTodo">iniciarTodo	ultimosIds := Dictionary new.	self iniciarIds.	self iniciarPersonas.	self iniciarSocios.	self iniciarPeliculas.	self iniciarSalas.	self iniciarButacas.	self iniciarFunciones.	self iniciarCriticos.	self iniciarCriticas.	self iniciarReservas</body></methods><methods><class-id>WListaReservas</class-id> <category>accessing</category><body package="Ventanas" selector="adm:">adm: unAdministrador	adm := unAdministrador.	self aspReservas list: unAdministrador reservas</body></methods><methods><class-id>WListaReservas</class-id> <category>accessing</category><body package="Ventanas" selector="adm:">adm: unAdministrador	adm := unAdministrador.	self aspReservas list: adm reservas</body></methods><methods><class-id>WMenuAdministrador</class-id> <category>actions</category><body package="Ventanas" selector="mostrarReservas">mostrarReservas	| ventanaReservas |	ventanaReservas := WListaReservas new.	ventanaReservas adm: adm.	"para acceder al adm de forma directa"	ventanaReservas open</body></methods><do-it>'----SNAPSHOT----'</do-it><do-it>"#('c:\Users\mario\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im' 'June 26, 2026' '5:01:34 PM')""An image file c:\Users\mario\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im was created at 5:01:34 PM on June 26, 2026."</do-it><methods><class-id>WMenuAdministrador class</class-id> <category>interface specs</category><body package="Ventanas" selector="windowSpec">windowSpec	"Tools.UIPainter new openOnClass: self andSelector: #windowSpec"	&lt;resource: #canvas&gt;	^#(#{UI.FullSpec} 		#window: 		#(#{UI.WindowSpec} 			#properties: #(#{UI.PropertyListDictionary} #sizeType #specifiedSize #positionType #screenCenter #openType #advanced ) 			#label: 'Menu Administrador' 			#min: #(#{Core.Point} 20 20 ) 			#max: #(#{Core.Point} 0 0 ) 			#bounds: #(#{Graphics.Rectangle} 318 108 768 638 ) ) 		#component: 		#(#{UI.SpecCollecti