ss-inst-vars><imports></imports><category></category><attributes><package>Ventanas</package></attributes></class><methods><class-id>WSeleccionarSocio</class-id> <category>accessing</category><body package="Ventanas" selector="adm">adm	^adm</body></methods><methods><class-id>WSeleccionarSocio</class-id> <category>accessing</category><body package="Ventanas" selector="adm:">adm: anObject	adm := anObject</body></methods><methods><class-id>WSeleccionarSocio</class-id> <category>accessing</category><body package="Ventanas" selector="adm:">adm: unAdministrador	adm := unAdministrador.	self AspSocios list: adm socios.	</body></methods><methods><class-id>WSeleccionarSocio</class-id> <category>accessing</category><body package="Ventanas" selector="adm:">adm: unAdministrador	adm := unAdministrador.	self AspSocios list: adm socios</body></methods><methods><class-id>WListaReservas</class-id> <category>actions</category><body package="Ventanas" selector="botonNuevaReserva">botonNuevaReserva	| ventanaSocio |	ventanaSocio := WSeleccionarSocio new.	ventanaSocio adm: adm.	ventanaSocio open</body></methods><do-it>'----SNAPSHOT----'</do-it><do-it>"#('c:\Users\Abril Dacuez\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im' 'June 30, 2026' '8:56:47 PM')""An image file c:\Users\Abril Dacuez\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im was created at 20:56:47 on 30 de junio de 2026."</do-it><methods><class-id>WSeleccionarSocio</class-id> <category>actions</category><body package="Ventanas" selector="botonSeleccionarSocio">botonSeleccionarSocio	self AspSocios selection isNil		ifTrue: [^Dialog warn: 'Por favor, seleccione un socio.'].	self accept value: true.	self closeRequest</body></methods><methods><class-id>WListaReservas</class-id> <category>actions</category><body package="Ventanas" selector="botonNuevaReserva">botonNuevaReserva	| ventanaSocio socioSeleccionado |	ventanaSocio := WSeleccionarSoc