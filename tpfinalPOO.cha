>agregarPelicula</selector></remove-selector><methods><class-id>WListaPeliculaObra</class-id> <category>As yet unclassified</category><body package="Ventanas" selector="altaPelicula">altaPelicula	| ventanaPelicula nuevaPelicula |	ventanaPelicula := WPelicula new.	nuevaPelicula := PeliculaObra new				id: (adm ultimosIds at: Administrador ultimoIdPelicula) + 1.	ventanaPelicula persona: nuevaPelicula.	ventanaPelicula open.	ventanaPelicula acepto		ifTrue: 			[adm agregarPelicula: ventanaPelicula aspPeliculaObra value.			aspPeliculasObras list: adm peliculas]	"	Dialog warn: ventanaPersona aspPersona value printString"</body></methods><methods><class-id>WListaPeliculaObra class</class-id> <category>interface specs</category><body package="Ventanas" selector="windowSpec">windowSpec	"Tools.UIPainter new openOnClass: self andSelector: #windowSpec"	&lt;resource: #canvas&gt;	^#(#{UI.FullSpec} 		#window: 		#(#{UI.WindowSpec} 			#label: 'Peliculas y Obras' 			#bounds: #(#{Graphics.Rectangle} 107 31 1259 776 ) 			#flags: 8 ) 		#component: 		#(#{UI.SpecCollection} 			#collection: #(				#(#{UI.GroupBoxSpec} 					#layout: #(#{Graphics.LayoutFrame} 915 0 20 0 1080 0 331 0 ) 					#name: #GroupBox1 					#label: 'Produccion' ) 				#(#{UI.GroupBoxSpec} 					#layout: #(#{Graphics.LayoutFrame} 24 0 379 0 303 0 445 0 ) 					#name: #GroupBox2 					#label: 'Datos' ) 				#(#{UI.DataSetSpec} 					#properties: #(#{UI.PropertyListDictionary} #showHorizontalLines true #allowColumnResizing true #showVerticalLines true #allowColumnReordering false ) 					#layout: #(#{Graphics.LayoutFrame} 23 0 24 0 532 0 354 0 ) 					#name: #Dataset1 					#flags: 13 					#columns: #(						#(#{UI.DataSetColumnSpec} 							#properties: #(#{UI.PropertyListDictionary} #allowSorting true #labelFromApplication false ) 							#model: #aspPeliculaObra 							#label: 'Id' 							#labelIsImage: false 							#width: 80 							#rendererType: #Text 							#editorType: #No