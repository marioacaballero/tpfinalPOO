	| anchoButaca altoButaca margen x y |
	anchoButaca := 100.
	altoButaca  := 80.
	margen      := 16.
	x := (margen + ((unaButaca posicion  - 1) * (anchoButaca + margen))) truncated.
	y := (margen + ((unaButaca posicionY - 1) * (altoButaca  + margen))) truncated.
	^x @ y extent: anchoButaca @ altoButaca</body></methods><methods><class-id>ButacasGridView</class-id> <category>displaying</category><body package="Ventanas" selector="displayOn:">displayOn: aGraphicsContext
    | butacas color etiqueta rect |
    salaSeleccionada isNil ifTrue: [^self].
    funcionSeleccionada isNil ifTrue: [^self].
    butacas := salaSeleccionada butacas.
    butacas do: [:butaca |
        rect := self rectanguloPara: butaca.
        "Relleno con color"
        color := (butacasSeleccionadas includes: butaca)
                    ifTrue: [ColorValue blue]
                    ifFalse: [
                        (adm estaReservadaButaca: butaca paraFuncion: funcionSeleccionada)
                            ifTrue:  [ColorValue red]
                            ifFalse: [ColorValue green]].
        aGraphicsContext paint: color.
        aGraphicsContext displayRectangle: rect.
        "Borde negro encima"
        aGraphicsContext paint: ColorValue black.
        aGraphicsContext displayRectangularBorder: rect.
        "Etiqueta"
        etiqueta := (String with: butaca fila), butaca numero printString.
        aGraphicsContext paint: ColorValue black.
        aGraphicsContext displayString: etiqueta at: (rect topLeft x + 5) @ (rect topLeft y + 10)
    ]</body></methods><do-it>'----SNAPSHOT----'</do-it><do-it>"#('c:\Users\Asus\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im' 'July 5, 2026' '10:56:22 PM')""An image file c:\Users\Asus\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im was created at 22:56:22 on 5 de julio de 2026."</do-it><class><name>ButacasGridController</name><environment>Smalltalk</environment><super>UI.Controller</super><private>false</private><indexed-type>none</indexed-type><inst-vars></inst-vars><class-inst-vars></class-inst-vars><imports></imports><category></category><attributes><package>Ventanas</package></attributes></class><methods><class-id>ButacasGridController</class-id> <category>initialize-release</category><body package="Ventanas" selector="initialize">initialize	"Initialize a newly created instance. This method must answer the receiver."	super initialize.	" *** Replace this comment with the appropriate initialization code *** "	^self</body></methods><methods><class-id>ButacasGridController</class-id> <category>events</category><body package="Ventanas" selector="redButtonReleasedEvent:">redButtonReleasedEvent: unEvento
