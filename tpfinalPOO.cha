ersona value.	adm actualizarUltimoIdPersona."</body></methods><methods><class-id>WListaPersonas</class-id> <category>actions</category><body package="Ventanas" selector="eliminarPersona">eliminarPersona	| per |	per := self aspPersonas selection.	per isNil ifTrue: [] ifFalse: [adm eliminarPersona: per id]</body></methods><methods><class-id>WListaPersonas</class-id> <category>actions</category><body package="Ventanas" selector="modificarPersona">modificarPersona	| per ventanaPersona |	per := self aspPersonas selection.	per isNil		ifTrue: [Dialog warn: 'No hay persona seleccionada']		ifFalse: 			[ventanaPersona := WPersona new.			ventanaPersona adm: adm.			ventanaPersona persona: per.			ventanaPersona modoEditar.			ventanaPersona open]</body></methods><methods><class-id>WListaPersonas class</class-id> <category>interface specs</category><body package="Ventanas" selector="windowSpec">windowSpec	"Tools.UIPainter new openOnClass: self andSelector: #windowSpec"	&lt;resource: #canvas&gt;	^#(#{UI.FullSpec} 		#window: 		#(#{UI.WindowSpec} 			#label: 'Lista Personas' 			#bounds: #(#{Graphics.Rectangle} 570 354 1400 554 ) ) 		#component: 		#(#{UI.SpecCollection} 			#collection: #(				#(#{UI.ActionButtonSpec} 					#properties: #(#{UI.PropertyListDictionary} #labelFromApplication false ) 					#layout: #(#{Graphics.LayoutFrame} 696 0 9 0 806 0 29 0 ) 					#name: #BotonAgregarPersona 					#model: #altaPersona 					#label: 'Agregar Persona' 					#defaultable: true ) 				#(#{UI.ActionButtonSpec} 					#layout: #(#{Graphics.LayoutFrame} 696 0 48 0 809 0 69 0 ) 					#name: #BotonModificarPersona 					#model: #modificarPersona 					#label: 'Modificar Persona' 					#defaultable: true ) 				#(#{UI.ActionButtonSpec} 					#layout: #(#{Graphics.LayoutFrame} 696 0 87 0 807 0 110 0 ) 					#name: #BotonEliminarPersona 					#model: #eliminarPersona 					#label: 'Eliminar Persona' 					#defaultable: true ) 				#(#{UI.DataSetSpec} 		