    | contenedor areaDeDibujo boton x y ancho alto separacion miSala |
    super postBuildWith: aBuilder.
    
    "1. Obtenemos el contenedor"
    contenedor := (aBuilder componentAt: #contenedorButacas) widget.
    
    miSala := self salaSeleccionada.
    miSala ifNil: [ ^self ].
    
    "2. Creamos nuestra propia área de dibujo sobre la que SÍ tenemos control"
    areaDeDibujo := CompositeView new.
    areaDeDibujo bounds: contenedor bounds.
    
    ancho := 30.
    alto := 30.
    separacion := 5.
    
    1 to: miSala filas do: [ :f |
        1 to: miSala butacasFila do: [ :c |
            boton := ActionButtonView new.
            "Sin label, sin colores, sin nada"
            
            x := (c - 1) * (ancho + separacion).
            y := (f - 1) * (alto + separacion).
            boton bounds: (x @ y extent: ancho @ alto).
            
            areaDeDibujo add: boton.
        ]
    ].
    
    "3. Reemplazamos el contenedor original por nuestra área de dibujo"
    contenedor parentView replaceSubView: contenedor with: areaDeDibujo.</body></methods><methods><class-id>WDisponibilidadSala</class-id> <category>interface opening</category><body package="Ventanas" selector="postBuildWith:">postBuildWith: aBuilder	| contenedor areaDeDibujo boton x y ancho alto separacion miSala |	super postBuildWith: aBuilder.	"1. Obtenemos el contenedor"	contenedor := (aBuilder componentAt: #contenedorButacas) widget.	miSala := self salaSeleccionada.	miSala ifNil: [^self].	"2. Creamos nuestra propia área de dibujo sobre la que SÍ tenemos control"	areaDeDibujo := CompositeView new.	areaDeDibujo bounds: contenedor bounds.	ancho := 30.	alto := 30.	separacion := 5.	1 to: miSala filas		do: 			[:f |			1 to: miSala butacasFila				do: 					[:c |					boton := ActionButtonView new.					"Sin label, sin colores, sin nada"					x := (c - 1) * (ancho + separacion).					y := (f - 1) * (alto + separacion).					boton bounds: (x @ y extent: ancho @ alto).					areaDeDibujo add: boton]].	"3. Reemplazamos el contenedor original por nuestra área de dibujo"	contenedor parentView replaces contenedor with: areaDeDibujo</body></methods><class><name>WDisponibilidadSala</name><environment>Smalltalk</environment><super>UI.ApplicationModel</super><private>false</private><indexed-type>none</indexed-type><inst-vars>salaSeleccionada </inst-vars><class-inst-vars></class-inst-vars><imports></imports><category></category><attributes><package>Ventanas</package></attributes></class><do-it>Smalltalk defineClass: #WDisponibilidadSala	superclass: #{UI.ApplicationModel}	indexedType: #none	private: false	instanceVariableNames: 'salaSeleccionada  '	classInstanceVariableNames: ''	imports: ''	category: ''</do-it><methods><class-id>WDisponibilidadSala</class-id> <category>interface opening</category><body package="Ventanas" selector="postBuildWith:">postBuildWith: aBuilder	(aBuilder componentAt: #contenedorButacas) widget		