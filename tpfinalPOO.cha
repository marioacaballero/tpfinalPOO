aphics.LayoutFrame} 108 0 11 0 488 0 400 0 ) 					#name: #GroupBox2 					#label: 'Datos sobre la produccion' ) 				#(#{UI.InputFieldSpec} 					#layout: #(#{Graphics.LayoutFrame} 203 0 27 0 303 0 48 0 ) 					#name: #InputField1 					#flags: 40 					#model: #'aspPelicula id' 					#isReadOnly: true 					#type: #number ) 				#(#{UI.LabelSpec} 					#layout: #(#{Graphics.LayoutOrigin} 172 0 29 0 ) 					#name: #Label1 					#label: 'id' ) 				#(#{UI.InputFieldSpec} 					#layout: #(#{Graphics.LayoutFrame} 203 0 67 0 303 0 88 0 ) 					#name: #InputField2 					#model: #'aspPelicula titulo' 					#type: #text ) 				#(#{UI.LabelSpec} 					#layout: #(#{Graphics.LayoutOrigin} 154 0 67 0 ) 					#name: #Label2 					#label: 'titulo' ) 				#(#{UI.InputFieldSpec} 					#layout: #(#{Graphics.LayoutFrame} 203 0 106 0 303 0 127 0 ) 					#name: #InputField3 					#model: #'aspPelicula duracion' 					#type: #number ) 				#(#{UI.LabelSpec} 					#layout: #(#{Graphics.LayoutOrigin} 134 0 105 0 ) 					#name: #Label3 					#label: 'Duracion' ) 				#(#{UI.InputFieldSpec} 					#layout: #(#{Graphics.LayoutFrame} 203 0 146 0 303 0 167 0 ) 					#name: #InputField4 					#model: #'aspPelicula clasificacion' 					#type: #text ) 				#(#{UI.LabelSpec} 					#layout: #(#{Graphics.LayoutOrigin} 115 0 147 0 ) 					#name: #Label4 					#label: 'Clasificacion' ) 				#(#{UI.ComboBoxSpec} 					#layout: #(#{Graphics.LayoutFrame} 203 0 188 0 303 0 209 0 ) 					#name: #ComboBox1 					#model: #'aspPelicula tipo' 					#type: #string 					#comboList: #opcionesTipo ) 				#(#{UI.LabelSpec} 					#layout: #(#{Graphics.LayoutOrigin} 159 0 191 0 ) 					#name: #Label5 					#label: 'Tipo' ) 				#(#{UI.InputFieldSpec} 					#layout: #(#{Graphics.LayoutFrame} 203 0 237 0 303 0 258 0 ) 					#name: #InputField5 					#model: #'aspPelicula director' 					#type: #text ) 				#(#{UI.LabelSpec} 					#layout: #(#{Graphics.LayoutOrigin} 140 0 239 0 ) 					#name: #Label6 					#label: 'Director' ) 				#(#{UI.InputFieldSpec} 					#layout: #(#{Graphics.LayoutFrame} 203 0 324 0 459 0 345 0 ) 					#name: #InputField6 					#model: #'aspPelicula elenco' 					#isReadOnly: false 					#type: #text ) 				#(#{UI.LabelSpec} 					#layout: #(#{Graphics.LayoutOrigin} 147 0 322 0 ) 					#name: #Label7 					#label: 'Elenco' ) 				#(#{UI.ActionButtonSpec} 					#layout: #(#{Graphics.LayoutFrame} 115 0 431 0 167 0 452 0 ) 					#name: #ActionButton1 					#model: #botonDarAlta 					#label: 'Guardar' 					#defaultable: true ) 				#(#{UI.ActionButtonSpec} 					#layout: #(#{Graphics.LayoutFrame} 401 0 432 0 453 0 453 0 ) 					#name: #ActionButton2 					#model: #'aspPelicula Cancelar' 					#label: 'Cancelar' 					#defaultable: true ) 				#(#{UI.InputFieldSpec} 					#layout: #(#{Graphics.LayoutFrame} 203 0 367 0 458 0 388 0 ) 					#name: #InputField7 					#model: #'aspPelicula descripcion' 					#type: #text ) 				#(#{UI.LabelSpec} 					#layout: #(#{Graphics.LayoutOrigin} 120 0 367 0 ) 					#name: #Label8 					#label: 'Descripcion' ) 				#(#{UI.InputFieldSpec} 					#layout: #(#{Graphics.LayoutFrame} 203 0 279 0 419 0 300 0 ) 					#name: #InputField8 					#model: #'aspPelicula banner' 					#type: #text ) 				#(#{UI.LabelSpec} 					#layout: #(#{Graphics.LayoutOrigin} 121 0 280 0 ) 					#name: #Label9 					#label: 'URL Banner' ) ) ) )</body></methods><methods><class-id>WListaPeliculaObra</class-id> <category>actions</category><body package="Ventanas" selector="altaPelicula">altaPelicula	| ventanaPelicula nuevaPelicula |	ventanaPelicula := WPelicula new.	nuevaPelicula := PeliculaObra new				id: (adm ultimosIds at: Administrador ultimoIdPelicula) + 1.	ventanaPelicula pelicula: nuevaPelicula.	ventanaPelicula open.	ventanaPelicula acepto		ifTrue: 			[Dialog warn: 'guardando'.				adm agregarPelicula: ventanaPelicula aspPelicula value.			aspPeliculasObras list: adm peliculas].		Dialog warn: ventanaPelicula acepto value printString	</body></methods><methods><class-id>WListaPeliculaObra</class-id> <category>actions</category><body package="Ventanas" selector="altaPelicula">altaPelicula	| ventanaPelicula nuevaPelicula |	ventanaPelicula := WPelicula new.	nuevaPelicula := PeliculaObra new				id: (adm ultimosIds at: Administrador ultimoIdPelicula) + 1.	ventanaPelicula pelicula: nuevaPelicula.	ventanaPelicula open.	ventanaPelicula acepto		ifTrue: 			[Dialog warn: 'guardando'.				adm agregarPelicula: ventanaPelicula aspPelicula value.			aspPeliculasObras list: adm peliculas]		ifFalse:[Dialog warn: ventanaPelicula acepto value printString]		</body></methods><methods><class-id>WListaPeliculaObra</class-id> <category>actions</category><body package="Ventanas" selector="altaPelicula">altaPelicula	| ventanaPelicula nuevaPelicula |	ventanaPelicula := WPelicula new.	nuevaPelicula := PeliculaObra new				id: (adm ultimosIds at: Administrador ultimoIdPelicula) + 1.	ventanaPelicula pelicula: nuevaPelicula.	ventanaPelicula open.	ventanaPelicula acepto		ifTrue: 			[Dialog warn: ventanaPelicula acepto value printString.				Dialog warn: 'guardando'.				adm agregarPelicula: ventanaPelicula aspPelicula value.			aspPeliculasObras list: adm peliculas]		ifFalse:[Dialog warn: ventanaPelicula acepto value printString]</body></methods><methods><class-id>WListaPeliculaObra</class-id> <category>actions</category><body package="Ventanas" selector="altaPelicula">altaPelicula	| ventanaPelicula nuevaPelicula |	ventanaPelicula := WPelicula new.	nuevaPelicula := PeliculaObra new				id: (adm ultimosIds at: Administrador ultimoIdPelicula) + 1.	ventanaPelicula pelicula: nuevaPelicula.	ventanaPelicula open.	ventanaPelicula acepto		ifTrue: 			[Dialog warn: ventanaPelicula acepto value printString.			Dialog warn: 'guardando'.			adm agregarPelicula: ventanaPelicula aspPelicula value.			aspPeliculasObras list: adm peliculas]</body></methods><methods><class-id>WListaPelicu