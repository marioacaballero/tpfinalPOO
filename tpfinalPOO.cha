elector="botonAgregarFuncion">botonAgregarFuncion	| venSL venPeli venFun nuevaFun salaSeleccionada peliSeleccionada |	venSL := WListaSalaSeleccion new.	venSL adm: adm.	venSL open.	venSL accept value ifFalse: [^self].	salaSeleccionada := venSL aspSalas selection.	venPeli := WListaPeliculaObraSeleccion new.	venPeli adm: adm.	venPeli open.	venPeli accept value ifFalse: [^self].	peliSeleccionada := venPeli aspPeliculasObras selection.	nuevaFun := Funcion new.	nuevaFun id: (adm ultimosIds at: Administrador ultimoIdFuncion) + 1.	nuevaFun idSala: salaSeleccionada id.	nuevaFun idPeliculaObra: peliSeleccionada id.	venFun := WFuncion new.	venFun funcion: nuevaFun.	venFun open.	venFun accept value		ifTrue: 			[Dialog warn: 'Guardando nueva función'.			adm agregarFuncion: venFun aspFuncion value.			adm funciones do: 					[:f |					f nombreSala: (adm salas detect: [:s | s id = f idSala]) nombre.					f nombreProduccion: (adm peliculas detect: [:p | p id = f idPeliculaObra])								titulo].			self aspFunciones list: adm funciones]</body></methods><do-it>'----SNAPSHOT----'</do-it><do-it>"#('c:\Users\Asus\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im' 'May 23, 2026' '2:41:23 PM')""An image file c:\Users\Asus\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im was created at 14:41:23 on 23 de mayo de 2026."</do-it><methods><class-id>WListaFunciones</class-id> <category>accessing</category><body package="Ventanas" selector="adm:">adm: unAdministrador	adm := unAdministrador.	"	Dialog warn: adm personas printString."	self aspFunciones list: adm funciones</body></methods><do-it>'----SNAPSHOT----'</do-it><do-it>"#('c:\Users\Asus\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im' 'May 23, 2026' '2:42:09 PM')""An image file c:\Users\Asus\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im was created at 14:42:09 on 23 de mayo de 2026."</do-it><methods><class-id>WListaFunciones class</class-id> <category>interface s