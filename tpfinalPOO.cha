	(butacasSeleccionadas includes: unaButaca)
		ifTrue:  [butacasSeleccionadas remove: unaButaca]
		ifFalse: [butacasSeleccionadas add: unaButaca].
	self invalidate</body></methods><class><name>ButacasGridController</name><environment>UI</environment><super>UI.Controller</super><private>false</private><indexed-type>none</indexed-type><inst-vars></inst-vars><class-inst-vars></class-inst-vars><imports></imports><category></category><attributes><package>Ventanas</package></attributes></class><do-it>'----SNAPSHOT----'</do-it><do-it>"#('c:\Users\Asus\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im' 'July 5, 2026' '11:20:37 PM')""An image file c:\Users\Asus\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im was created at 23:20:37 on 5 de julio de 2026."</do-it><do-it>'----SNAPSHOT----'</do-it><do-it>"#('c:\Users\Asus\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im' 'July 6, 2026' '12:04:37 AM')""An image file c:\Users\Asus\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im was created at 0:04:37 on 6 de julio de 2026."</do-it><methods><class-id>ButacasGridView</class-id> <category>initialize-release</category><body package="Ventanas" selector="initialize">initialize
