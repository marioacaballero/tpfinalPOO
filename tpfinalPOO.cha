ge="Ventanas" selector="windowSpec">windowSpec	"Tools.UIPainter new openOnClass: self andSelector: #windowSpec"	&lt;resource: #canvas&gt;	^#(#{UI.FullSpec} 		#window: 		#(#{UI.WindowSpec} 			#label: 'Disponibilidad Sala' 			#min: #(#{Core.Point} 20 20 ) 			#max: #(#{Core.Point} 0 0 ) 			#bounds: #(#{Graphics.Rectangle} 464 37 664 237 ) ) 		#component: 		#(#{UI.SpecCollection} 			#collection: #(				#(#{UI.RegionSpec} 					#layout: #(#{Graphics.LayoutFrame} 181 0 93 0 741 0 528 0 ) 					#name: #ContenedorButacas 					#lineWidth: 2 ) ) ) )</body></methods><class><name>WDisponibilidadSala</name><environment>Smalltalk</environment><super>UI.ApplicationModel</super><private>false</private><indexed-type>none</indexed-type><inst-vars>salaSeleccionada </inst-vars><class-inst-vars></class-inst-vars><imports></imports><category></category><attributes><package>Ventanas</package></attributes></class><methods><class-id>WDisponibilidadSala</class-id> <category>accessing</category><body package="Ventanas" selector="salaSeleccionada">salaSeleccionada	^salaSeleccionada</body></methods><methods><class-id>WDisponibilidadSala</class-id> <category>accessing</category><body package="Ventanas" selector="salaSeleccionada:">salaSeleccionada: anObject	salaSeleccionada := anObject</body></methods><methods><class-id>WDisponibilidadSala</class-id> <category>accessing</category><body package="Ventanas" selector="salaSeleccionada:">salaSeleccionada: unaSala	salaSeleccionada := unaSala</body></methods><do-it>WDisponibilidadSala organization addCategory: #'initialize-release'</do-it><methods><class-id>WDisponibilidadSala</class-id> <category>interface opening</category><body package="Ventanas" selector="postBuildWith:">postBuildWith: aBuilder
    | contenedor |
    super postBuildWith: aBuilder.
    
    "Atrapamos el Region que creaste en el UI Painter mediante su ID"
