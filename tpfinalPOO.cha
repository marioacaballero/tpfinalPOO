ass-id>Administrador</class-id> <category>personas</category><body package="TPFinal" selector="actualizarUltimoIdPersona">actualizarUltimoIdPersona	"| idMayor |	personas size = 0		ifTrue: [ultimoIdPersona := 0]		ifFalse: 			[idMayor := 0.			personas do: [:p | idMayor &lt; p id ifTrue: [idMayor := p id]].			ultimoIdPersona := idMayor]"	 </body></methods><do-it>Administrador class organization addCategory: #ids</do-it><methods><class-id>Administrador class</class-id> <category>ids</category><body package="TPFinal" selector="ultimoIdPersona">ultimoIdPersona	^'ultimoIdPersona'</body></methods><methods><class-id>Administrador class</class-id> <category>ids</category><body package="TPFinal" selector="ultimoIdSocio">ultimoIdSocio	^'ultimoIdSocio'</body></methods><methods><class-id>Administrador</class-id> <category>initialize-release</category><body package="TPFinal" selector="iniciarPersonas">iniciarPersonas	| filePersonas bos |	filePersonas := 'databasePersonas.b' asFilename.	filePersonas exists		ifTrue: 			[bos := BinaryObjectStorage onOldNoScan: filePersonas readStream.			[personas := bos contents] ensure: [bos close]]		ifFalse: 			[personas := OrderedCollection new.			ultimosIds at: Administrador ultimoIdPersona put: 0]</body></methods><methods><class-id>Administrador</class-id> <category>initialize-release</category><body package="TPFinal" selector="iniciarSocios">iniciarSocios	| fileSocios bos |	fileSocios := 'databaseSocios.b' asFilename.	fileSocios exists		ifTrue: 			[bos := BinaryObjectStorage onOldNoScan: fileSocios.			[socios := bos contents] ensure: [bos close]]		ifFalse: 			[socios := OrderedCollection new.			ultimosIds at: Administrador ultimoIdSocio put: 0]</body></methods><methods><class-id>Administrador</class-id> <category>initialize-release</category><body package="TPFinal" selector="iniciarIds">iniciarIds	| fileIds bos |	fileIds := 'databaseSocios.b' asFilename.	fileIds exists		ifTrue: 			[bos := BinaryObjectStorage onOldNoScan: fileIds.			[ultimosIds := bos contents] ensure: [bos close]]		ifFalse: 			[ultimosIds at: Administrador ultimoIdSocio put: 0.			ultimosIds at: 'ultimoIdCobros' put: 0.			ultimosIds at: 'ultimoIdGastos' put: 0.			ultimosIds at: 'ultimoIdInstalaciones' put: 0.			ultimosIds at: Administrador ultimoIdPersona put: 0]</body></methods><methods><class-id>Administrador</class-id> <category>personas</category><body package="TPFinal" selector="actualizarUltimoIdPersona">actualizarUltimoIdPersona	"| idMayor |	personas size = 0		ifTrue: [ultimoIdPersona := 0]		ifFalse: 			[idMayor := 0.			personas do: [:p | idMayor &lt; p id ifTrue: [idMayor := p id]].			ultimoIdPersona := idMayor]"	ultimosIds at: Administrador ultimoIdPersona		put: (ultimosIds at: Administrador ultimoIdPersona) + 1</body></methods><do-it>'----SNAPSHOT----'</do-it><do-it>"#('c:\Users\mario\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im' 'November 12, 2025' '5:53:43 PM')""An image file c:\Users\mario\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im was created at 5:53:43 PM on November 12, 2025."</do-it><methods><class-id>Administrador</class-id> <category>personas</category><body package="TPFinal" selector="actualizarUltimoIdPersona:">actualizarUltimoIdPersona: unId	"| idMayor |	personas size = 0		ifTrue: [ultimoIdPersona := 0]		ifFalse: 			[idMayor := 0.			personas do: [:p | idMayor &lt; p id ifTrue: [idMayor := p id]].			ultimoIdPersona := idMayor]"	ultimosIds at: Administrador ultimoIdPersona put: unId</body></methods><methods><class-id>Administrador</class-id> <category>personas</category><body package="TPFinal" selector="agregarPersona:">agregarPersona: unaPersona	personas add: unaPersona.	self actualizarUltimoIdPersona: unaPersona id</body></methods><methods><class-id>WListaPersonas</class-id> <category>actions</category><body package="Ventanas" selector="altaPersona">altaPersona	| ventanaPersona nuevaPersona |	ventanaPersona := WPersona new.	nuevaPersona := Persona new				id: (adm ultimosIds at: Administrador ultimoIdPersona) + 1.	ventanaPersona persona: nuevaPersona.	ventanaPersona open.	ventanaPersona acepto		ifTrue: 			[adm agregarPersona: ventanaPersona aspPersona value.			aspPersonas list: adm personas]	"	Dialog warn: ventanaPersona aspPersona value printString"</body></methods><remove-selector><class-id>Administrador</class-id> <selector>actualizarUltimoIdPersona</selector></remove-selector><methods><class-id>Administrador</class-id> <category>personas</category><body package="TPFinal" selector="actualizarUltimoIdPersona:">actualizarUltimoIdPersona: unId	ultimosIds at: Administrador ultimoIdPersona put: unId</body></methods><do-it>'----SNAPSHOT----'</do-it><do-it>"#('c:\Users\mario\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im' 'November 12, 2025' '5:59:31 PM')""An image file c:\Users\mario\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im was created at 5:59:31 PM on November 12, 2025."</do-it><do-it>'----SNAPSHOT----'</do-it><do-it>"#('c:\Users\mario\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im' 'November 12, 2025' '5:59:41 PM')""An image file c:\Users\mario\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im was created at 5:59:41 PM on November 12, 2025."</do-it><methods><class-id>Administrador</class-id> <category>accessing</category><body package="TPFinal" selector="guardarTodo">guardarTodo	self guardarPersonas</body></methods><methods><class-id>Administrador</class-id> <category>personas</category><body package="TPFinal" selector="guardarPersonas">guardarPersonas	| pers bos |	pers := 'databasePersonas.b' asFilename writeStream.	bos := BinaryObjectStorage onNew: pers.	bos nextPutAll: personas.	bos close</body></methods><methods><class-id>Administrador</class-id> <category>initialize-release</category><body package="TPFinal" selector="iniciarPersonas">iniciarPersonas	| filePersonas bos |	filePersonas := 'databasePersonas.b' asFilename.	filePersonas exists		ifTrue: 			[bos := BinaryObjectStorage onOldNoScan: filePersonas readStream.			[personas := bos contents asOrderedCollection] ensure: [bos close]]		ifFalse: 			[personas := OrderedCollection new.			ultimosIds at: Administrador ultimoIdPersona put: 0]</body></methods><do-it>'----SNAPSHOT----'</do-it><do-it>"#('/home/mario/vw8.2pul/bin/linuxx86_64/imagenTPfinal/tpfinalPOO.im' 'November 12, 2025' '9:49:02 PM')""An image file /home/mario/vw8.2pul/bin/linuxx86_64/imagenTPfinal/tpfinalPOO.im was created at 9:49:02 PM on November 12, 2025."</do-it><methods><class-id>Administrador</class-id> <category>accessing</category><body package="TPFinal" selector="guardarIds">guardarIds	| ids bos |	ids := 'databaseIds.b' asFilename writeStream.	bos := BinaryObjectStorage onNew: ids.	bos nextPut: ultimosIds.	bos close</body></methods><methods><class-id>Administrador</class-id> <category>initialize-release</category><body package="TPFinal" selector="iniciarIds">iniciarIds	| fileIds bos |	fileIds := 'databaseIds.b' asFilename.	fileIds exists		ifTrue: 			[bos := BinaryObjectStorage onOldNoScan: fileIds.			[ultimosIds := bos contents at: 1] ensure: [bos close]]		ifFalse: 			[ultimosIds at: Administrador ultimoIdSocio put: 0.			ultimosIds at: 'ultimoIdCobros' put: 0.			ultimosIds at: 'ultimoIdGastos' put: 0.			ultimosIds at: 'ultimoIdInstalaciones' put: 0.			ultimosIds at: Administrador ultimoIdPersona put: 0]</body></methods><do-it>Administrador organization addCategory: #personas</do-it><do-it>Administrador classifySymbol: #iniciarPersonas under: #personas</do-it><do-it>'----SNAPSHOT----'</do-it><do-it>"#('/home/mario/vw8.2pul/bin/linuxx86_64/imagenTPfinal/tpfinalPOO.im' 'November 12, 2025' '10:18:43 PM')""An image file /home/mario/vw8.2pul/bin/linuxx86_64/imagenTPfinal/tpfinalPOO.im was created at 10:18:43 PM on Novemb