me: #Label4 					#label: 'Precio' ) 				#(#{UI.InputFieldSpec} 					#layout: #(#{Graphics.LayoutFrame} 54 0 219 0 154 0 240 0 ) 					#name: #InputField4 					#flags: 40 					#model: #'aspReserva precioEntrada' 					#isReadOnly: true 					#type: #number ) 				#(#{UI.LabelSpec} 					#layout: #(#{Graphics.LayoutOrigin} 54 0 251 0 ) 					#name: #Label5 					#label: 'Fecha Reserva' ) 				#(#{UI.InputFieldSpec} 					#layout: #(#{Graphics.LayoutFrame} 54 0 277 0 154 0 298 0 ) 					#name: #InputField5 					#flags: 40 					#model: #'aspReserva fechaReserva' 					#isReadOnly: true 					#type: #date 					#formatString: 'dd/mm/yyyy' ) 				#(#{UI.LabelSpec} 					#layout: #(#{Graphics.LayoutOrigin} 54 0 309 0 ) 					#name: #Label6 					#label: 'Fecha Cancelacion' ) 				#(#{UI.InputFieldSpec} 					#layout: #(#{Graphics.LayoutFrame} 54 0 335 0 154 0 356 0 ) 					#name: #InputField6 					#flags: 40 					#model: #'aspReserva fechaCancelacion' 					#isReadOnly: true 					#type: #date 					#formatString: 'dd/mm/yyyy' ) 				#(#{UI.LabelSpec} 					#layout: #(#{Graphics.LayoutOrigin} 343 0 23 0 ) 					#name: #Label7 					#label: 'Butacas Reservadas' ) 				#(#{UI.ActionButtonSpec} 					#layout: #(#{Graphics.LayoutFrame} 332 0 344 0 455 0 365 0 ) 					#name: #ActionButton1 					#model: #botonConfirmarReserva 					#label: 'Confirmar Reserva' 					#defaultable: true ) ) ) )</body></methods><methods><class-id>Funcion</class-id> <category>accessing</category><body package="TPFinal" selector="calcularTotal:">calcularTotal: cantidadButacas
