ge="Ventanas" selector="botonListaCritica">botonListaCritica	| pel |	pel := self aspPeliculasObras selection.	pel isNil		ifTrue: [Dialog warn: 'No hay produccion seleccionada']		ifFalse: []</body></methods><methods><class-id>WListaPeliculaObra</class-id> <category>actions</category><body package="Ventanas" selector="botonListaCritica">botonListaCritica	| pel |	pel := self aspPeliculasObras selection.	pel isNil		ifTrue: [Dialog warn: 'No hay produccion seleccionada']		ifFalse: [(Dialog warn: '¿Confirma quitar de cartelera?')]</body></methods><methods><class-id>WListaPeliculaObra</class-id> <category>actions</category><body package="Ventanas" selector="botonListaCritica">botonListaCritica	| pel |	pel := self aspPeliculasObras selection.	pel isNil		ifTrue: [Dialog warn: 'No hay produccion seleccionada']		ifFalse: [(Dialog warn: 'Pelicula id:')]</body></methods><methods><class-id>WListaPeliculaObra</class-id> <category>actions</category><body package="Ventanas" selector="botonListaCritica">botonListaCritica	| pel |	pel := self aspPeliculasObras selection.	pel isNil		ifTrue: [Dialog warn: 'No hay produccion seleccionada']		ifFalse: [(Dialog warn: 'Pelicula id:', pel id printString )]</body></methods><methods><class-id>WListaPeliculaObra</class-id> <category>actions</category><body package="Ventanas" selector="botonListaCritica">botonListaCritica	| pel venCri|	pel := self aspPeliculasObras selection.	pel isNil		ifTrue: [Dialog warn: 'No hay produccion seleccionada']		ifFalse: [(Dialog warn: 'Pelicula id:', pel id printString )]</body></methods><methods><class-id>WListaPeliculaObra</class-id> <category>actions</category><body package="Ventanas" selector="botonListaCritica">botonListaCritica	| pel venCri |	pel := self aspPeliculasObras selection.	pel isNil		ifTrue: [Dialog warn: 'No hay produccion seleccionada']		ifFalse: 			[Dialog warn: 'Pelicula id:' , pel id printString.			venCri := WListaCriticas new.