sNoEnPel</body></methods><methods><class-id>WSeleccionarCritico</class-id> <category>actions</category><body package="Ventanas" selector="botonSeleccionarCritico">botonSeleccionarCritico	| venCrit critica critico |	critico := self aspCriticos selection.	critico isNil		ifTrue: [Dialog warn: 'No hay critico seleccionado']		ifFalse: 			[venCrit := WCritica new.			critica := (Critica new)						id: (adm ultimosIds at: Administrador ultimoIdCritica) + 1;						idCritico: critico id;						idPelicula: self idPelicula.			venCrit critica: critica.			venCrit open.			adm agregarCritica: critica.			self close]</body></methods><class><name>WCritica</name><environment>Smalltalk</environment><super>UI.SimpleDialog</super><private>false</private><indexed-type>none</indexed-type><inst-vars>aspCritica opcionesPuntaje actualizar adm </inst-vars><class-inst-vars></class-inst-vars><imports></imports><category></category><attributes><package>Ventanas</package></attributes></class><class><name>WSeleccionarCritico</name><environment>Smalltalk</environment><super>UI.SimpleDialog</super><private>false</private><indexed-type>none</indexed-type><inst-vars>aspCritico adm aspCriticos idPelicula </inst-vars><class-inst-vars></class-inst-vars><imports></imports><category></category><attributes><package>Ventanas</package></attributes></class><class><name>WSeleccionarCritico</name><environment>Smalltalk</environment><super>UI.SimpleDialog</super><private>false</private><indexed-type>none</indexed-type><inst-vars>aspCritico adm aspCriticos idPelicula </inst-vars><class-inst-vars></class-inst-vars><imports></imports><category></category><attributes><package>Ventanas</package></attributes></class><methods><class-id>WListaCriticas</class-id> <category>aspects</category><body package="Ventanas" selector="adm:">adm: unAdministrador	adm := unAdministrador.	self aspCriticas list: (adm mostrarCriticasDe: self idPelicula)</body></method