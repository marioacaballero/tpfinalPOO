AltaCritico	| res per crit |	per := aspPersonas selection.	per isNil		ifTrue: [Dialog warn: 'No hay ninguna persona seleccionada']		ifFalse: 			[res := Dialog request: 'Introduce el usuario del critico: ' , per nombre						initialAnswer: ''.			crit := (Critico new)						id: (adm ultimosIds at: Administrador ultimoIdCritico) + 1;						idPersona: per id;						nombreUsuario: res;						fechaAlta: Date today.			adm agregarCritico: crit.			adm actualizarUltimoIdCritico: crit id.			aspPersonas list remove: per.			aspPersonas selection: nil.			self close]</body></methods><do-it>'----SNAPSHOT----'</do-it><do-it>"#('c:\Users\User\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im' 'May 19, 2026' '11:26:31 PM')""An image file c:\Users\User\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im was created at 23:26:31 on 19 de mayo de 2026."</do-it><methods><class-id>WSeleccionarCritico</class-id> <category>actions</category><body package="Ventanas" selector="botonAgregarCritico">botonAgregarCritico	| venListCrit |	venListCrit := WListaPersonasNoCritico new.	venListCrit adm: adm.	venListCrit open.	aspCriticos list: adm criticos</body></methods><do-it>'----SNAPSHOT----'</do-it><do-it>"#('c:\Users\User\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im' 'May 19, 2026' '11:31:13 PM')""An image file c:\Users\User\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im was created at 23:31:13 on 19 de mayo de 2026."</do-it><do-it>'----SNAPSHOT----'</do-it><do-it>"#('c:\Users\User\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im' 'May 19, 2026' '11:31:21 PM')""An image file c:\Users\User\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im was created at 23:31:21 on 19 de mayo de 2026."</do-it><class><name>WCritica</name><environment>Smalltalk</environment><super>UI.SimpleDialog</super><private>false</private><indexed-type>none</indexed-type><inst-vars></inst-vars><class-inst-vars></class-inst-vars><imports>