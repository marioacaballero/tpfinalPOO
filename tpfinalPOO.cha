 ) 		#component: 		#(#{UI.SpecCollection} 			#collection: #(				#(#{UI.DataSetSpec} 					#properties: #(#{UI.PropertyListDictionary} #showHorizontalLines true #allowColumnResizing true #showVerticalLines true #allowColumnReordering false ) 					#layout: #(#{Graphics.LayoutFrame} 164 0 37 0 502 0 427 0 ) 					#name: #DataSocios 					#flags: 13 					#model: #aspSocios 					#columns: #(						#(#{UI.DataSetColumnSpec} 							#properties: #(#{UI.PropertyListDictionary} #allowSorting true #labelFromApplication false ) 							#model: #'aspSocio id' 							#label: 'ID' 							#labelIsImage: false 							#width: 80 							#rendererType: #Text 							#editorType: #None 							#type: #number 							#noScroll: false ) 						#(#{UI.DataSetColumnSpec} 							#properties: #(#{UI.PropertyListDictionary} #allowSorting true #labelFromApplication false ) 							#model: #'aspSocio idPersona' 							#label: 'IDPersona' 							#labelIsImage: false 							#width: 80 							#rendererType: #Text 							#editorType: #None 							#type: #number 							#noScroll: false ) 						#(#{UI.DataSetColumnSpec} 							#properties: #(#{UI.PropertyListDictionary} #allowSorting true #labelFromApplication false ) 							#model: #'aspSocio fechaAlta' 							#label: 'Fecha Alta' 							#labelIsImage: false 							#width: 80 							#rendererType: #Text 							#editorType: #None 							#type: #date 							#noScroll: false 							#formatString: 'dd/mm/yyyy' ) 						#(#{UI.DataSetColumnSpec} 							#properties: #(#{UI.PropertyListDictionary} #allowSorting true #labelFromApplication false ) 							#model: #'aspSocio estado' 							#label: 'Estado' 							#labelIsImage: false 							#width: 80 							#rendererType: #Text 							#editorType: #None 							#noScroll: false ) ) ) 				#(#{UI.ActionButtonSpec} 					#layout: #(#{Graphics.LayoutSizedOrigin} 554 0 46 0 80 30 ) 					#name: #botonAltaSocio 					#model: #altaSocio 					#label: 'Nuevo Socio' 					#defaultable: true ) ) ) )</body></methods><methods><class-id>WListaSocios</class-id> <category>aspects</category><body package="Ventanas" selector="aspSocio">aspSocio	"This method was generated by UIDefiner.  Any edits made here	may be lost whenever methods are automatically defined.  The	initialization provided below may have been preempted by an	initialize method."	^aspSocio isNil		ifTrue:			[aspSocio := nil asValue]		ifFalse:			[aspSocio]</body></methods><methods><class-id>WListaSocios</class-id> <category>aspects</category><body package="Ventanas" selector="aspSocios">aspSocios	"This method was generated by UIDefiner.  Any edits made here	may be lost whenever methods are automatically defined.  The	initialization provided below may have been preempted by an	initialize method."	^aspSocios isNil		ifTrue:			[aspSocios :=  SelectionInList new.			aspSocios selectionIndexHolder compute:				[:v |				self aspSocio value: aspSocios selection].			aspSocios]		ifFalse:			[aspSocios]</body></methods><methods><class-id>WListaSocios</class-id> <category>accessing</category><body package="Ventanas" selector="adm">adm	^adm</body></methods><methods><class-id>WListaSocios</class-id> <category>accessing</category><body package="Ventanas" selector="adm:">adm: unAdministrador	unAdministrador notNil		ifTrue: 			[Dialog warn: 'adm completo'.			adm := unAdministrador.			self aspSocios list: adm socios]		ifFalse: [Dialog warn: 'adm vacio']</body></methods><methods><class-id>WListaSocios</class-id> <category>actions</category><body package="Ventanas" selector="altaSocio">altaSocio	| ventanaPersonas |	ventanaPersonas := WListaPersonasNoSocios new.	ventanaPersonas adm: adm.	ventanaPersonas open</body></methods><methods><class-id>WPersona class</class-id> <category>interface specs</category><body package="Ventanas" selector="windowSpec">windowSpec	"Tools.UIPainter new openOnClass: self andSelector: #windowSpec"	&lt;resource: #canvas&gt;	^#(#{UI.FullSpec} 		#window: 		#(#{UI.WindowSpec} 			#label: 'Persona' 			#min: #(#{Core.Point} 20 20 ) 			#max: #(#{Core.Point} 0 0 ) 			#bounds: #(#{Graphics.Rectangle} 370 151 920 601 ) ) 		#component: 		#(#{UI.SpecCollection} 			#collection: #(				#(#{UI.LabelSpec} 					#layout: #(#{Graphics.LayoutFrame} 224 0 48 0 236 0 63 0 ) 					#name: #LabelId 					#label: 'ID' ) 				#(#{UI.LabelSpec} 					#layout: #(#{Graphics.LayoutOrigin} 190 0 79 0 ) 					#name: #LabelNombre 					#label: 'Nombre' ) 				#(#{UI.LabelSpec} 					#layout: #(#{Graphics.LayoutOrigin} 215 0 119 0 ) 					#name: #LabelDni 					#label: 'DNI' ) 				#(#{UI.LabelSpec} 					#layout: #(#{Graphics.LayoutOrigin} 35 0 159 0 ) 					#name: #LabelFecNac 					#label: 'Fecha de Nacimiento (dd/mm/yyyy)' ) 				#(#{UI.LabelSpec} 					#layout: #(#{Graphics.LayoutOrigin} 183 0 240 0 ) 					#name: #LabelDomic 					#label: 'Domicilio' ) 				#(#{UI.LabelSpec} 					#layout: #(#{Graphics.LayoutOrigin} 207 0 199 0 ) 					#name: #LabelSexo 					#label: 'Sexo' ) 				#(#{UI.LabelSpec} 					#layout: #(#{Graphics.LayoutOrigin} 204 0 279 0 ) 					#name: #LabelMail 					#label: 'Email' ) 				#(#{UI.LabelSpec} 					#layout: #(#{Graphics.LayoutOrigin} 195 0 320 0 ) 					#name: #LabelCelu 					#label: 'Celular' ) 				#(#{UI.InputFieldSpec} 					#layout: #(#{Graphics.LayoutSizedOrigin} 265 0 37 0 250 30 ) 					#name: #InputFieldId 					#model: #'aspPersona id' 					#isReadOnly: true 					#type: #number ) 				#(#{UI.InputFieldSpec} 					#layout: #(#{Graphics.LayoutSizedOrigin} 264 0 70 0 250 30 ) 					#name: #InputFieldNombre 					#model: #'aspPersona nombre | actualizar' 					#type: #text ) 				#(#{UI.InputFieldSpec} 					#layout: #(#{Graphics.LayoutSizedOrigin} 264 0 110 0 250 30 ) 					#name: #InputFieldDni 					#model: #'aspPersona dni | actualizar' 					#type: #number ) 				#(#{UI.InputFieldSpec} 					#layout: #(#{Graphics.LayoutSizedOrigin} 264 0 150 0 250 30 ) 					#name: #InputFieldFecNac 					#model: #'aspPersona fechaNacimiento | actualizar' 					#type: #date 					#formatString: 'dd/mm/yyyy' ) 				#(#{UI.ComboBoxSpec} 					#layout: #(#{Graphics.LayoutSizedOrigin} 264 0 190 0 250 30 ) 					#name: #ComboBoxSexo 					#model: #'aspPersona sexo | actualizar' 					#type: #text 					#comboList: #opcionesSexo ) 				#(#{UI.InputFieldSpec} 					#layout: #(#{Graphics.LayoutSizedOrigin} 264 0 231 0 250 30 ) 					#name: #InputFieldDomic 					#model: #'aspPersona domicilio | actualizar' 					#type: #text ) 				#(#{UI.InputFieldSpec} 					#layout: #(#{Graphics.LayoutSizedOrigin} 264 0 270 0 250 30 ) 					#name: #InputFieldMail 					#model: #'aspPersona email | actualizar' 					#type: #text ) 				#(#{UI.InputFieldSpec} 					#layout: #(#{Graphics.LayoutSizedOrigin} 264 0 311 0 250 30 ) 					#name: #InputFieldCelu 					#model: #'aspPersona celular | actualizar' 					#type: #text ) 				#(#{UI.ActionButtonSpec} 					#layout: #(#{Graphics.LayoutSizedOrigin} 211 0 393 0 60 30 ) 					#name: #ActionButtonCancelar 					#model: #botonCancelar 					#label: 'Cancelar' 					#defaultable: true ) 				#(#{UI.ActionButtonSpec} 					#layout: #(#{Graphics.LayoutSizedOrigin} 351 0 393 0 60 30 ) 					#name: #botonguardar 					#model: #botonDarAlta 					#label: 'Guardar' 					#defaultable: true ) ) ) )</body></methods><methods><class-id>WPersona</class-id> <category>aspects</category><body package="Ventanas" selector="actualizar">actualizar	"This method was generated by UIDefiner.  Any edits made here	may be lost whenever methods are automatically defined.  The	initialization provided below may have been preempted by an	initialize method."	^actualizar isNil		ifTrue:			[actualizar := nil asValue]		ifFalse:			[actualizar]</body></methods><methods><class-id>WPersona</class-id> <category>aspects</category><body package="Ventanas" selector="opcionesSexo">opcionesSexo	| opciones |	opciones :=