o |	critico := self aspCriticos selection.	venCrit := WCritica new.	critica := Critica new				id: (adm ultimosIds at: Administrador ultimoIdCritica) + 1;				idCritico: critico id;				idPelicula: self idPelicula.	venCrit critica: critica.	venCrit open.	adm agregarCritica:critica.	self close.</body></methods><methods><class-id>WSeleccionarCritico</class-id> <category>aspects</category><body package="Ventanas" selector="adm:">adm: unAdministrador	| critPelId criticosNoEnPel |	Dialog warn: unAdministrador printString.	adm := unAdministrador.	"para colocar a los criticos que no hicieron la reseña de la pelicula"	critPelId := adm mostrarCriticasDe: self idPelicula.				"collect: [:c | c idCritico]."	Dialog warn: critPelId printString.	criticosNoEnPel := adm criticos				select: [:crit | (critPelId includes: crit id) not].	self aspCriticos list: criticosNoEnPel</body></methods><methods><class-id>WSeleccionarCritico</class-id> <category>aspects</category><body package="Ventanas" selector="adm:">adm: unAdministrador	| critPelId criticosNoEnPel |	Dialog warn: unAdministrador printString.	adm := unAdministrador.	"para colocar a los criticos que no hicieron la reseña de la pelicula"	critPelId := adm mostrarCriticasDe: self idPelicula.				"collect: [:c | c idCritico]."	Dialog warn: idPelicula.	criticosNoEnPel := adm criticos				select: [:crit | (critPelId includes: crit id) not].	self aspCriticos list: criticosNoEnPel</body></methods><methods><class-id>WSeleccionarCritico</class-id> <category>aspects</category><body package="Ventanas" selector="adm:">adm: unAdministrador	| critPelId criticosNoEnPel |	Dialog warn: unAdministrador printString.	adm := unAdministrador.	"para colocar a los criticos que no hicieron la reseña de la pelicula"	critPelId := adm mostrarCriticasDe: self idPelicula.				"collect: [:c | c idCritico]."	Dialog warn: idPelicula printString.	criticosNoEnPel := adm criticos				select: [:crit | (critPelId inc