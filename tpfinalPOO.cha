			[bos := BinaryObjectStorage onOldNoScan: filePersonas readStream.			[personas := bos contents asOrderedCollection] ensure: [bos close]]		ifFalse: 			[personas := OrderedCollection new.			ultimosIds at: Administrador ultimoIdPersona put: 0]</body></methods><methods><class-id>Administrador</class-id> <category>personas</category><body package="(none)" selector="modificarPersona:">modificarPersona: unaPersona	| persona |	persona := personas detect: [:p | p id = unaPersona id].	persona nombre: unaPersona nombre.	persona dni: unaPersona dni.	persona fechaNacimiento: unaPersona fechaNacimiento.	persona domicilio: unaPersona domicilio.	persona celular: unaPersona celular.	persona sexo: unaPersona sexo.	persona email: unaPersona email</body></methods><methods><class-id>Administrador</class-id> <category>personas</category><body package="(none)" selector="actualizarUltimoIdPersona:">actualizarUltimoIdPersona: unId	ultimosIds at: Administrador ultimoIdPersona put: unId</body></methods><methods><class-id>Administrador</class-id> <category>personas</category><body package="(none)" selector="agregarPersona:">agregarPersona: unaPersona	personas add: unaPersona.	self actualizarUltimoIdPersona: unaPersona id</body></methods><methods><class-id>Administrador</class-id> <category>personas</category><body package="(none)" selector="guardarPersonas">guardarPersonas	| pers bos |	pers := 'databasePersonas.b' asFilename writeStream.	bos := BinaryObjectStorage onNew: pers.	bos nextPutAll: personas.	bos close</body></methods><methods><class-id>Administrador</class-id> <category>personas</category><body package="(none)" selector="eliminarPersona:">eliminarPersona: idPersona	| persona |	persona := personas detect: [:per | per id = idPersona].	persona borrado: true</body></methods><methods><class-id>Funcion class</class-id> <category>instance creation</category><body package="(none)" selector="new">new	"Answer a newly created 