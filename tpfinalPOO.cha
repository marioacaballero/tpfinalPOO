Avanzados| pel venDA|	 pel := self aspPeliculasObras selection.	 pel isNil		ifTrue: [Dialog warn: 'No hay produccion seleccionada']		ifFalse: 			[venDA:= WDetallesAvanzados new.				venDA aspPelicula: pel]</body></methods><methods><class-id>WListaPeliculaObra</class-id> <category>actions</category><body package="Ventanas" selector="botonDetallesAvanzados">botonDetallesAvanzados	| pel venDA |	pel := self aspPeliculasObras selection.	pel isNil		ifTrue: [Dialog warn: 'No hay produccion seleccionada']		ifFalse: 			[venDA := WDetallesAvanzados new.			venDA aspPelicula value: pel.			venDA open]</body></methods><do-it>'----SNAPSHOT----'</do-it><do-it>"#('c:\Users\Asus\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im' 'May 14, 2026' '9:46:39 PM')""An image file c:\Users\Asus\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im was created at 21:46:39 on 14 de mayo de 2026."</do-it><methods><class-id>WDetallesAvanzados</class-id> <category>aspects</category><body package="Ventanas" selector="adm">adm	| adm |	^adm</body></methods><class><name>WDetallesAvanzados</name><environment>Smalltalk</environment><super>UI.SimpleDialog</super><private>false</private><indexed-type>none</indexed-type><inst-vars>aspPelicula adm </inst-vars><class-inst-vars></class-inst-vars><imports></imports><category></category><attributes><package>Ventanas</package></attributes></class><do-it>WDetallesAvanzados addInstVarName: 'adm'</do-it><methods><class-id>WDetallesAvanzados</class-id> <category>aspects</category><body package="Ventanas" selector="adm">adm	^adm</body></methods><methods><class-id>WDetallesAvanzados</class-id> <category>aspects</category><body package="Ventanas" selector="adm:">adm: unAdministrador	adm := unAdministrador.	"	Dialog warn: adm personas printString."	self aspPeliculasObras list: adm peliculas</body></methods><methods><class-id>WDetallesAvanzados</class-id> <category>aspects</category><bod