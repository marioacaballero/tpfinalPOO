 |	filePeliculas := 'databasePeliculas.b' asFilename.	filePeliculas exists		ifTrue: 			[bos := BinaryObjectStorage onOldNoScan: filePeliculas readStream.			[peliculas := bos contents asOrderedCollection] ensure: [bos close]]		ifFalse: 			[peliculas := OrderedCollection new.			ultimosIds at: Administrador ultimoIdPelicula put: 0]</body></methods><methods><class-id>Administrador</class-id> <category>peliculas</category><body package="TPFinal" selector="MiniciarPeliculas">MiniciarPeliculas	| filePeliculas bos |	filePeliculas := 'databasePeliculas.b' asFilename.	filePeliculas exists		ifTrue: 			[bos := BinaryObjectStorage onOldNoScan: filePeliculas readStream.			[peliculas := bos contents asOrderedCollection] ensure: [bos close]]		ifFalse: 			[peliculas := OrderedCollection new.			ultimosIds at: Administrador ultimoIdPelicula put: 0]</body></methods><methods><class-id>Administrador</class-id> <category>peliculas</category><body package="TPFinal" selector="iniciarPeliculas">iniciarPeliculas	| filePeliculas bos |	filePeliculas := 'databasePeliculas.b' asFilename.	filePeliculas exists		ifTrue: 			[bos := BinaryObjectStorage onOldNoScan: filePeliculas readStream.			[peliculas := bos contents asOrderedCollection] ensure: [bos close]]		ifFalse: 			[peliculas := OrderedCollection new.			ultimosIds at: Administrador ultimoIdPelicula put: 0]</body></methods><remove-selector><class-id>Administrador</class-id> <selector>MiniciarPeliculas</selector></remove-selector><methods><class-id>Administrador</class-id> <category>peliculas</category><body package="TPFinal" selector="agregarCritica:">agregarCritica: unaCritica</body></methods><methods><class-id>PeliculaObra</class-id> <category>initialize-release</category><body package="TPFinal" selector="initialize">initialize	"Initialize a newly created instance. This method must answer the receiver."	super initialize.	" *** Edit the following to properly initialize instance varia