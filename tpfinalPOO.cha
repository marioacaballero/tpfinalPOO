> <category>aspects</category><body package="Ventanas" selector="aspCriticos">aspCriticos	"This method was generated by UIDefiner.  Any edits made here	may be lost whenever methods are automatically defined.  The	initialization provided below may have been preempted by an	initialize method."	^aspCriticos isNil		ifTrue:			[aspCriticos :=  SelectionInList new.			aspCriticos selectionIndexHolder compute:				[:v |				self aspCritico value: aspCriticos selection].			aspCriticos]		ifFalse:			[aspCriticos]</body></methods><methods><class-id>WSeleccionarCritico</class-id> <category>aspects</category><body package="Ventanas" selector="adm:">adm: unAdministrador	adm := unAdministrador.	self aspCriticos list: adm criticos</body></methods><methods><class-id>Administrador</class-id> <category>initialize-release</category><body package="TPFinal" selector="iniciarIds">iniciarIds	| fileIds bos datosCargados |	fileIds := 'databaseIds.b' asFilename.	fileIds exists		ifTrue: 			[				bos := BinaryObjectStorage onOldNoScan: fileIds readStream.			"1. Cargamos el objeto completo del archivo a una variable temporal"			[datosCargados := bos contents at: 1.			"2. Iteramos el diccionario cargado y pasamos los datos al nuestro"			datosCargados				keysAndValuesDo: [:clave :valor | ultimosIds at: clave put: valor]]					ensure: [bos close]]		ifFalse: 			[ultimosIds at: Administrador ultimoIdSocio put: 0.			ultimosIds at: Administrador ultimoIdPersona put: 0.			ultimosIds at: Administrador ultimoIdPelicula put: 0.			ultimosIds at: Administrador ultimoIdSala put: 0.			ultimosIds at: Administrador ultimoIdButaca put: 0.			ultimosIds at: Administrador ultimoIdCritico put: 0			]	"			[bos := BinaryObjectStorage onOldNoScan: fileIds.			[ultimosIds := bos contents at: 1] ensure: [bos close]]		Esta es la forma de Pascal		"</body></methods><methods><class-id>Administrador</class-id> <category>initialize-release</category><body package="TPFinal" s