ect: [:asig | personas detect: [:per | per id = asig idPersona]].	posiblesPersonas := personas				reject: [:per | (personasDelArticulo includes: per) not].	personas do: 			[:per |			cantArtPorPersona := 0.			cantArtPorPersona := (asignaciones						select: [:asig | asig idPersona = per id]) size.			cantArtPorPersona &lt; 3 ifTrue: [personasEvaluadoras add: per]]	"falta verificar que no esten en mas de tres de articulos"</body></methods><methods><class-id>OCS</class-id> <category>accessing</category><body package="EjParcial2023" selector="proponerEvaluadoresParaArticulo:">proponerEvaluadoresParaArticulo: idArticulo	| asigDeArticulo personasDelArticulo posiblesPersonas personasEvaluadoras cantArtPorPersona |	personasEvaluadoras := OrderedCollection new.	asigDeArticulo := asignaciones				select: [:asig | asig idArticulo = idArticulo].	personasDelArticulo := asigDeArticulo				collect: [:asig | personas detect: [:per | per id = asig idPersona]].	posiblesPersonas := personas				reject: [:per | (personasDelArticulo includes: per) not].	personas do: 			[:per |			cantArtPorPersona := 0.			cantArtPorPersona := (asignaciones						select: [:asig | asig idPersona = per id]) size.			cantArtPorPersona &lt; 3 ifTrue: [personasEvaluadoras add: per]].	^personasEvaluadoras</body></methods><methods><class-id>OCS</class-id> <category>accessing</category><body package="EjParcial2023" selector="proponerEvaluadoresParaArticulo:">proponerEvaluadoresParaArticulo: idArticulo	| asigDeArticulo personasDelArticulo posiblesPersonas personasEvaluadoras cantArtPorPersona |	personasEvaluadoras := OrderedCollection new.	asigDeArticulo := asignaciones				select: [:asig | asig idArticulo = idArticulo].	personasDelArticulo := asigDeArticulo				collect: [:asig | personas detect: [:per | per id = asig idPersona]].	posiblesPersonas := personas				reject: [:per | (personasDelArticulo includes: per) not].	posiblesPersonas do: 			[:per |			cantArtPorPersona := 0.			cantArtPorPersona := (asignaciones						select: [:asig | asig idPersona = per id]) size.			cantArtPorPersona &lt; 3 ifTrue: [personasEvaluadoras add: per]].	^personasEvaluadoras</body></methods><methods><class-id>OCS</class-id> <category>accessing</category><body package="EjParcial2023" selector="proponerEvaluadoresParaArticulo:">proponerEvaluadoresParaArticulo: idArticulo	| asigDeArticulo personasDelArticulo posiblesPersonas personasEvaluadoras cantArtPorPersona |	personasEvaluadoras := OrderedCollection new.	asigDeArticulo := asignaciones				select: [:asig | asig idArticulo = idArticulo].	personasDelArticulo := asigDeArticulo				collect: [:asig | personas detect: [:per | per id = asig idPersona]].	posiblesPersonas := personas				reject: [:per | (personasDelArticulo includes: per) not].	posiblesPersonas do: 			[:per |			cantArtPorPersona := 0.			cantArtPorPersona := (asignaciones						select: [:asig | asig idPersona = per id &amp; (asig rol = #evaluador)]) size.			cantArtPorPersona &lt; 3 ifTrue: [personasEvaluadoras add: per]].	^personasEvaluadoras</body></methods><do-it>'----SNAPSHOT----'</do-it><do-it>"#('/home/mario/vw8.2pul/bin/linuxx86_64/../../image/tpfinalPOO.im' 'October 19, 2025' '10:39:26 PM')""An image file /home/mario/vw8.2pul/bin/linuxx86_64/../../image/tpfinalPOO.im was created at 10:39:26 PM on October 19, 2025."</do-it><do-it>'----SNAPSHOT----'</do-it><do-it>"#('/home/mario/vw8.2pul/bin/linuxx86_64/../../image/tpfinalPOO.im' 'October 19, 2025' '10:39:32 PM')""An image file /home/mario/vw8.2pul/bin/linuxx86_64/../../image/tpfinalPOO.im was created at 10:39:32 PM on October 19, 2025."</do-it><component-created><name>TPFinal</name> <type>package</type></component-created><class><name>Persona</name><environment>Smalltalk</environment><super>Core.Object</super><private>false</private><indexed-type>none</indexed-type><inst-vars>id nombre dni fecha_nacimiento sexo domicilio email celular </inst-vars><c