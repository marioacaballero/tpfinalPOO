s-id> <category>peliculas</category><body package="TPFinal" selector="tieneFuncionesActivas:">tieneFuncionesActivas: unIdPelicula
	"Devuelve true si la pelicula tiene alguna funcion cuyo atributo borrado sea nil o false"
	
	^funciones anySatisfy: [ :f | 
		(f  idPeliculaObra = unIdPelicula) 
			and: [ f  borrado isNil or: [ f  borrado = false ] ]]</body></methods><do-it>'----SNAPSHOT----'</do-it><do-it>"#('c:\Users\Asus\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im' 'May 24, 2026' '12:46:10 PM')""An image file c:\Users\Asus\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im was created at 12:46:10 on 24 de mayo de 2026."</do-it><methods><class-id>WListaPeliculaObra</class-id> <category>actions</category><body package="Ventanas" selector="eliminarPelicula">eliminarPelicula

	| pro |
	pro := self aspPeliculasObras selection.
	pro isNil
		ifTrue: [ Dialog warn: 'No hay produccion seleccionada' ]
		ifFalse: [
			"1. Chequeamos la validación en el administrador"
			(adm tieneFuncionesActivas: pro id)
				ifTrue: [ Dialog warn: 'No se puede eliminar: La producción está asignada a una función activa.' ]
				ifFalse: [
					"2. Si no tiene funciones activas, pedimos confirmación"
					(Dialog confirm: '¿Confirma eliminar al id: ' , pro id printString , ' ?')
						ifFalse: [ ^self ]
						ifTrue: [
							adm eliminarPelicula: pro id.
							aspPeliculasObras list: adm peliculas 
						]
				]
		]</body></methods><do-it>'----SNAPSHOT----'</do-it><do-it>"#('c:\Users\Asus\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im' 'May 24, 2026' '12:47:50 PM')""An image file c:\Users\Asus\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im was created at 12:47:50 on 24 de mayo de 2026."</do-it><do-it>f := Funcion new.</do-it><do-it>f horaInicio: (Time fromSeconds: 3600).</do-it><do-it>Transcript show: f horaInicio printString.</do-it><do-it>Transcript show: f horaInicio printString.</do-it><do-it>Transcript show: f borrado printString.</do-it><do-it>Transcript show: f horaInicio printString.</do-it><do-it>Transcript show: f horaInicio printString.</do-it><do-it>f := Funcion new.</do-it><do-it>f horaInicio: Time now.</do-it><do-it>'----SNAPSHOT----'</do-it><do-it>"#('c:\Users\Asus\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im' 'May 24, 2026' '1:57:37 PM')""An image file c:\Users\Asus\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im was created at 13:57:37 on 24 de mayo de 2026."</do-it><do-it>'----SNAPSHOT----'</do-it><do-it>"#('c:\Users\Asus\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im' 'May 24, 2026' '2:02:18 PM')""An image file c:\Users\Asus\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im was created at 14:02:18 on 24 de mayo de 2026."</do-it><methods><class-id>Administrador</class-id> <category>salas</category><body package="TPFinal" selector="salaTieneFuncionesActivas:">salaTieneFuncionesActivas: unIdSala
	"Devuelve true si la sala tiene alguna funcion cuyo atributo borrado sea nil o false"
	
	^funciones anySatisfy: [ :f | 
		(f idSala = unIdSala) 
			and: [ f borrado isNil or: [ f borrado = false ] ]]</body></methods><methods><class-id>WListaSalas</class-id> <category>actions</category><body package="Ventanas" selector="eliminarSala">eliminarSala	| sal |	sal := self aspSalas selection.	sal isNil		ifTrue: [Dialog warn: 'No hay sala seleccionada']		ifFalse: 			["1. Chequeamos la validación en el administrador"			(adm salaTieneFuncionesActivas: sal id)				ifTrue: 					[Dialog						warn: 'No se puede eliminar: La sala está asignada a una función activa.']				ifFalse: 					["2. Si no tiene funciones activas, pedimos confirmación"					(Dialog						confirm: '¿Confirma eliminar sala id: ' , sal id printString , ' ?')							ifFalse: [^self]							ifTrue: 								[adm eliminarSala: sal id.								aspSalas list: adm salas]]]</body></methods><do-it>'----SNAPSHOT----'</do-it><do-it>"#('c:\Users\Asus\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im' 'May 24, 2026' '2:20:59 PM')""An image file c:\Users\Asus\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im was created at 14:20:59 on 24 de mayo de 2026."</do-it><do-it>'----SNAPSHOT----'</do-it><do-it>"#('c:\Users\Asus\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im' 'May 24, 2026' '2:22:37 PM')""An image file c:\Users\Asus\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im was created at 14:22:37 on 24 de mayo de 2026."</do-it><methods><class-id>Administrador</class-id> <category>personas</category><body package="TPFinal" selector="personaEsSocio:">personaEsSocio: unIdPersona
	"Devuelve true si existe un socio asociado al id de la persona"
	
	^socios anySatisfy: [ :s | (s idPersona = unIdPersona) and: [ s estado = 'Activo' ]]</body></methods><methods><class-id>WListaPersonas</class-id> <category>actions</category><body package="Ventanas" selector="eliminarPersona">eliminarPersona	| per |	per := self aspPersonas selection.	per isNil		ifTrue: [Dialog warn: 'No hay persona seleccionada']		ifFalse: 			[(adm personaEsSocio: per id)				ifTrue: 					[Dialog						warn: 'No se puede eliminar: La persona está registrada como socio.']				ifFalse: 					[(Dialog confirm: '¿Confirma eliminar al id: ' , per id printString , ' ?')						ifFalse: [^self]						ifTrue: 							[adm eliminarPersona: per id.							aspPersonas list: adm personas]]]</body></methods><do-it>'----SNAPSHOT----'</do-it><do-it>"#('c:\Users\Asus\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im' 'May 24, 2026' '2:50:02 PM')""An image file c:\Users\Asus\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im was created at 14:50:02 on 24 de mayo de 2026."</do-it><do-it>'----SNAPSHOT----'</do-it><do-it>"#('c:\Users\Asus\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im' 'May 24, 2026' '2:51:02 PM')""An image file c:\Users\Asus\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im was created at 14:51:02 on 24 de mayo de 2026."</do-it><methods><class-id>WListaPersonas class</class-id> <category>interface specs</category><body package="Ventanas" selector="windowSpec">windowSpec	"Tools.UIPainter new openOnClass: self andSelector: #windowSpec"	&lt;resource: #canvas&gt;	^#(#{UI.FullSpec} 		#window: 		#(#{UI.WindowSpec} 			#label: 'Lista Personas' 			#min: #(#{Core.Point} 20 20 ) 			#max: #(#{Core.Point} 0 0 ) 			#bounds: #(#{Graphics.Rectangle} 283 64 1083 664 ) ) 		#component: 		#(#{UI.SpecCollection} 			#collection: #(				#(#{UI.DataSetSpec} 					#properties: #(#{UI.PropertyListDictionary} #showHorizontalLines true #allowColumnResizing true #showVerticalLines true #allowColumnReordering fal