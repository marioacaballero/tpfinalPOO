    | sal venDisponibilidad |
    sal := self aspSalas selection.
    sal isNil
        ifTrue: [Dialog warn: 'No hay sala seleccionada']
        ifFalse: [
            venDisponibilidad := WDisponibilidadSala new.
            venDisponibilidad salaSeleccionada: sal.
            venDisponibilidad openFrom: self]</body></methods><methods><class-id>WListaSalas</class-id> <category>actions</category><body package="Ventanas" selector="botonDisponibilidad">botonDisponibilidad
