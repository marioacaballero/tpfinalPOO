ssified</category><body package="Ventanas" selector="opcionesCartel">opcionesCartel	| opciones |	opciones := List new.	opciones add: 'En Cartel'.	opciones add: 'Fuera de Cartel'.	^opcionesCartel isNil		ifTrue: [opcionesCartel := opciones asValue]		ifFalse: [opcionesCartel]</body></methods><methods><class-id>WPelicula</class-id> <category>As yet unclassified</category><body package="Ventanas" selector="pelicula">pelicula	^aspPelicula value</body></methods><methods><class-id>WPelicula</class-id> <category>As yet unclassified</category><body package="Ventanas" selector="pelicula:">pelicula: unaPelicula	^self aspPelicula value: unaPelicula</body></methods><methods><class-id>WPelicula class</class-id> <category>interface specs</category><body package="Ventanas" selector="windowSpec">windowSpec	"Tools.UIPainter new openOnClass: self andSelector: #windowSpec"	&lt;resource: #canvas&gt;	^#(#{UI.FullSpec} 		#window: 		#(#{UI.WindowSpec} 			#label: 'Agregar Produccion' 			#bounds: #(#{Graphics.Rectangle} 639 167 1349 567 ) ) 		#component: 		#(#{UI.SpecCollection} 			#collection: #(				#(#{UI.GroupBoxSpec} 					#layout: #(#{Graphics.LayoutFrame} 94 0 328 0 484 0 374 0 ) 					#name: #GroupBox1 					#label: 'Acciones' ) 				#(#{UI.GroupBoxSpec} 					#layout: #(#{Graphics.LayoutFrame} 95 0 7 0 486 0 318 0 ) 					#name: #GroupBox2 					#label: 'Datos sobre la produccion' ) 				#(#{UI.InputFieldSpec} 					#layout: #(#{Graphics.LayoutFrame} 203 0 27 0 303 0 48 0 ) 					#name: #InputField1 					#model: #'aspPelicula id' 					#isReadOnly: true 					#type: #number ) 				#(#{UI.LabelSpec} 					#layout: #(#{Graphics.LayoutOrigin} 172 0 29 0 ) 					#name: #Label1 					#label: 'id' ) 				#(#{UI.InputFieldSpec} 					#layout: #(#{Graphics.LayoutFrame} 203 0 67 0 303 0 88 0 ) 					#name: #InputField2 					#model: #'aspPelicula titulo' 					#type: #text ) 				#(#{UI.LabelSpec} 					#layout: #(#{Graphics.LayoutOrigin} 154 0 67 0