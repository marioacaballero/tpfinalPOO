fTrue: 			[bos := BinaryObjectStorage onOldNoScan: fileIds.			[ultimosIds := bos contents at: 1] ensure: [bos close]]		ifFalse: 			[ultimosIds at: Administrador ultimoIdSocio put: 0.			ultimosIds at: 'ultimoIdCobros' put: 0.			ultimosIds at: 'ultimoIdGastos' put: 0.			ultimosIds at: 'ultimoIdInstalaciones' put: 0.			ultimosIds at: Administrador ultimoIdPersona put: 0]</body></methods><methods><class-id>Administrador</class-id> <category>initialize-release</category><body package="(none)" selector="iniciarGastos">iniciarGastos	| fileGastos bos |	fileGastos := 'databaseGastos.b' asFilename.	fileGastos exists		ifTrue: 			[bos := BinaryObjectStorage onOldNoScan: fileGastos.			[gastos := bos contents] ensure: [bos close]]		ifFalse: 			[gastos := OrderedCollection new.			ultimosIds at: 'ultimoIdGastos' put: 0]</body></methods><methods><class-id>Administrador</class-id> <category>initialize-release</category><body package="(none)" selector="iniciarTodo">iniciarTodo	ultimosIds := Dictionary new.	self iniciarIds.	self iniciarCobros.	self iniciarInstalaciones.	self iniciarGastos.	self iniciarPersonas.	self iniciarSocios</body></methods><methods><class-id>Administrador</class-id> <category>initialize-release</category><body package="(none)" selector="iniciarCobros">iniciarCobros	| fileCobros bos |	fileCobros := 'databaseCobros.b' asFilename.	fileCobros exists		ifTrue: 			[bos := BinaryObjectStorage onOldNoScan: fileCobros.			[cobros := bos contents] ensure: [bos close]]		ifFalse: 			[cobros := OrderedCollection new.			ultimosIds at: 'ultimoIdCobros' put: 0]</body></methods><methods><class-id>Administrador</class-id> <category>initialize-release</category><body package="(none)" selector="iniciarInstalaciones">iniciarInstalaciones	| fileInstalaciones bos |	fileInstalaciones := 'databaseInstalaciones.b' asFilename.	fileInstalaciones exists		ifTrue: 			[bos := BinaryObjectStorage onOldNoScan: fileInstalaciones.			[instalaciones := bos contents] ensure: [bos close]]		ifFalse: 			[instalaciones := OrderedCollection new.			ultimosIds at: 'ultimoIdInstalaciones' put: 0]</body></methods><methods><class-id>Administrador</class-id> <category>initialize-release</category><body package="(none)" selector="iniciarSocios">iniciarSocios	| fileSocios bos |	fileSocios := 'databaseSocios.b' asFilename.	fileSocios exists		ifTrue: 			[bos := BinaryObjectStorage onOldNoScan: fileSocios.			[socios := bos contents] ensure: [bos close]]		ifFalse: 			[socios := OrderedCollection new.			ultimosIds at: Administrador ultimoIdSocio put: 0]</body></methods><methods><class-id>Administrador</class-id> <category>accessing</category><body package="(none)" selector="cobros">cobros	^cobros</body></methods><methods><class-id>Administrador</class-id> <category>accessing</category><body package="(none)" selector="gastos:">gastos: anObject	^gastos := anObject</body></methods><methods><class-id>Administrador</class-id> <category>accessing</category><body package="(none)" selector="cobros:">cobros: anObject	^cobros := anObject</body></methods><methods><class-id>Administrador</class-id> <category>accessing</category><body package="(none)" selector="guardarTodo">guardarTodo	self guardarPersonas</body></methods><methods><class-id>Administrador</class-id> <category>accessing</category><body package="(none)" selector="guardarIds">guardarIds	| ids bos |	ids := 'databaseIds.b' asFilename writeStream.	bos := BinaryObjectStorage onNew: ids.	bos nextPut: ultimosIds.	bos close</body></methods><methods><class-id>Administrador</class-id> <category>accessing</category><body package="(none)" selector="personas:">personas: anObject	personas := anObject</body></methods><methods><class-id>Administrador</class-id> <category>accessing</category><body package="(none)" selector="instalaciones:">instalaciones: anObject	^instalaciones := anObject</body></metho