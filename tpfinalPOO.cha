	"Initialize a newly created instance. This method must answer the receiver."
	super initialize.
	actualizar := false asValue.
	^self</body></methods><methods><class-id>WListaReservas</class-id> <category>actions</category><body package="Ventanas" selector="botonNuevaReserva">botonNuevaReserva	| ventanaSocios ventanaFunciones ventanaDisponibilidad	  socioSeleccionado funcionSeleccionada salaDeFuncion butacasElegidas|	ventanaSocios := WSeleccionarSocio new.	ventanaSocios adm: adm.	ventanaSocios open.	ventanaSocios accept value ifFalse: [^self].	socioSeleccionado := ventanaSocios aspSocios selection.	ventanaFunciones := WSeleccionarFuncion new.	ventanaFunciones adm: adm.	ventanaFunciones open.	ventanaFunciones accept value ifFalse: [^self].	funcionSeleccionada := ventanaFunciones aspFunciones selection.	salaDeFuncion := adm salaConId: funcionSeleccionada idSala.	ventanaDisponibilidad := WDisponibilidadSala new.	ventanaDisponibilidad adm: adm.	ventanaDisponibilidad salaSeleccionada: salaDeFuncion.	ventanaDisponibilidad funcionSeleccionada: funcionSeleccionada.	ventanaDisponibilidad open.	ventanaDisponibilidad actualizar value ifFalse: [^self].	butacasElegidas := ventanaDisponibilidad butacasSeleccionadas.	"Acá falta: recuperar las butacas elegidas y abrir WReserva"	"ventanaReserva := WReserva new.	ventanaReserva adm: adm.	ventanaReserva open"</body></methods><do-it>'----SNAPSHOT----'</do-it><do-it>"#('c:\Users\Asus\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im' 'July 6, 2026' '12:04:21 PM')""An image file c:\Users\Asus\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im was created at 12:04:21 on 6 de julio de 2026."</do-it><methods><class-id>WDisponibilidadSala</class-id> <category>accessing</category><body package="Ventanas" selector="actualizar">actualizar
