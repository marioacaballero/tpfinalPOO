ethods><class-id>Administrador</class-id> <category>personas</category><body package="TPFinal" selector="eliminarPersona:">eliminarPersona: idPersona	| persona |	persona := personas detect: [:per | per id = idPersona].	persona borrado: true</body></methods><methods><class-id>Funcion class</class-id> <category>instance creation</category><body package="TPFinal" selector="new">new	"Answer a newly created and initialized instance."	^super new initialize</body></methods><methods><class-id>Funcion</class-id> <category>accessing</category><body package="TPFinal" selector="idSala:">idSala: anObject	idSala := anObject</body></methods><methods><class-id>Funcion</class-id> <category>accessing</category><body package="TPFinal" selector="agotada">agotada	^agotada</body></methods><methods><class-id>Funcion</class-id> <category>accessing</category><body package="TPFinal" selector="precioEntrada">precioEntrada	^precioEntrada</body></methods><methods><class-id>Funcion</class-id> <category>accessing</category><body package="TPFinal" selector="listaVentas">listaVentas	^listaVentas</body></methods><methods><class-id>Funcion</class-id> <category>accessing</category><body package="TPFinal" selector="listaVentas:">listaVentas: anObject	listaVentas := anObject</body></methods><methods><class-id>Funcion</class-id> <category>accessing</category><body package="TPFinal" selector="precioEntrada:">precioEntrada: anObject	precioEntrada := anObject</body></methods><methods><class-id>Funcion</class-id> <category>accessing</category><body package="TPFinal" selector="id">id	^id</body></methods><methods><class-id>Funcion</class-id> <category>accessing</category><body package="TPFinal" selector="id:">id: anObject	id := anObject</body></methods><methods><class-id>Funcion</class-id> <category>accessing</category><body package="TPFinal" selector="idPeliculaObra">idPeliculaObra	^idPeliculaObra</body></methods><metho