er isNil		ifTrue: [Dialog warn: 'No hay persona seleccionada']		ifFalse: 			[nuevoSocio := (Socio new)						id: (adm ultimosIds at: Administrador ultimoIdSocio) + 1;						fechaAlta: Date today;						idPersona: per id			"adm eliminarPersona: per id.			Dialog warn: per id printString			aspPersonas list: adm personas"]</body></methods><methods><class-id>WListaPersonasNoSocios</class-id> <category>actions</category><body package="Ventanas" selector="darAlta">darAlta	| per nuevoSocio |	per := self aspPersonasN selection.	per isNil		ifTrue: [Dialog warn: 'No hay persona seleccionada']		ifFalse: 			[nuevoSocio := (Socio new)						id: (adm ultimosIds at: Administrador ultimoIdSocio) + 1;						fechaAlta: Date today;						idPersona: per id.						"adm : per id.			aspPersonas list: adm personas"]</body></methods><methods><class-id>WListaPersonasNoSocios</class-id> <category>actions</category><body package="Ventanas" selector="darAlta">darAlta	| per nuevoSocio |	per := self aspPersonasN selection.	per isNil		ifTrue: [Dialog warn: 'No hay persona seleccionada']		ifFalse: 			[nuevoSocio := (Socio new)						id: (adm ultimosIds at: Administrador ultimoIdSocio) + 1;						fechaAlta: Date today;						idPersona: per id.						adm altaSocio: nuevoSocio.			"aspPersonasN list: adm personas."]</body></methods><methods><class-id>WListaPersonasNoSocios</class-id> <category>accessing</category><body package="Ventanas" selector="adm:">adm: unAdministrador	"unAdministrador notNil		ifTrue: [Dialog warn: unAdministrador personas printString."	| perNoSocios |	adm := unAdministrador.	perNoSocios := adm personas select: [].	self aspPersonasN list: adm personas	"]		ifFalse: [Dialog warn: 'adm vacio']	adm := unAdministrador.	self aspPersonasN list: adm personas"</body></methods><methods><class-id>WListaPersonasNoSocios</class-id> <category>accessing</category><body package="Ventanas" selector="adm:">adm: unAdministrador	"unAdministrador notNil		ifTrue: [Dialog warn: unAdministrador personas printString."	| perNoSocios sociosActivos sociosActivosPerId|	adm := unAdministrador.	sociosActivos := adm socios select: [:soc | soc estado = Socio activo].	sociosActivosPerId := sociosActivos collect: [:s | s idPersona].	perNoSocios := adm personas select: [:per | (sociosActivosPerId includes: per id) not ].	self aspPersonasN list: adm personas	"]		ifFalse: [Dialog warn: 'adm vacio']	adm := unAdministrador.	self aspPersonasN list: adm personas"</body></methods><methods><class-id>WListaPersonasNoSocios</class-id> <category>accessing</category><body package="Ventanas" selector="adm:">adm: unAdministrador	"unAdministrador notNil		ifTrue: [Dialog warn: unAdministrador personas printString."	| perNoSocios sociosActivos sociosActivosPerId |	adm := unAdministrador.	sociosActivos := adm socios select: [:soc | soc estado = Socio activo].	sociosActivosPerId := sociosActivos collect: [:s | s idPersona].	perNoSocios := adm personas				select: [:per | (sociosActivosPerId includes: per id) not].	self aspPersonasN list: perNoSocios	"]		ifFalse: [Dialog warn: 'adm vacio']	adm := unAdministrador.	self aspPersonasN list: adm personas"</body></methods><do-it>'----SNAPSHOT----'</do-it><do-it>"#('/home/marito/vw8.2pul/bin/linuxx86_64/../../image/tpfinalPOO/tpfinalPOO.im' 'April 16, 2026' '9:34:19 PM')""An image file /home/marito/vw8.2pul/bin/linuxx86_64/../../image/tpfinalPOO/tpfinalPOO.im was created at 9:34:19 PM on April 16, 2026."</do-it><methods><class-id>WListaPersonas</class-id> <category>accessing</category><body package="Ventanas" selector="adm:">adm: unAdministrador	adm := unAdministrador."	Dialog warn: adm personas printString."	self aspPersonas list: adm personas</body></methods><methods><class-id>WListaPersonasNoSocios class</class-id> <category>interface specs</category><body package="Ventanas" selector="windowSpec">windowSpec	"Tools.UIPainter new openOnClass: