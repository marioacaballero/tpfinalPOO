 					#layout: #(#{Graphics.LayoutOrigin} 272 0 43 0 ) 					#name: #Label1 					#label: 'Id Funcion' ) 				#(#{UI.LabelSpec} 					#layout: #(#{Graphics.LayoutOrigin} 272 0 88 0 ) 					#name: #Label2 					#label: 'Id Sala' ) 				#(#{UI.LabelSpec} 					#layout: #(#{Graphics.LayoutOrigin} 272 0 176 0 ) 					#name: #Label3 					#label: 'Fecha (dd/mm/aa)' ) 				#(#{UI.LabelSpec} 					#layout: #(#{Graphics.LayoutOrigin} 272 0 132 0 ) 					#name: #Label4 					#label: 'Id Produccion' ) 				#(#{UI.LabelSpec} 					#layout: #(#{Graphics.LayoutOrigin} 272 0 221 0 ) 					#name: #Label5 					#label: 'Hora inicio (hh:mm:ss)' ) 				#(#{UI.LabelSpec} 					#layout: #(#{Graphics.LayoutOrigin} 272 0 265 0 ) 					#name: #Label6 					#label: 'Precio de entrada' ) 				#(#{UI.InputFieldSpec} 					#layout: #(#{Graphics.LayoutSizedOrigin} 272 0 58 0 125 21 ) 					#name: #InputField1 					#flags: 40 					#model: #'aspFuncion id' 					#isReadOnly: true 					#type: #number ) 				#(#{UI.InputFieldSpec} 					#layout: #(#{Graphics.LayoutSizedOrigin} 272 0 103 0 125 21 ) 					#name: #InputField2 					#flags: 40 					#model: #'aspFuncion idSala' 					#isReadOnly: true 					#type: #number ) 				#(#{UI.InputFieldSpec} 					#layout: #(#{Graphics.LayoutSizedOrigin} 272 0 147 0 125 21 ) 					#name: #InputField3 					#flags: 40 					#model: #'aspFuncion idPeliculaObra' 					#isReadOnly: true 					#type: #number ) 				#(#{UI.InputFieldSpec} 					#layout: #(#{Graphics.LayoutSizedOrigin} 272 0 191 0 125 21 ) 					#name: #InputField4 					#model: #'aspFuncion fecha' 					#type: #date ) 				#(#{UI.InputFieldSpec} 					#layout: #(#{Graphics.LayoutSizedOrigin} 272 0 236 0 125 21 ) 					#name: #InputField5 					#model: #'aspFuncion horaInicio' 					#type: #time ) 				#(#{UI.InputFieldSpec} 					#layout: #(#{Graphics.LayoutSizedOrigin} 272 0 280 0 125 21 ) 					#name: #InputField6 					#model: #'aspFuncion precioEntrada' 					#type: #number ) 				#(#{UI.ActionButtonSpec} 					#layout: #(#{Graphics.LayoutFrame} 235 0 334 0 287 0 355 0 ) 					#name: #ActionButton1 					#model: #botonGuardarFuncion 					#label: 'Guardar' 					#defaultable: true ) 				#(#{UI.ActionButtonSpec} 					#layout: #(#{Graphics.LayoutFrame} 376 0 334 0 428 0 355 0 ) 					#name: #ActionButton2 					#model: #botonCancelarFuncion 					#label: 'Cancelar' 					#defaultable: true ) ) ) )</body></methods><methods><class-id>WFuncion</class-id> <category>actions</category><body package="Ventanas" selector="botonCancelarFuncion">botonCancelarFuncion	"This stub method was generated by UIDefiner"	^self closeRequest.</body></methods><methods><class-id>WFuncion</class-id> <category>actions</category><body package="Ventanas" selector="botonCancelarFuncion">botonCancelarFuncion	"This stub method was generated by UIDefiner"	^self closeRequest</body></methods><methods><class-id>WListaFunciones</class-id> <category>actions</category><body package="Ventanas" selector="botonAgregarFuncion">botonAgregarFuncion	| venSL venPeli venFun nuevaFun salaSeleccionada peliSeleccionada |	venSL := WListaSalaSeleccion new.	venSL adm: adm.	venSL open.	venSL accept value ifFalse: [^self].	salaSeleccionada := venSL aspSalas selection.	venPeli := WListaPeliculaObraSeleccion new.	venPeli adm: adm.	venPeli open.	venPeli accept value ifFalse: [^self].	peliSeleccionada := venPeli aspPeliculasObras selection.	nuevaFun := Funcion new.	nuevaFun id: (adm ultimosIds at: Administrador ultimoIdFuncion) + 1.	nuevaFun idSala: salaSeleccionada id.	nuevaFun idPeliculaObra: peliSeleccionada id.	venFun := WFuncion new.	venFun funcion: nuevaFun.	venFun adm: adm.	venFun open.	venFun accept value		ifTrue: 			[Dialog warn: 'Guardado'.			adm agregarFuncion: venFun aspFuncion value.			adm funciones do: 					[:f |					f nombreSala: (adm salas detect: [:s | s id = f idSala]) nombre.					f nombreProduccion: (adm peliculas detect: [:p | p id = f idPeliculaObra])								titulo].			self aspFunciones list: adm funciones]</body></methods><do-it>'----SNAPSHOT----'</do-it><do-it>"#('c:\Users\mario\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im' 'June 26, 2026' '3:00:29 PM')""An image file c:\Users\mario\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im was created at 3:00:29 PM on June 26, 2026."</do-it><do-it>'----SNAPSHOT----'</do-it><do-it>"#('c:\Users\mario\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im' 'June 26, 2026' '3:00:37 PM')""An image file c:\Users\mario\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im was created at 3:00:37 PM on June 26, 2026."</do-it><methods><class-id>WPersona class</class-id> <category>interface specs</category><body package="Ventanas" selector="windowSpec">windowSpec	"Tools.UIPainter new openOnClass: self andSelector: #windowSpec"	&lt;resource: #canvas&gt;	^#(#{UI.FullSpec} 		#window: 		#(#{UI.WindowSpec} 			#properties: #(#{UI.PropertyListDictionary} #sizeType #specifiedSize #positionType #screenCenter #openType #advanced ) 			#label: 'Persona' 			#min: #(#{Core.Point} 20 20 ) 			#max: #(#{Core.Point} 0 0 ) 			#bounds: #(#{Graphics.Rectangle} 318 108 1218 708 ) ) 		#component: 		#(#{UI.SpecCollection} 			#collection: #(				#(#{UI.GroupBoxSpec} 					#layout: #(#{Graphics.LayoutFrame} 33 0 16 0 532 0 353 0 ) 					#name: #GroupBox1 					#label: 'Datos Persona' ) 				#(#{UI.GroupBoxSpec} 					#layout: #(#{Graphics.LayoutFrame} 198 0 382 0 423 0 431 0 ) 					#name: #GroupBox2 					#label: 'Acciones' ) 				#(#{UI.LabelSpec} 					#layout: #(#{Graphics.LayoutFrame} 224 0 48 0 236 0 63 0 ) 					#name: #LabelId 					#label: 'ID' ) 				#(#{UI.LabelSpec} 					#layout: #(#{Graphics.LayoutOrigin} 190 0 79 0 ) 					#name: #LabelNombre 					#label: 'Nombre' ) 				#(#{UI.LabelSpec} 					#layout: #(#{Graphics.LayoutOrigin} 215 0 119 0 ) 					#name: #LabelDni 					#label: 'DNI' ) 				#(#{UI.LabelSpec} 					#layou