        aGraphicsContext paint: ColorValue black.
        aGraphicsContext
            displayString: etiqueta
            at: (x + 5) @ (y + 10)
    ]</body></methods><methods><class-id>ButacasGridView</class-id> <category>displaying</category><body package="Ventanas" selector="displayOn:">displayOn: aGraphicsContext	| butacas anchoButaca altoButaca margen x y color etiqueta |	sala isNil ifTrue: [^self].	butacas := sala butacas.	anchoButaca := 38.	altoButaca := 30.	margen := 6.	butacas do: 			[:butaca |			x := margen + ((butaca posicion - 1) * (anchoButaca + margen)).			y := margen + ((butaca posicionY - 1) * (altoButaca + margen)).			"Color según disponibilidad"			color := butaca estaDisponible						ifTrue: [ColorValue green]						ifFalse: [ColorValue red].			"Relleno"			aGraphicsContext paint: color.			aGraphicsContext fillRectangle: (x @ y extent: anchoButaca @ altoButaca).			"Borde"			aGraphicsContext paint: ColorValue black.			aGraphicsContext				displayRectangle: (x @ y extent: anchoButaca @ altoButaca).			"Etiqueta: ej. 'A1', 'B3'"			etiqueta := butaca fila printString , butaca numero printString.			aGraphicsContext paint: ColorValue black.			aGraphicsContext displayString: etiqueta at: (x + 5) @ (y + 10)]</body></methods><methods><class-id>WDisponibilidadSala</class-id> <category>interface opening</category><body package="Ventanas" selector="postBuildWith:">postBuildWith: aBuilder
