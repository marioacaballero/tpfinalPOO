	adm personas add: aspPersona value.	adm ultimoIdPersona.	^self closeRequest</body></methods><methods><class-id>WPersona</class-id> <category>actions</category><body package="Ventanas" selector="botonAceptar">botonAceptar	adm personas add: aspPersona value.	adm actualizarUltimoIdPersona.	^self closeRequest</body></methods><methods><class-id>Administrador</class-id> <category>personas</category><body package="TPFinal" selector="actualizarUltimoIdPersona">actualizarUltimoIdPersona	| idMayor |	personas size = 0		ifTrue: [ultimoIdPersona := 0]		ifFalse: 			[idMayor := 0.			personas do: [:p | idMayor &lt; p id ifTrue: [idMayor := p id]].			ultimoIdPersona := idMayor]</body></methods><do-it>'----SNAPSHOT----'</do-it><do-it>"#('/home/mario/vw8.2pul/bin/linuxx86_64/imagenTPfinal/tpfinalPOO.im' 'November 4, 2025' '3:22:19 PM')""An image file /home/mario/vw8.2pul/bin/linuxx86_64/imagenTPfinal/tpfinalPOO.im was created at 3:22:19 PM on November 4, 2025."</do-it><do-it>'----SNAPSHOT----'</do-it><do-it>"#('/home/mario/vw8.2pul/bin/linuxx86_64/imagenTPfinal/tpfinalPOO.im' 'November 4, 2025' '3:22:20 PM')""An image file /home/mario/vw8.2pul/bin/linuxx86_64/imagenTPfinal/tpfinalPOO.im was created at 3:22:20 PM on November 4, 2025."</do-it><do-it>'----SNAPSHOT----'</do-it><do-it>"#('/home/mario/vw8.2pul/bin/linuxx86_64/imagenTPfinal/tpfinalPOO.im' 'November 4, 2025' '3:22:23 PM')""An image file /home/mario/vw8.2pul/bin/linuxx86_64/imagenTPfinal/tpfinalPOO.im was created at 3:22:23 PM on November 4, 2025."</do-it><do-it>'----SNAPSHOT----'</do-it><do-it>"#('/home/mario/vw8.2pul/bin/linuxx86_64/imagenTPfinal/tpfinalPOO.im' 'November 4, 2025' '3:22:49 PM')""An image file /home/mario/vw8.2pul/bin/linuxx86_64/imagenTPfinal/tpfinalPOO.im was created at 3:22:49 PM on November 4, 2025."</do-it><methods><class-id>WListaPersonas</class-id> <category>actions</category><body package="Ventanas" selector="modificarPersona">modificarPersona	| per |	per := self aspPersona value.	per isNil ifTrue: [self inform: 'Seleccionar persona'].</body></methods><methods><class-id>WListaPersonas</class-id> <category>actions</category><body package="Ventanas" selector="modificarPersona">modificarPersona	| per |	per := self aspPersona value.	per isNil ifTrue: [self inform: 'Seleccionar persona']</body></methods><methods><class-id>WListaPersonas</class-id> <category>actions</category><body package="Ventanas" selector="modificarPersona">modificarPersona	| per ventanaPersona |	per := self aspPersona value.	per isNil		ifTrue: [self inform: 'Seleccionar persona']		ifFalse: 			[ventanaPersona := WPersona new.			ventanaPersona adm: adm.			ventanaPersona persona: per.			ventanaPersona open]</body></methods><methods><class-id>WListaPersonas</class-id> <category>actions</category><body package="Ventanas" selector="modificarPersona">modificarPersona	| per ventanaPersona |	per := self aspPersona value.	per isNil		ifTrue: []		ifFalse: 			[ventanaPersona := WPersona new.			ventanaPersona adm: adm.			ventanaPersona persona: per.			ventanaPersona open]</body></methods><do-it>WPersona class organization addCategory: #estados</do-it><methods><class-id>WPersona class</class-id> <category>estados</category><body package="Ventanas" selector="editar">editar	^'Editar'</body></methods><methods><class-id>WPersona class</class-id> <category>estados</category><body package="Ventanas" selector="crear">crear	^'Crear'</body></methods><methods><class-id>WPersona class</class-id> <category>estados</category><body package="Ventanas" selector="ver">ver	^'Ver'</body></methods><class><name>WPersona</name><environment>Smalltalk</environment><super>UI.SimpleDialog</super><private>false</private><indexed-type>none</indexed-type><inst-vars>aspPersona opcionesSexo adm modo </inst-vars><class-inst-vars></class-inst-vars><imports></imports><category></category><attributes><package