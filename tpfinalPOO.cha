><body package="Ventanas" selector="altaPelicula">altaPelicula	| ventanaPelicula nuevaPelicula |	ventanaPelicula := WPelicula new.	nuevaPelicula := PeliculaObra new				id: (adm ultimosIds at: Administrador ultimoIdPelicula) + 1.	ventanaPelicula pelicula: nuevaPelicula.	ventanaPelicula open.	ventanaPelicula acepto		ifTrue: 			[adm agregarPelicula: ventanaPelicula aspPelicula value.			aspPeliculasObras list: adm peliculas]	"	Dialog warn: ventanaPersona aspPersona value printString"</body></methods><methods><class-id>WPelicula class</class-id> <category>interface specs</category><body package="Ventanas" selector="windowSpec">windowSpec	"Tools.UIPainter new openOnClass: self andSelector: #windowSpec"	&lt;resource: #canvas&gt;	^#(#{UI.FullSpec} 		#window: 		#(#{UI.WindowSpec} 			#label: 'Agregar Produccion' 			#bounds: #(#{Graphics.Rectangle} 0 23 710 423 ) ) 		#component: 		#(#{UI.SpecCollection} 			#collection: #(				#(#{UI.GroupBoxSpec} 					#layout: #(#{Graphics.LayoutFrame} 100 0 413 0 490 0 459 0 ) 					#name: #GroupBox1 					#label: 'Acciones' ) 				#(#{UI.GroupBoxSpec} 					#layout: #(#{Graphics.LayoutFrame} 108 0 11 0 488 0 400 0 ) 					#name: #GroupBox2 					#label: 'Datos sobre la produccion' ) 				#(#{UI.InputFieldSpec} 					#layout: #(#{Graphics.LayoutFrame} 203 0 27 0 303 0 48 0 ) 					#name: #InputField1 					#model: #'aspPelicula id' 					#isReadOnly: true 					#type: #number ) 				#(#{UI.LabelSpec} 					#layout: #(#{Graphics.LayoutOrigin} 172 0 29 0 ) 					#name: #Label1 					#label: 'id' ) 				#(#{UI.InputFieldSpec} 					#layout: #(#{Graphics.LayoutFrame} 203 0 67 0 303 0 88 0 ) 					#name: #InputField2 					#model: #'aspPelicula titulo' 					#type: #text ) 				#(#{UI.LabelSpec} 					#layout: #(#{Graphics.LayoutOrigin} 154 0 67 0 ) 					#name: #Label2 					#label: 'titulo' ) 				#(#{UI.InputFieldSpec} 					#layout: #(#{Graphics.LayoutFrame} 203 0 106 0 303 0 127 0 ) 					#name: #InputField3 	