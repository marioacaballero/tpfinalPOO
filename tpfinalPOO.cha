category><body package="Ventanas" selector="agregarPelicula">agregarPelicula	| ventanaPeliculaObra nuevaProduccion |	ventanaPeliculaObra := WPersona new.	nuevaProduccion := PeliculaObra new				id: (adm ultimosIds at: Administrador ultimoIdPelicula) + 1.	ventanaPeliculaObra persona: nuevaProduccion.	ventanaPeliculaObra open.	ventanaPeliculaObra acepto		ifTrue: 			[adm agregarPersona: ventanaPeliculaObra aspPeliculaObra value.			aspPeliculasObras list: adm peliculas]	"	Dialog warn: ventanaPersona aspPersona value printString"</body></methods><methods><class-id>WListaPeliculaObra</class-id> <category>actions</category><body package="Ventanas" selector="modificarPelicula">modificarPelicula	| pro ventanaProduccion |	pro := self aspPeliculasObras selection.	pro isNil		ifTrue: [Dialog warn: 'No hay persona seleccionada']		ifFalse: 			[ventanaProduccion := WPersona new.	" cambiar por WPeliculaObra"			ventanaProduccion persona: pro.			ventanaProduccion open.			ventanaProduccion acepto				ifTrue: 					[adm modificarPelicula: ventanaProduccion aspPeliculaObra value.					aspPeliculasObras list: adm peliculas]]</body></methods><methods><class-id>WListaPeliculaObra</class-id> <category>actions</category><body package="Ventanas" selector="agregarPelicula">agregarPelicula	| ventanaPeliculaObra nuevaProduccion |	ventanaPeliculaObra := WPersona new." cambiar por WPeliculaObra" 	nuevaProduccion := PeliculaObra new				id: (adm ultimosIds at: Administrador ultimoIdPelicula) + 1.	ventanaPeliculaObra persona: nuevaProduccion.	ventanaPeliculaObra open.	ventanaPeliculaObra acepto		ifTrue: 			[adm agregarPersona: ventanaPeliculaObra aspPeliculaObra value.			aspPeliculasObras list: adm peliculas]	"	Dialog warn: ventanaPersona aspPersona value printString"</body></methods><do-it>'----SNAPSHOT----'</do-it><do-it>"#('c:\Users\Asus\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im' 'April 25, 2026' '1:11:20 PM')""An image file c:\User