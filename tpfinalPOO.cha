iculas fileSalas fileFunciones fileReservas fileEntradas |	super initialize.	"----------PERSONAS-------------"	"	filePersonas := 'databasePersonas.b' asFilename.	filePersonas exists		ifTrue: 			[bos := BinaryObjectStorage onOldNoScan: filePersonas.			[personas := bos contents] ensure: [bos close]]		ifFalse: [personas := OrderedCollection new]."	personas := OrderedCollection new.	"----------SOCIOS-------------"	fileSocios := 'databaseSocios.b' asFilename.	fileSocios exists		ifTrue: 			[bos := BinaryObjectStorage onOldNoScan: fileSocios.			[socios := bos contents] ensure: [bos close]]		ifFalse: [socios := OrderedCollection new].	"----------PELICULAS-------------"	filePeliculas := 'databasePeliculas.b' asFilename.	filePeliculas exists		ifTrue: 			[bos := BinaryObjectStorage onOldNoScan: filePeliculas.			[peliculas := bos contents] ensure: [bos close]]		ifFalse: [peliculas := OrderedCollection new].	"----------SALAS-------------"	fileSalas := 'databaseSalas.b' asFilename.	fileSalas exists		ifTrue: 			[bos := BinaryObjectStorage onOldNoScan: fileSalas.			[salas := bos contents] ensure: [bos close]]		ifFalse: [salas := OrderedCollection new].	"----------FUNCIONES-------------"	fileFunciones := 'databaseFunciones.b' asFilename.	fileFunciones exists		ifTrue: 			[bos := BinaryObjectStorage onOldNoScan: fileFunciones.			[funciones := bos contents] ensure: [bos close]]		ifFalse: [funciones := OrderedCollection new].	"----------RESERVAS-------------"	fileReservas := 'databaseReservas.b' asFilename.	fileReservas exists		ifTrue: 			[bos := BinaryObjectStorage onOldNoScan: fileReservas.			[reservas := bos contents] ensure: [bos close]]		ifFalse: [reservas := OrderedCollection new].	"----------ENTRADAS-------------"	fileEntradas := 'databaseEntradas.b' asFilename.	fileEntradas exists		ifTrue: 			[bos := BinaryObjectStorage onOldNoScan: fileEntradas.			[entradas := bos contents] ensure: [bos close]]		ifFalse: [entradas := OrderedCollection new].	"----------ACTUALIZACIONES-------------"	self actualizarUltimoIdPersona.	^self</body></methods><class><name>WPersona</name><environment>Smalltalk</environment><super>UI.SimpleDialog</super><private>false</private><indexed-type>none</indexed-type><inst-vars>aspPersona opcionesSexo actualizar adm </inst-vars><class-inst-vars></class-inst-vars><imports></imports><category></category><attributes><package>Ventanas</package></attributes></class><methods><class-id>WPersona</class-id> <category>accessing</category><body package="Ventanas" selector="adm">adm	^adm</body></methods><methods><class-id>WPersona</class-id> <category>accessing</category><body package="Ventanas" selector="adm:">adm: anObject	adm := anObject</body></methods><remove-selector><class-id>WPersona</class-id> <selector>adm:</selector></remove-selector><remove-selector><class-id>WPersona</class-id> <selector>adm</selector></remove-selector><class><name>WPersona</name><environment>Smalltalk</environment><super>UI.SimpleDialog</super><private>false</private><indexed-type>none</indexed-type><inst-vars>aspPersona opcionesSexo actualizar </inst-vars><class-inst-vars></class-inst-vars><imports></imports><category></category><attributes><package>Ventanas</package></attributes></class><methods><class-id>WListaPersonas</class-id> <category>actions</category><body package="Ventanas" selector="altaPersona">altaPersona	| ventanaPersona nuevaPersona |	ventanaPersona := WPersona new.	nuevaPersona := Persona new id: adm ultimoIdPersona + 1.	ventanaPersona persona: nuevaPersona.	ventanaPersona open.	ventanaPersona acepto		ifTrue: 			["self agregarPersona: aspPersona value"			"adm actualizarUltimoIdPersona"			adm personas add: aspPersona value.			aspPersonas list: adm personas.			].		</body></methods><methods><class-id>WListaPersonas</class-id> <category>actions</category><body package="Ventanas" selector="altaPersona">altaPerso