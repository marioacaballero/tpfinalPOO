class-id>WListaPersonas</class-id> <category>actions</category><body package="Ventanas" selector="modificarPersona">modificarPersona	| per ventanaPersona |	per := self aspPersonas selection.	per isNil		ifTrue: [Dialog warn: 'No hay persona seleccionada']		ifFalse: 			[ventanaPersona := WPersona new.			ventanaPersona persona: per.			ventanaPersona open.			ventanaPersona acepto				ifTrue: [adm modificarPersona: ventanaPersona aspPersona value]]</body></methods><methods><class-id>WListaPersonas</class-id> <category>actions</category><body package="Ventanas" selector="modificarPersona">modificarPersona	| per ventanaPersona |	per := self aspPersonas selection.	per isNil		ifTrue: [Dialog warn: 'No hay persona seleccionada']		ifFalse: 			[ventanaPersona := WPersona new.			ventanaPersona persona: per.			ventanaPersona open.			ventanaPersona acepto				ifTrue: 					[adm modificarPersona: ventanaPersona aspPersona value.					aspPersonas list: adm personas]]</body></methods><do-it>'----SNAPSHOT----'</do-it><do-it>"#('c:\Users\mario\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im' 'November 6, 2025' '5:56:12 PM')""An image file c:\Users\mario\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im was created at 5:56:12 PM on November 6, 2025."</do-it><do-it>'----SNAPSHOT----'</do-it><do-it>"#('c:\Users\mario\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im' 'November 6, 2025' '5:56:18 PM')""An image file c:\Users\mario\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im was created at 5:56:18 PM on November 6, 2025."</do-it><methods><class-id>Administrador</class-id> <category>initialize-release</category><body package="TPFinal" selector="iniciarPersonas">iniciarPersonas	| filePersonas bos |	filePersonas := 'databasePersonas.b' asFilename.	filePersonas exists		ifTrue: 			[bos := BinaryObjectStorage onOldNoScan: filePersonas.			[personas := bos contents] ensure: [bos close]]		ifFalse: [personas := Ordered