elf closeRequest</body></methods><methods><class-id>WSeleccionarSocio</class-id> <category>accessing</category><body package="Ventanas" selector="adm:">adm: unAdministrador	adm := unAdministrador.	self aspSocios list: (adm socios select: [:s | s estado = Socio activo])</body></methods><do-it>'----SNAPSHOT----'</do-it><do-it>"#('c:\Users\Abril Dacuez\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im' 'June 30, 2026' '10:15:57 PM')""An image file c:\Users\Abril Dacuez\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im was created at 22:15:57 on 30 de junio de 2026."</do-it><do-it>'----SNAPSHOT----'</do-it><do-it>"#('c:\Users\Abril Dacuez\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im' 'June 30, 2026' '10:15:59 PM')""An image file c:\Users\Abril Dacuez\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im was created at 22:15:59 on 30 de junio de 2026."</do-it><do-it>'----SNAPSHOT----'</do-it><do-it>"#('c:\Users\Abril Dacuez\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im' 'June 30, 2026' '10:16:13 PM')""An image file c:\Users\Abril Dacuez\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im was created at 22:16:13 on 30 de junio de 2026."</do-it><do-it>'----SNAPSHOT----'</do-it><do-it>"#('c:\Users\Abril Dacuez\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im' 'June 30, 2026' '10:16:18 PM')""An image file c:\Users\Abril Dacuez\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im was created at 22:16:18 on 30 de junio de 2026."</do-it><methods><class-id>WMenuAdministrador class</class-id> <category>interface specs</category><body package="Ventanas" selector="windowSpec">windowSpec	"Tools.UIPainter new openOnClass: self andSelector: #windowSpec"	&lt;resource: #canvas&gt;	^#(#{UI.FullSpec} 		#window: 		#(#{UI.WindowSpec} 			#properties: #(#{UI.PropertyListDictionary} #sizeType #specifiedSize #positionType #screenCenter #openType #advanced ) 			#label: 'Menu Administrador' 			#min: #(#{C