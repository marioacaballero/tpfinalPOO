 list: adm peliculas]	</body></methods><methods><class-id>WListaSalaSeleccion</class-id> <category>actions</category><body package="Ventanas" selector="botonSeleccionarSala">botonSeleccionarSala	self aspSalas selection isNil		ifTrue: [^Dialog warn: 'Por favor, seleccione una sala.'].	self accept value: true.	self closeRequest</body></methods><methods><class-id>WListaPeliculaObraSeleccion</class-id> <category>actions</category><body package="Ventanas" selector="botonSeleccionarProduccion">botonSeleccionarProduccion	self aspPeliculasObras selection isNil		ifTrue: [^Dialog warn: 'Por favor, seleccione una producción.'].	self accept value: true.	self closeRequest</body></methods><methods><class-id>WListaFunciones</class-id> <category>actions</category><body package="Ventanas" selector="botonAgregarFuncion">botonAgregarFuncion
    | venSL venPeli venFun nuevaFun salaSeleccionada peliSeleccionada |
    
   
    venSL := WListaSalaSeleccion new.
    venSL adm: adm.
    venSL open.   
    venSL accept value ifFalse: [ ^self ].
    salaSeleccionada := venSL aspSalas selection.  
    venPeli := WListaPeliculaObraSeleccion new.
    venPeli adm: adm.
    venPeli open.
    venPeli accept value ifFalse: [ ^self ].
    peliSeleccionada := venPeli aspPeliculasObras selection.
    nuevaFun := Funcion new.
    nuevaFun id: (adm ultimosIds at: Administrador ultimoIdFuncion) + 1.
    nuevaFun idSala: salaSeleccionada id.
    nuevaFun idPeliculaObra: peliSeleccionada id.
    venFun := WFuncion new.
    venFun funcion: nuevaFun.
    venFun open.
    venFun accept value ifTrue: [
        Dialog warn: 'Guardando nueva función'.
        adm agregarFuncion: venFun aspFuncion value. 
        self aspFunciones list: adm funciones. 
    ].</body></methods><do-it>'----SNAPSHOT----'</do-it><do-it>"#('c:\Users\Asus\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im' 'May 23, 2026' '1:41:33 PM')""An image file c:\Users\Asus\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im was created at 13:41:33 on 23 de mayo de 2026."</do-it><methods><class-id>WFuncion</class-id> <category>actions</category><body package="Ventanas" selector="botonGuardarFuncion">botonGuardarFuncion
