 hay produccion seleccionada']		ifFalse: 			[Dialog warn: 'Pelicula id:' , pel id printString.			venCri := WListaCriticas new.			venCri pelicula: pel.			venCri open.			]</body></methods><methods><class-id>WListaCriticas class</class-id> <category>interface specs</category><body package="Ventanas" selector="windowSpec">windowSpec	"Tools.UIPainter new openOnClass: self andSelector: #windowSpec"	&lt;resource: #canvas&gt;	^#(#{UI.FullSpec} 		#window: 		#(#{UI.WindowSpec} 			#label: 'Criticas' 			#bounds: #(#{Graphics.Rectangle} 1 31 792 727 ) ) 		#component: 		#(#{UI.SpecCollection} 			#collection: #(				#(#{UI.GroupBoxSpec} 					#layout: #(#{Graphics.LayoutFrame} 32 0 46 0 541 0 515 0 ) 					#name: #GroupBox1 					#label: 'Lista de Criticas' ) 				#(#{UI.GroupBoxSpec} 					#layout: #(#{Graphics.LayoutFrame} 566 0 46 0 712 0 164 0 ) 					#name: #GroupBox2 					#label: 'Acciones' ) 				#(#{UI.DataSetSpec} 					#properties: #(#{UI.PropertyListDictionary} #showHorizontalLines true #allowColumnResizing true #showVerticalLines true #allowColumnReordering false ) 					#layout: #(#{Graphics.LayoutFrame} 41 0 61 0 540 0 468 0 ) 					#name: #Dataset1 					#flags: 13 					#model: #aspCriticas 					#columns: #(						#(#{UI.DataSetColumnSpec} 							#properties: #(#{UI.PropertyListDictionary} #allowSorting true #labelFromApplication false ) 							#model: #'aspCriticas id' 							#label: 'id' 							#labelIsImage: false 							#width: 80 							#rendererType: #Text 							#editorType: #None 							#type: #number 							#noScroll: false ) 						#(#{UI.DataSetColumnSpec} 							#properties: #(#{UI.PropertyListDictionary} #allowSorting true #labelFromApplication false ) 							#model: #'aspCriticas idCritico' 							#label: 'id Critico' 							#labelIsImage: false 							#width: 80 							#rendererType: #Text 							#editorType: #None 							#type: #number 							#noScroll: false ) 						#(#{UI.DataSetColumnSpec} 							#prop