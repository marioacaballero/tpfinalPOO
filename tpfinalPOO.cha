s.UIPainter new openOnClass: self andSelector: #windowSpec"	&lt;resource: #canvas&gt;	^#(#{UI.FullSpec} 		#window: 		#(#{UI.WindowSpec} 			#label: 'Disponibilidad Sala' 			#min: #(#{Core.Point} 20 20 ) 			#max: #(#{Core.Point} 0 0 ) 			#bounds: #(#{Graphics.Rectangle} 769 169 969 369 ) ) 		#component: 		#(#{UI.SpecCollection} 			#collection: #(				#(#{UI.RegionSpec} 					#layout: #(#{Graphics.LayoutFrame} 181 0 93 0 741 0 528 0 ) 					#name: #contenedorButacas 					#lineWidth: 2 ) ) ) )</body></methods><methods><class-id>WDisponibilidadSala</class-id> <category>interface opening</category><body package="Ventanas" selector="postBuildWith:">postBuildWith: aBuilder	| wrapper contenedor |	super postBuildWith: aBuilder.	"Buscamos el componente"	wrapper := aBuilder componentAt: #contenedorButacas.	"Verificamos si lo encontró antes de pedirle el widget"	wrapper		ifNotNil: 			[contenedor := wrapper widget.			contenedor backgroundColor: ColorValue lightGray]		ifNil: 			[Transcript				show: 'ATENCIÓN: No se encontró el ID #contenedorButacas en la ventana';				cr]</body></methods><methods><class-id>WDisponibilidadSala</class-id> <category>interface opening</category><body package="Ventanas" selector="postBuildWith:">postBuildWith: aBuilder
    | contenedor boton x y ancho alto separacion miSala |
    super postBuildWith: aBuilder.
    
    "1. Atrapamos el Region"
    contenedor := (aBuilder componentAt: #contenedorButacas) widget.
    
    "2. Obtenemos la sala. Si todavía no se la asignaron, salimos para no romper"
    miSala := self salaSeleccionada.
    miSala ifNil: [ ^self ].
    
    "3. Configuramos los tamaños de los 'silloncitos'"
    ancho := 30.
    alto := 30.
    separacion := 5.
    
    "4. Generamos la cuadrícula iterando por tus variables"
    1 to: miSala filas do: [ :f |
        1 to: miSala butacasFila do: [ :c |
            boton := ActionButtonView new.
            
            x := (c - 1) * (ancho + separacion).
            y := (f - 1) * (alto + separacion).
            boton bounds: (x @ y extent: ancho @ alto).
            
            "Por ahora, los pintamos todos de verde para verificar que se dibujan"
            boton backgroundColor: ColorValue green.
            
            "Metemos el botón adentro del Region"
            contenedor add: boton.
        ]
    ].</body></methods><do-it>miSalaDePrueba := Sala new.</do-it><do-it>miSalaDePrueba filas: 10.</do-it><do-it>miSalaDePrueba butacasFila: 10. </do-it><do-it>ventana := WDisponibilidadSala new.</do-it><do-it>ventana salaSeleccionada: miSalaDePrueba.</do-it><class><name>WListaSalas</name><environment>Smalltalk</environment><super>UI.SimpleDialog</super><private>false</private><indexed-type>none</indexed-type><inst-vars>aspSalas aspSala adm </inst-vars><class-inst-vars></class-inst-vars><imports></imports><category></category><attributes><package>Ventanas</package></attributes></class><do-it>Smalltalk defineClass: #WListaSalas	superclass: #{UI.SimpleDialog}	indexedType: #none	private: false	instanceVariableNames: 'aspSalas aspSala adm  '	classInstanceVariableNames: ''	imports: ''	category: ''</do-it><methods><class-id>WListaSalas</class-id> <category>actions</category><body package="Ventanas" selector="botonDisponibilidad">botonDisponibilidad	"This stub method was generated by UIDefiner"	^self</body></methods><methods><class-id>WListaSalas class</class-id> <category>interface specs</category><body package="Ventanas" selector="windowSpec">windowSpec	"Tools.UIPainter new openOnClass: self andSelector: #windowSpec"	&lt;resource: #canvas&gt;	^#(#{UI.FullSpec} 		#window: 		#(#{UI.WindowSpec} 			#label: 'Salas' 			#min: #(#{Core.Point} 625 533 ) 			#max: #(#{Core.Point} 0 0 ) 			#bounds: #(#{Graphics.Rectangle} 371 94 996 634 ) ) 		#component: 		#(#{UI.SpecCollection} 			#collection: #(				#(#{UI.DataSetSpec} 					#properties: #(#{UI.PropertyListDictionary} #showHorizontalLines true #allowColumnResizing true #showVerticalLines true #allowColumnReordering false ) 					#layout: #(#{Graphics.LayoutFrame} 41 0 86 0 459 0 353 0 ) 					#name: #DatasetSalas 					#flags: 13 					#model: #aspSalas 					#columns: #(						#(#{UI.DataSetColumnSpec} 							#properties: #(#{UI.PropertyListDictionary} #allowSorting true #labelFromApplication false ) 							#model: #'aspSala id' 							#label: 'ID' 							#labelIsImage: false 							#width: 80 							#rendererType: #Text 							#editorType: #None 							#type: #number 							#noScroll: false ) 						#(#{UI.DataSetColumnSpec} 							#properties: #(#{UI.PropertyListDictionary} #allowSorting true #labelFromApplication false ) 							#model: #'aspSala nombre' 							#label: 'nombre' 							#labelIsImage: false 							#width: 80 							#rendererType: #Text 							#editorType: #None 							#noScroll: false ) 						#(#{UI.DataSetColumnSpec} 							#properties: #(#{UI.PropertyListDictionary} #allowSorting true #labelFromApplication false ) 							#model: #'aspSala permitePeliculas' 							#label: 'pelicula' 							#labelIsImage: false 							#width: 80 							#rendererType: #Text 							#editorType: #None 							#type: #text 							#noScroll: false 							#formatString: '' ) 						#(#{UI.DataSetColumnSpec} 							#properties: #(#{UI.PropertyListDictionary} #allowSorting true #labelFromApplication false ) 							#model: #'aspSala permiteTeatro' 							#label: 'teatro' 							#labelIsImage: false 							#width: 80 							#rendererType: #Text 							#editorType: #None 							#type: #text 							#noScroll: false 							#formatString: '' ) 						#(#{UI.DataSetColumnSpec} 							#properties: #(#{UI.PropertyListDictionary} #allowSorting true #labelFromApplication false ) 							#model: #'aspSala capacidad' 							#label: 'Capacidad' 							#labelIsImage: false 							#width: 80 							#rendererType: #Text 							#editorType: #None 							#type: #number 							#noScroll: false ) ) ) 				#(#{UI.ActionButtonSpec} 					#layout: #(#{Graphics.LayoutSizedOrigin} 471 0 97 0 80 30 ) 					#name: #botonNuevaSala 					#model: #agregarSala 					#label: 'Nueva Sala' 					#defaultable: true ) 				#(#{UI.ActionButtonSpec} 					#layout: #(#{Graphics.LayoutSizedOrigin} 471 0 145 0 80 30 ) 					#name: #botonModificarSala 					#model: #modificarSala 					#label: 'Editar Sala' 					#defaultable: true ) 				#(#{UI.ActionButtonSpec} 					#layout: #(#{Graphics.LayoutSizedOrigin} 471 0 192 0 80 30 ) 					#name: #botonEliminarSala 					#model: #eliminarSala 					#label: 'Eliminar Sala' 					#defaultable: true ) 				#(#{UI.ActionButtonSpec} 					#layout: #(#{Graphics.LayoutSizedOrigin} 41 0 374 0 100 30 ) 					#name: #ActionButton1 					#model: #botonDisponibilidad 					#label: 'Ver Disponibilidad' 					#defaultable: true ) ) ) )</body></methods><methods><class-id>WListaSalas</class-id> <category>actions</category><body package="Ventanas" selector="botonDisponibilidad">botonDisponibilidad	| sal venDisponibilidad |	sal := self aspSalas selection.	sal isNil		ifTrue: [Dialog warn: 'No hay sala seleccionada']		ifFalse: 			[venDisponibilidad := WDisponibilidadSala new.			venDisponibilidad salaSeleccionada: sal.			venDisponibilidad open]</body></methods><do-it>'----SNAPSHOT----'</do-it><do-it>"#('c:\Users\Asus\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im' 'May 22, 2026' '5:40:01 PM')""An image file c:\Users\Asus\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im was created at 17:40:01 on 22 de mayo de 2026."</do-it><methods><class-id>WDisponibilidadSala</class-id> <category>interface opening</category><body package="Ventanas" selector="postBuildWith:">postBuildWith: aBuilder
    | contenedor boton x y ancho alto separacion miSala prefVerde |
    super postBuildWith: aBuilder.
    
    "1. Atrapamos el Region"
    contenedor := (aBuilder componentAt: #contenedorButacas) widget.
    
    "2. Obtenemos la sala"
    miSala := self salaSeleccionada.
    miSala ifNil: [ ^self ].
    
    ancho := 30.
    alto := 30.
    separacion := 5.
    
    "3. Creamos la preferencia visual para pintar el botón"
    prefVerde := LookPreferences new setBackgroundColor: ColorValue green.
    
    "4. Generamos la cuadrícula"
    1 to: miSala filas do: [ :f |
        1 to: miSala butacasFila do: [ :c |
            
            boton := ActionButtonView new.
            boton model: (ValueHolder with: true).
            
            x := (c - 1) * (ancho + separacion).
            y := (f - 1) * (alto + separacion).
            boton bounds: (x @ y extent: ancho @ alto).
            
            "CORRECCIÓN: Usamos LookPreferences en lugar de backgroundColor:"
            boton lookPreferences: prefVerde.
            
            contenedor add: boton.
        ]
    ].</body></methods><methods><class-id>WDisponibilidadSala</class-id> <category>interface opening</category><body package="Ventanas" selector="postBuildWith:">postBuildWith: aBuilder
    | contenedor boton marco x y ancho alto separacion miSala |
    super postBuildWith: aBuilder.
    
    "1. Atrapamos el Region que definiste en el UI Painter"
    contenedor := (aBuilder componentAt: #contenedorButacas) widget.
    
    miSala := self salaSeleccionada.
    miSala ifNil: [ ^self ].
    
    ancho := 30.
    alto := 30.
    separacion := 5.
    
    1 to: miSala filas do: [ :f |
        1 to: miSala butacasFila do: [ :c |
            "2. Creamos el botón"
            boton := ActionButtonView new.
            boton model: (ValueHolder with: ' ').
            boton bounds: (0 @ 0 extent: ancho @ alto).
            
            "3. Usamos SimpleView para el marco que SÍ permite color"
            marco := SimpleView new.
            marco backgroundColor: ColorValue green.
            marco bounds: (0 @ 0 extent: ancho @ alto).
            
            "4. Agregamos el botón al marco"
            marco add: boton.
            
            "5. Posicionamos el marco dentro del contenedor"
            x := (c - 1) * (ancho + separacion).
            y := (f - 1) * (alto + separacion).
            marco translateBy: (x @ y).
            
            contenedor add: marco.
        ]
    ].</body></methods><methods><class-id>WDisponibilidadSala</class-id> <category>interface opening</category><body package="Ventanas" selector="postBuildWith:">postBuildWith: aBuilder
    | contenedor boton x y ancho alto separacion miSala |
    super postBuildWith: aBuilder.
    
    contenedor := (aBuilder componentAt: #contenedorButacas) widget.
    
    miSala := self salaSeleccionada.
    miSala ifNil: [ ^self ].
    
    ancho := 30.
    alto := 30.
    separacion := 5.
    
    1 to: miSala filas do: [ :f |
        1 to: miSala butacasFila do: [ :c |
            boton := ActionButtonView new.
            boton model: (ValueHolder with: 'Libre'). "Le ponemos un texto inicial"
            
            x := (c - 1) * (ancho + separacion).
            y := (f - 1) * (alto + separacion).
            boton bounds: (x @ y extent: ancho @ alto).
            
            "EN LUGAR DE COLOR, usamos el look por defecto del sistema"
            "Esto debería funcionar sin tirar errores"
            boton look: (View preferences lookPolicy).
            
            contenedor add: boton.
        ]
    ].</body></methods><methods><class-id>WDisponibilidadSala</class-id> <category>interface opening</category><body package="Ventanas" selector="postBuildWith:">postBuildWith: aBuilder	| contenedor boton x y ancho alto separacion miSala |	super postBuildWith: aBuilder.	contenedor := (aBuilder componentAt: #contenedorButacas) widget.	miSala := self salaSeleccionada.	miSala ifNil: [^self].	ancho := 30.	alto := 30.	separacion := 5.	1 to: miSala filas		do: 			[:f |			1 to: miSala butacasFila				do: 					[:c |					boton := ActionButtonView new.					boton model: (ValueHolder with: 'Libre').	"Le ponemos un texto inicial"					x := (c - 1) * (ancho + separacion).					y := (f - 1) * (alto + separacion).					boton bounds: (x @ y extent: ancho @ alto).					"EN LUGAR DE COLOR, usamos el look por defecto del sistema"					"Esto debería funcionar sin tirar errores"					boton look: View preferences lookPolicy.					contenedor add: boton]]</body></methods><methods><class-id>WDisponibilidadSala</class-id> <category>interface opening</category><body package="Ventanas" selector="postBuildWith:">postBuildWith: aBuilder
    | contenedor boton x y ancho alto separacion miSala |
    super postBuildWith: aBuilder.
    
    contenedor := (aBuilder componentAt: #contenedorButacas) widget.
    
    miSala := self salaSeleccionada.
    miSala ifNil: [ ^self ].
    
    ancho := 30.
    alto := 30.
    separacion := 5.
    
    1 to: miSala filas do: [ :f |
        1 to: miSala butacasFila do: [ :c |
            "Creamos un botón simple"
            boton := ActionButtonView new.
            
            "Posición"
            x := (c - 1) * (ancho + separacion).
            y := (f - 1) * (alto + separacion).
            boton bounds: (x @ y extent: ancho @ alto).
            
            "Texto del botón (identificador)"
            boton model: (ValueHolder with: (f asString, '-', c asString)).
            
            "Agregamos el botón al contenedor"
            contenedor add: boton.
        ]
    ].</body></methods><methods><class-id>WDisponibilidadSala</class-id> <category>interface opening</category><body package="Ventanas" selector="postBuildWith:">postBuildWith: aBuilder	| contenedor boton x y ancho alto separacion miSala |	super postBuildWith: aBuilder.	contenedor := (aBuilder componentAt: #contenedorButacas) widget.	miSala := self salaSeleccionada.	miSala ifNil: [^self].	ancho := 30.	alto := 30.	separacion := 5.	1 to: miSala filas		do: 			[:f |			1 to: miSala butacasFila				do: 					[:c |					"Creamos un botón simple"					boton := ActionButtonView new.					"Posición"					x := (c - 1) * (ancho + separacion).					y := (f - 1) * (alto + separacion).					boton bounds: (x @ y extent: ancho @ alto).					"Texto del botón (identificador)"					boton model: (ValueHolder with: f asString , '-' , c asString).					"Agregamos el botón al contenedor"					contenedor add: boton]]</body></methods><methods><class-id>WDisponibilidadSala</class-id> <category>interface opening</category><body package="Ventanas" selector="postBuildWith:">postBuildWith: aBuilder
