ass-id> <category>actions</category><body package="Ventanas" selector="darAlta">darAlta	| per nuevoSocio |	per := self aspPersonasN selection.	per isNil		ifTrue: [Dialog warn: 'No hay persona seleccionada']		ifFalse: 			[nuevoSocio := (Socio new)						id: (adm ultimosIds at: Administrador ultimoIdSocio) + 1;						fechaAlta: Date today;						idPersona: per id.						adm altaSocio: nuevoSocio.			"aspPersonasN list: ."]</body></methods><methods><class-id>WListaPersonasNoSocios</class-id> <category>actions</category><body package="Ventanas" selector="darAlta">darAlta	| per nuevoSocio |	per := self aspPersonasN selection.	per isNil		ifTrue: [Dialog warn: 'No hay persona seleccionada']		ifFalse: 			[(Dialog				confirm: '¿Está seguro que desea dar de alta como socio a: ' , per nombre						, '?')					ifFalse: [^self]					ifTrue: 						[nuevoSocio := (Socio new)									id: (adm ultimosIds at: Administrador ultimoIdSocio) + 1;									fechaAlta: Date today;									idPersona: per id.						adm altaSocio: nuevoSocio						"aspPersonasN list: ."]]</body></methods><methods><class-id>WListaPersonasNoSocios</class-id> <category>actions</category><body package="Ventanas" selector="darAlta">darAlta	| per nuevoSocio |	per := self aspPersonasN selection.	per isNil		ifTrue: [Dialog warn: 'No hay persona seleccionada']		ifFalse: 			[(Dialog				confirm: '¿Está seguro que desea dar de alta como socio a: ' , per nombre						, '?')					ifFalse: [^self]					ifTrue: 						[nuevoSocio := (Socio new)									id: (adm ultimosIds at: Administrador ultimoIdSocio) + 1;									fechaAlta: Date today;									idPersona: per id.						adm altaSocio: nuevoSocio.						self aspPersonasN list remove: per.						self aspPersonasN selection: nil]]</body></methods><do-it>'----SNAPSHOT----'</do-it><do-it>"#('/home/marito/vw8.2pul/bin/linuxx86_64/../../image/tpfinalPOO/tpfinalPOO.im' 'April 16, 2026' '10:05:12 PM')""An image file /home/marito/vw8.