    1 to: 10 do: [:i | opciones add: i].
    ^opcionesPuntaje isNil
        ifTrue: [opcionesPuntaje := opciones asValue]
        ifFalse: [opcionesPuntaje]</body></methods><do-it>'----SNAPSHOT----'</do-it><do-it>"#('c:\Users\Asus\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im' 'May 23, 2026' '11:57:38 PM')""An image file c:\Users\Asus\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im was created at 23:57:38 on 23 de mayo de 2026."</do-it><methods><class-id>WListaCriticas class</class-id> <category>interface specs</category><body package="Ventanas" selector="windowSpec">windowSpec	"Tools.UIPainter new openOnClass: self andSelector: #windowSpec"	&lt;resource: #canvas&gt;	^#(#{UI.FullSpec} 		#window: 		#(#{UI.WindowSpec} 			#label: 'Criticas' 			#bounds: #(#{Graphics.Rectangle} 288 31 1079 727 ) ) 		#component: 		#(#{UI.SpecCollection} 			#collection: #(				#(#{UI.GroupBoxSpec} 					#layout: #(#{Graphics.LayoutFrame} 31 0 47 0 296 0 515 0 ) 					#name: #GroupBox1 					#label: 'Lista de Criticas' ) 				#(#{UI.GroupBoxSpec} 					#layout: #(#{Graphics.LayoutFrame} 322 0 48 0 468 0 166 0 ) 					#name: #GroupBox2 					#label: 'Acciones' ) 				#(#{UI.DataSetSpec} 					#properties: #(#{UI.PropertyListDictionary} #showHorizontalLines true #allowColumnResizing true #showVerticalLines true #allowColumnReordering false ) 					#layout: #(#{Graphics.LayoutFrame} 35 0 69 0 290 0 474 0 ) 					#name: #Dataset1 					#flags: 13 					#model: #aspCriticas 					#columns: #(						#(#{UI.DataSetColumnSpec} 							#properties: #(#{UI.PropertyListDictionary} #allowSorting true #labelFromApplication false ) 							#model: #'aspCritica id' 							#label: 'id' 							#labelIsImage: false 							#width: 80 							#rendererType: #Text 							#editorType: #None 							#type: #number 							#noScroll: false ) 						#(#{UI.DataSetColumnSpec} 							#properties: #(#{UI.PropertyListDictionary} #allowSorting true #labelFromApplication false ) 							#model: #'aspCritica idCritico' 							#label: 'id Critico' 							#labelIsImage: false 							#width: 80 	