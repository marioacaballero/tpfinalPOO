							#type: #number 							#noScroll: false ) 						#(#{UI.DataSetColumnSpec} 							#properties: #(#{UI.PropertyListDictionary} #allowSorting true #labelFromApplication false ) 							#model: #'aspSocio fechaAlta' 							#label: 'Fecha Alta' 							#labelIsImage: false 							#width: 80 							#rendererType: #Text 							#editorType: #None 							#type: #date 							#noScroll: false 							#formatString: 'dd/mm/yyyy' ) ) ) 				#(#{UI.ActionButtonSpec} 					#layout: #(#{Graphics.LayoutSizedOrigin} 554 0 46 0 80 30 ) 					#name: #botonAltaSocio 					#model: #altaSocio 					#label: 'Nuevo Socio' 					#defaultable: true ) ) ) )</body></methods><remove-selector><class-id>Socio</class-id> <selector>agotada:</selector></remove-selector><remove-selector><class-id>Socio</class-id> <selector>agotada</selector></remove-selector><methods><class-id>Socio</class-id> <category>accessing</category><body package="TPFinal" selector="estado">estado	^estado</body></methods><methods><class-id>Socio</class-id> <category>accessing</category><body package="TPFinal" selector="estado:">estado: anObject	estado := anObject</body></methods><methods><class-id>WListaSocios class</class-id> <category>interface specs</category><body package="Ventanas" selector="windowSpec">windowSpec	"Tools.UIPainter new openOnClass: self andSelector: #windowSpec"	&lt;resource: #canvas&gt;	^#(#{UI.FullSpec} 		#window: 		#(#{UI.WindowSpec} 			#label: 'Socios' 			#min: #(#{Core.Point} 20 20 ) 			#max: #(#{Core.Point} 0 0 ) 			#bounds: #(#{Graphics.Rectangle} 560 277 1360 877 ) ) 		#component: 		#(#{UI.SpecCollection} 			#collection: #(				#(#{UI.DataSetSpec} 					#properties: #(#{UI.PropertyListDictionary} #showHorizontalLines true #allowColumnResizing true #showVerticalLines true #allowColumnReordering false ) 					#layout: #(#{Graphics.LayoutFrame} 164 0 37 0 502 0 427 0 ) 					#name: #DataSocios 					#flags: 13 					#model: #aspSocios 					#co