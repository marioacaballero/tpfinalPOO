e>false</private><indexed-type>none</indexed-type><inst-vars>id nombre dni fechaNacimiento sexo domicilio email celular borrado </inst-vars><class-inst-vars></class-inst-vars><imports></imports><category></category><attributes><package>TPFinal</package></attributes></class><methods><class-id>Persona</class-id> <category>accessing</category><body package="TPFinal" selector="borrado">borrado	^borrado</body></methods><methods><class-id>Persona</class-id> <category>accessing</category><body package="TPFinal" selector="borrado:">borrado: anObject	borrado := anObject</body></methods><methods><class-id>Persona</class-id> <category>initialize-release</category><body package="TPFinal" selector="initialize">initialize	"Initialize a newly created instance. This method must answer the receiver."	super initialize.	" *** Edit the following to properly initialize instance variables ***"	id := nil.	nombre := nil.	dni := nil.	fechaNacimiento := nil.	sexo := nil.	domicilio := nil.	email := nil.	celular := nil.	borrado := false.	" *** And replace this comment with additional initialization code *** "	^self</body></methods><methods><class-id>Administrador</class-id> <category>accessing</category><body package="TPFinal" selector="personas">personas	^personas select: [:per | per borrado = false]</body></methods><methods><class-id>Administrador</class-id> <category>accessing</category><body package="TPFinal" selector="personas">personas	^personas select: [:per | per borrado not]</body></methods><methods><class-id>Administrador</class-id> <category>personas</category><body package="TPFinal" selector="eliminarPersona:">eliminarPersona: idPersona	| persona |	persona := personas detect: [:per | per id = idPersona].	persona borrado: true</body></methods><methods><class-id>WListaPersonas</class-id> <category>actions</category><body package="Ventanas" selector="eliminarPersona">eliminarPersona	| per |	per := self aspPersonas selection.	per isNil		ifTrue: [Dialog warn: 'No hay persona seleccionada']		ifFalse: 			["adm eliminarPersona: per id"			Dialog warn: per id asString]</body></methods><methods><class-id>WListaPersonas</class-id> <category>actions</category><body package="Ventanas" selector="eliminarPersona">eliminarPersona	| per |	per := self aspPersonas selection.	per isNil		ifTrue: [Dialog warn: 'No hay persona seleccionada']		ifFalse: 			["adm eliminarPersona: per id"			Dialog warn: per id printString]</body></methods><methods><class-id>WListaPersonas</class-id> <category>actions</category><body package="Ventanas" selector="eliminarPersona">eliminarPersona	| per |	per := self aspPersonas selection.	per isNil		ifTrue: [Dialog warn: 'No hay persona seleccionada']		ifFalse: 			[adm eliminarPersona: per id.			"Dialog warn: per id printString"			aspPersonas list: adm personas]</body></methods><do-it>'----SNAPSHOT----'</do-it><do-it>"#('/home/mario/vw8.2pul/bin/linuxx86_64/imagenTPfinal/tpfinalPOO.im' 'November 11, 2025' '10:41:31 PM')""An image file /home/mario/vw8.2pul/bin/linuxx86_64/imagenTPfinal/tpfinalPOO.im was created at 10:41:31 PM on November 11, 2025."</do-it><methods><class-id>Administrador</class-id> <category>personas</category><body package="TPFinal" selector="guardarPersonas">guardarPersonas</body></methods><methods><class-id>Administrador</class-id> <category>personas</category><body package="TPFinal" selector="guardarPersonas">guardarPersonas	| pers bos |	pers := 'personas.bos' asFilename writeStream.	bos := BinaryObjectStorage onNew: pers.	bos nextPut: personas.	bos close</body></methods><methods><class-id>Administrador</class-id> <category>accessing</category><body package="TPFinal" selector="guardarTodo">guardarTodo	self guardarPersonas</body></methods><methods><class-id>WMenuAdministrador</class-id> <category>changing</category><body package="Ventanas" selector="changeRequest">change