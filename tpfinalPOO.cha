-vars><imports></imports><category></category><attributes><package>EjParcial2023</package></attributes></class><class><name>AutoresPorArticulo</name><environment>Smalltalk</environment><super>Core.Object</super><private>false</private><indexed-type>none</indexed-type><inst-vars>idArticulo titulo cantidadAutores </inst-vars><class-inst-vars></class-inst-vars><imports></imports><category></category><attributes><package>EjParcial2023</package></attributes></class><methods><class-id>OCS class</class-id> <category>instance creation</category><body package="EjParcial2023" selector="new">new	"Answer a newly created and initialized instance."	^super new initialize</body></methods><methods><class-id>OCS</class-id> <category>accessing</category><body package="EjParcial2023" selector="cantidadDeAutoresPorArticulo">cantidadDeAutoresPorArticulo	| cantidadAutores autPorArt listaAutoresPorArt |	listaAutoresPorArt := OrderedCollection new.	articulos do: 			[:art |			cantidadAutores := 0.			cantidadAutores := (asignaciones						select: [:asig | asig idArticulo = art id &amp; (asig rol = #autor)]) size.			autPorArt := (AutoresPorArticulo new)						idArticulo: art id;						titulo: art titulo;						cantidadAutores: cantidadAutores.			listaAutoresPorArt add: autPorArt].	^listaAutoresPorArt		asSortedCollection: [:x :y | x cantidadAutores &gt; y cantidadAutores]</body></methods><methods><class-id>OCS</class-id> <category>accessing</category><body package="EjParcial2023" selector="agregarArticulo:">agregarArticulo: unArticulo	articulos add: unArticulo</body></methods><methods><class-id>OCS</class-id> <category>accessing</category><body package="EjParcial2023" selector="listaDeAutores:">listaDeAutores: idArticulo	| asignacionesDeArticulo |	asignacionesDeArticulo := asignaciones				select: [:art | (art id = idArticulo) &amp; (art rol = #autor)].	^asignacionesDeArticulo		collect: [:asig | personas detect: [:per | per id = asig idPersona]]</body></methods><methods><class-id>OCS</class-id> <category>accessing</category><body package="EjParcial2023" selector="proponerEvaluadoresParaArticulo:">proponerEvaluadoresParaArticulo: idArticulo	| asigDeArticulo personasQueEvaluaron posiblesPersonas |	asigDeArticulo := asignaciones				select: [:asig | asig idArticulo = idArticulo &amp; (asig rol = #evaluador)].	personasQueEvaluaron := asigDeArticulo				collect: [:asig | personas detect: [:per | per id = asig idPersona]].	posiblesPersonas := personas				reject: [:per | (personasQueEvaluaron includes: per) not].	^posiblesPersonas	"falta verificar que no esten en mas de tres de articulos"</body></methods><methods><class-id>OCS</class-id> <category>initialize-release</category><body package="EjParcial2023" selector="initialize">initialize	"Initialize a newly created instance. This method must answer the receiver."	super initialize.	" *** Edit the following to properly initialize instance variables ***"	personas := OrderedCollection new.	articulos := OrderedCollection new.	asignaciones := OrderedCollection new.	" *** And replace this comment with additional initialization code *** "	^self</body></methods><methods><class-id>PersonaOCS class</class-id> <category>instance creation</category><body package="EjParcial2023" selector="new">new	"Answer a newly created and initialized instance."	^super new initialize</body></methods><methods><class-id>PersonaOCS</class-id> <category>accessing</category><body package="EjParcial2023" selector="domicilio:">domicilio: anObject	domicilio := anObject</body></methods><methods><class-id>PersonaOCS</class-id> <category>accessing</category><body package="EjParcial2023" selector="celular:">celular: anObject	celular := anObject</body></methods><methods><class-id>PersonaOCS</class-id> <category>accessing</category><body package="EjParcial2023" selector="dni:">dni: anObject	dni := anObject</body></methods><met