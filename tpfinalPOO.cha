 ensure: [bos close]]		ifFalse: [funciones := OrderedCollection new].	"----------RESERVAS-------------"	fileReservas := 'databaseReservas.b' asFilename.	fileReservas exists		ifTrue: 			[bos := BinaryObjectStorage onOldNoScan: fileReservas.			[reservas := bos contents] ensure: [bos close]]		ifFalse: [reservas := OrderedCollection new].	"----------ENTRADAS-------------"	fileEntradas := 'databaseEntradas.b' asFilename.	fileEntradas exists		ifTrue: 			[bos := BinaryObjectStorage onOldNoScan: fileEntradas.			[entradas := bos contents] ensure: [bos close]]		ifFalse: [entradas := OrderedCollection new].	"----------ACTUALIZACIONES-------------"	self actualizarUltimoIdPersona.	^self</body></methods><methods><class-id>WListaPersonas</class-id> <category>actions</category><body package="Ventanas" selector="modificarPersona">modificarPersona	| per ventanaPersona |	per := self aspPersonas selection.	per isNil		ifTrue: [Dialog warn: 'No hay persona seleccionada']		ifFalse: 			[ventanaPersona := WPersona new.			ventanaPersona persona: per.			ventanaPersona open.			ventanaPersona acepto ifTrue: [].						]</body></methods><methods><class-id>Administrador</class-id> <category>personas</category><body package="TPFinal" selector="modificarPersona:">modificarPersona: unaPersona	| persona |	persona := personas detect: [:p | p id = unaPersona id].	persona := unaPersona</body></methods><methods><class-id>Administrador</class-id> <category>personas</category><body package="TPFinal" selector="modificarPersona:">modificarPersona: unaPersona	| persona |	persona := personas detect: [:p | p id = unaPersona id].	persona nombre: unaPersona nombre.	persona dni: unaPersona dni.	persona fechaNacimiento: unaPersona fechaNacimiento.	persona domicilio: unaPersona domicilio.	persona celular: unaPersona celular</body></methods><methods><class-id>Administrador</class-id> <category>personas</category><body package="TPFinal" selector="modifica