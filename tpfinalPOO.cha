> <category>aspects</category><body package="Ventanas" selector="adm">adm^adm</body></methods><methods><class-id>WListaCriticas</class-id> <category>actions</category><body package="Ventanas" selector="botonAgregarCritica">botonAgregarCritica| pel venDA |	pel := self aspPeliculasObras selection.	pel isNil		ifTrue: [Dialog warn: 'No hay produccion seleccionada']		ifFalse: 			[venDA := WDetallesAvanzados new.			venDA adm: adm.			venDA aspPelicula value: pel.			venDA open]</body></methods><methods><class-id>WListaCriticas</class-id> <category>actions</category><body package="Ventanas" selector="botonAgregarCritica">botonAgregarCritica</body></methods><methods><class-id>WListaCriticas</class-id> <category>actions</category><body package="Ventanas" selector="botonAgregarCritica">botonAgregarCritica	|venSC |	venSC := WSeleccionarCritico new.	venSC adm: adm.	venSC open</body></methods><methods><class-id>WSeleccionarCritico</class-id> <category>aspects</category><body package="Ventanas" selector="adm:">adm: unAdministrador	adm := unAdministrador."	Dialog warn: adm personas printString.""	self aspCritico list: adm personas"</body></methods><methods><class-id>WSeleccionarCritico class</class-id> <category>interface specs</category><body package="Ventanas" selector="windowSpec">windowSpec	"Tools.UIPainter new openOnClass: self andSelector: #windowSpec"	&lt;resource: #canvas&gt;	^#(#{UI.FullSpec} 		#window: 		#(#{UI.WindowSpec} 			#label: 'Seleccionar critico para reseña' 			#bounds: #(#{Graphics.Rectangle} 461 153 905 576 ) ) 		#component: 		#(#{UI.SpecCollection} 			#collection: #(				#(#{UI.DataSetSpec} 					#properties: #(#{UI.PropertyListDictionary} #showHorizontalLines true #allowColumnResizing true #allowColumnReordering false #showVerticalLines true ) 					#layout: #(#{Graphics.LayoutFrame} 50 0 51 0 292 0 327 0 ) 					#name: #Dataset1 					#flags: 13 					#model: #aspCritico 					#columns: #(						#(#{UI.DataSetColumnSpec} 							#properties: #(#{UI.PropertyListDictionary} #allowSorting true #labelFromApplication false ) 							#model: #'aspCritico id' 							#label: 'id' 							#labelIsImage: false 							#width: 80 							#editorType: #InputField 							#type: #number 							#noScroll: false ) 						#(#{UI.DataSetColumnSpec} 							#properties: #(#{UI.PropertyListDictionary} #allowSorting true #labelFromApplication false ) 							#model: #'aspCritico nombreUsuario' 							#label: 'nombre usuario' 							#labelIsImage: false 							#width: 150 							#editorType: #InputField 							#noScroll: false ) ) ) 				#(#{UI.ActionButtonSpec} 					#layout: #(#{Graphics.LayoutSizedOrigin} 321 0 53 0 90 23 ) 					#name: #ActionButton1 					#model: #botonAgregarCritico 					#label: 'Nuevo Critico' 					#defaultable: true ) 				#(#{UI.ActionButtonSpec} 					#layout: #(#{Graphics.LayoutSizedOrigin} 321 0 91 0 90 23 ) 					#name: #ActionButton2 					#model: #botonSeleccionarCritico 					#label: 'Seleccionar' 					#defaultable: true ) ) ) )</body></methods><class><name>Administrador</name><environment>Smalltalk</environment><super>Core.Object</super><private>false</private><indexed-type>none</indexed-type><inst-vars>personas socios ultimosIds peliculas funciones salas butacas ultimoIdPelicula idPelicula criticos </inst-vars><class-inst-vars></class-inst-vars><imports></imports><category></category><attributes><package>TPFinal</package></attributes></class><methods><class-id>Administrador</class-id> <category>accessing</category><body package="TPFinal" selector="criticos">criticos	^criticos</body></methods><methods><class-id>Administrador</class-id> <category>accessing</category><body package="TPFinal" selector="criticos:">criticos: anObject	criticos := anObject</body></methods><methods><class-id>Administrador</class-id> <category>initialize-release</category><body package="TPFinal" selector="iniciarTodo">iniciarTodo	ultimosIds := Dictionary new.	self iniciarIds.	self iniciarPersonas.	self iniciarSocios.	self iniciarPeliculas.	self iniciarSalas.	self iniciarButacas.	self iniciarFunciones.	self iniciarCriticos.</body></methods><methods><class-id>Administrador</class-id> <category>socios</category><body package="TPFinal" selector="iniciarCriticos">iniciarCriticos	| fileCriticos bos |	fileCriticos := 'databaseCriticos.b' asFilename.	fileCriticos exists		ifTrue: 			[bos := BinaryObjectStorage onOldNoScan: fileCriticos readStream.			[criticos := bos contents asOrderedCollection] ensure: [bos close]]		ifFalse: 			[criticos := OrderedCollection new.			ultimosIds at: Administrador ultimoIdCritico put: 0]</body></methods><class><name>Administrador</name><environment>Smalltalk</environment><super>Core.Object</super><private>false</private><indexed-type>none</indexed-type><inst-vars>personas socios ultimosIds peliculas funciones salas butacas ultimoIdPelicula idPelicula criticos ultimoIdCritico </inst-vars><class-inst-vars></class-inst-vars><imports></imports><category></category><attributes><package>TPFinal</package></attributes></class><do-it>Administrador addInstVarName: 'ultimoIdCritico'</do-it><methods><class-id>Administrador</class-id> <category>accessing</category><body package="TPFinal" selector="ultimoIdCritico:">ultimoIdCritico: anObject	ultimoIdCritico := anObject</body></methods><methods><class-id>Administrador</class-id> <category>accessing</category><body package="TPFinal" selector="guardarTodo">guardarTodo	self guardarPersonas.	self guardarSocios.	self guardarPeliculas.	self guardarSalas.	self guardarButacas.	self guardarFunciones.	self guardarIds.	self guardarCriticos</body></methods><do-it>Administrador organization addCategory: #criticos</do-it><methods><class-id>Administrador</class-id> <category>criticos</category><body package="TPFinal" selector="guardarCriticos">guardarCriticos	| crit bos |	crit := 'databaseCriticos.b' asFilename writeStream.	bos := BinaryObjectStorage onNew: crit.	bos nextPutAll: criticos.	bos close</body></methods><methods><class-id>Administrador</class-id> <category>personas</category><body package="TPFinal" selector="actualizarUltimoIdCritico:">actualizarUltimoIdCritico: unId	ultimosIds at: Administrador ultimoIdCritico put: unId</body></methods><do-it>Administrador organization addCategory: #criticos</do-it><do-it>Administrador classifySymbol: #actualizarUltimoIdCritico: under: #criticos</do-it><methods><class-id>Administrador class</class-id> <category>ids</category><body package="TPFinal" selector="ultimoIdCritico">ultimoIdCritico	^'ultimoIdCritico'</body></methods><methods><class-id>Administrador</class-id> <category>accessing</category><body package="TPFinal" selector="criticos">criticos	^criticos select: [:crit | crit borrado not]</body></methods><methods><class-id>Administrador</class-id> <category>socios</category><body package="TPFinal" selector="eliminarCritico:">eliminarCritico: idCritico	| critico |	critico := criticos detect: [:crit | crit id = idCritico].	critico borrado: true</body></methods><methods><class-id>Administrador</class-id> <category>socios</category><body package="TPFinal" selector="agregarCritico:">agregarCritico: unCritico	criticos add: unCritico.	self actualizarUltimoIdCritico: unCritico id</body></methods><methods><class-id>WSeleccionarCritico class</class-id> <category>interface specs</category><body package="Ventanas" selector="windowSpec">windowSpec	"Tools.UIPainter new openOnClass: self andSelector: #windowSpec"	&lt;resource: #canvas&gt;	^#(#{UI.FullSpec} 		#window: 		#(#{UI.WindowSpec} 			#label: 'Seleccionar critico para reseña' 			#bounds: #(#{Graphics.Rectangle} 461 153 905 576 ) ) 		#component: 		#(#{UI.SpecCollection} 			#collection: #(				#(#{UI.DataSetSpec} 					#properties: #(#{UI.PropertyListDictionary} #showHorizon