istaSalas</class-id> <category>actions</category><body package="Ventanas" selector="agregarSala">agregarSala	| ventanaSala sala |	ventanaSala := WSala new.	sala := Sala new id: (adm ultimosIds at: Administrador ultimoIdSala) + 1.	ventanaSala sala: sala.	ventanaSala open.	ventanaSala acepto	ifTrue: 			[adm agregarSala: ventanaSala aspSala value.			aspSalas list: adm salas]</body></methods><methods><class-id>WListaSalas</class-id> <category>actions</category><body package="Ventanas" selector="modificarSala">modificarSala	| sal ventanaSala |	sal := self aspSalas selection.	sal isNil		ifTrue: [Dialog warn: 'No hay sala seleccionada']		ifFalse: 			[ventanaSala := WSala new.			ventanaSala sala: sal.			ventanaSala open.			ventanaSala acepto				ifTrue: 					[adm modificarSala: ventanaSala aspSala value.					aspSalas list: adm salas]]</body></methods><methods><class-id>WListaSalas</class-id> <category>actions</category><body package="Ventanas" selector="eliminarSala">eliminarSala	| sal |	sal := self aspSalas selection.	sal isNil		ifTrue: [Dialog warn: 'No hay sala seleccionada']		ifFalse: 			[adm eliminarSala: sal id.			"Dialog warn: per id printString"			aspSalas list: adm salas]</body></methods><class><name>Sala</name><environment>Smalltalk</environment><super>Core.Object</super><private>false</private><indexed-type>none</indexed-type><inst-vars>id nombre permitePeliculas permiteTeatro butacas butacasFila filas borrado </inst-vars><class-inst-vars></class-inst-vars><imports></imports><category></category><attributes><package>TPFinal</package></attributes></class><do-it>Sala addInstVarName: 'borrado'</do-it><methods><class-id>Sala</class-id> <category>accessing</category><body package="TPFinal" selector="borrado:">borrado: anObject	borrado := anObject</body></methods><methods><class-id>Sala</class-id> <category>accessing</category><body package="TPFinal" selector="borrado">borrado	^borrado</body>