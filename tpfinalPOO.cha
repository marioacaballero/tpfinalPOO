ge: false 							#width: 80 							#rendererType: #Text 							#editorType: #None 							#type: #number 							#noScroll: false 							#formatString: '' ) 						#(#{UI.DataSetColumnSpec} 							#properties: #(#{UI.PropertyListDictionary} #allowSorting true #labelFromApplication false ) 							#model: #'aspFuncion agotada' 							#label: 'Ocupacion' 							#labelIsImage: false 							#width: 80 							#rendererType: #Text 							#editorType: #None 							#type: #text 							#noScroll: false 							#formatString: '' ) ) ) 				#(#{UI.ActionButtonSpec} 					#layout: #(#{Graphics.LayoutSizedOrigin} 762 0 39 0 58 23 ) 					#name: #ActionButton1 					#model: #botonAgregarFuncion 					#label: 'Agregar' 					#defaultable: true ) 				#(#{UI.ActionButtonSpec} 					#layout: #(#{Graphics.LayoutSizedOrigin} 762 0 73 0 58 23 ) 					#name: #ActionButton2 					#model: #botonModificarFuncion 					#label: 'Modificar' 					#defaultable: true ) 				#(#{UI.ActionButtonSpec} 					#layout: #(#{Graphics.LayoutSizedOrigin} 762 0 107 0 58 23 ) 					#name: #ActionButton3 					#model: #botonEliminarFuncion 					#label: 'Eliminar' 					#defaultable: true ) 				#(#{UI.ActionButtonSpec} 					#layout: #(#{Graphics.LayoutSizedOrigin} 762 0 188 0 100 23 ) 					#name: #ActionButton4 					#model: #botonVerDisponibilidad 					#label: 'Ver Disponibilidad' 					#defaultable: true ) ) ) )</body></methods><methods><class-id>Administrador</class-id> <category>peliculas</category><body package="TPFinal" selector="duracionDePelicula:">duracionDePelicula: unIdPelicula	| peli |	peli := peliculas detect: [:p | p id = unIdPelicula] ifNone: [nil].	peli isNil ifTrue: [^0].	^peli duracion</body></methods><methods><class-id>Administrador</class-id> <category>funciones</category><body package="TPFinal" selector="existeSuperposicionCon:">existeSuperposicionCon: nuevaFuncion
	| funcionesMismoDiaYSala inicioNueva finNueva |
	
	"1. Filtramos solo las funciones de ESE dia y ESA sala (usamos funcionesActivas para ignorar las borradas)"
	funcionesMismoDiaYSala := self funciones select: [:f | 
		(f idSala = nuevaFuncion idSala) and: [f fecha = nuevaFuncion fecha]
	].
	
	"Si no hay funciones ese dia en esa sala, no hay choque posible"
	funcionesMismoDiaYSala isEmpty ifTrue: [^false].
	
	"2. Calculamos inicio y fin de la nueva funcion en segundos"
	inicioNueva := nuevaFuncion horaInicio asSeconds.
	"Sumamos los minutos de duracion convertidos a segundos (* 60)"
	finNueva := inicioNueva + ((self duracionDePelicula: nuevaFuncion idPeliculaObra) * 60).
	
	"3. Comparamos contra cada funcion existente"
	^funcionesMismoDiaYSala anySatisfy: [:funcionExistente | 
		| inicioExistente finExistente |
		
		"No nos comparamos con nosotros mismos (por si estamos modificando una funcion existente)"
		funcionExistente id ~= nuevaFuncion id 
			ifTrue: [
				inicioExistente := funcionExistente horaInicio asSeconds.
				finExistente := inicioExistente + ((self duracionDePelicula: funcionExistente idPeliculaObra) * 60).
				
				"Evaluamos si se pisan los horarios"
				(inicioNueva &lt; finExistente) and: [inicioExistente &lt; finNueva]
			]
			ifFalse: [ false ] "Si es la misma funcion, ignoramos"
	].</body></methods><do-it>Administrador organization addCategory: #funciones</do-it><do-it>Administrador classifySymbol: #existeSuperposicionCon: under: #funciones</do-it><methods><class-id>Administrador</class-id> <category>funciones</category><body package="TPFinal" selector="existeSuperposicionCon:">existeSuperposicionCon: nuevaFuncion	| funcionesMismoDiaYSala inicioNueva finNueva |		"1. Filtramos solo las funciones de ESE dia y ESA sala (ver como ignorar las borradas)"	funcionesMismoDiaYSala := self funciones select: [:f | 		(f idSala = nuevaFuncion idSala) and: [f fecha = nuevaFuncion fecha]	].		"Si no hay funciones ese dia en esa sala, no hay choque posible"	funcionesMismoDiaYSala isEmpty ifTrue: [^false].		"2. Calculamos inicio y fin de la nueva funcion en segundos"	inicioNueva := nuevaFuncion horaInicio asSeconds.	"Sumamos los minutos de duracion convertidos a segundos (* 60)"	finNueva := inicioNueva + ((self duracionDePelicula: nuevaFuncion idPeliculaObra) * 60).		"3. Comparamos contra cada funcion existente"	^funcionesMismoDiaYSala anySatisfy: [:funcionExistente | 		| inicioExistente finExistente |				"No nos comparamos con nosotros mismos (por si estamos modificando una funcion existente)"		funcionExistente id ~= nuevaFuncion id 			ifTrue: [				inicioExistente := funcionExistente horaInicio asSeconds.				finExistente := inicioExistente + ((self duracionDePelicula: funcionExistente idPeliculaObra) * 60).								"Evaluamos si se pisan los horarios"				(inicioNueva &lt; finExistente) and: [inicioExistente &lt; finNueva]			]			ifFalse: [ false ] "Si es la misma funcion, ignoramos"	].</body></methods><class><name>WFuncion</name><environment>Smalltalk</environment><super>UI.SimpleDialog</super><private>false</private><indexed-type>none</indexed-type><inst-vars>aspFuncion adm listaPadre </inst-vars><class-inst-vars></class-inst-vars><imports></imports><category></category><attributes><package>Ventanas</package></attributes></class><do-it>WFuncion addInstVarName: 'listaPadre'</do-it><methods><class-id>WFuncion</class-id> <category>actions</category><body package="Ventanas" selector="botonGuardarFuncion">botonGuardarFuncion
	"Antes de guardar, le preguntamos al Administrador si hay superposicion"
	(listaPadre adm existeSuperposicionCon: self aspFuncion value)
		ifTrue: [
			"Si choca, mostramos el cartel y NO guardamos (la ventana queda abierta)"
			Dialog warn: 'Error: El horario se superpone con otra función en esa misma sala.'.
		]
		ifFalse: [
			"Si esta todo OK, disparamos el guardado normal"
			self accept value: true.
			self closeRequest.
		]</body></methods><methods><class-id>Administrador</class-id> <category>funciones</category><body package="TPFinal" selector="existeSuperposicionCon:">existeSuperposicionCon: nuevaFuncion
	| funcionesMismoDiaYSala inicioNueva finNueva |
	
	"1. Filtramos solo las funciones de ESE dia y ESA sala"
	funcionesMismoDiaYSala := self funcionesActivas select: [:f | 
		(f idSala = nuevaFuncion idSala) and: [f fecha = nuevaFuncion fecha]
	].
	
	"Si no hay funciones ese dia en esa sala, pasa de largo"
	funcionesMismoDiaYSala isEmpty ifTrue: [^false].
	
	"2. Calculamos inicio y fin de la nueva funcion en segundos"
	inicioNueva := nuevaFuncion horaInicio asSeconds.
	finNueva := inicioNueva + ((self duracionDePelicula: nuevaFuncion idPeliculaObra) * 60).
	
	"3. Comparamos contra las demas"
	^funcionesMismoDiaYSala anySatisfy: [:funcionExistente | 
		| inicioExistente finExistente |
		
		"Ignoramos si se esta comparando con ella misma (en caso de modificacion)"
		funcionExistente id ~= nuevaFuncion id 
			ifTrue: [
				inicioExistente := funcionExistente horaInicio asSeconds.
				finExistente := inicioExistente + ((self duracionDePelicula: funcionExistente idPeliculaObra) * 60).
				
				"Esta condicion da true si se pisan"
				(inicioNueva &lt; finExistente) and: [inicioExistente &lt; finNueva]
			]
			ifFalse: [ false ]
	].</body></methods><methods><class-id>WListaFunciones</class-id> <category>actions</category><body package="Ventanas" selector="botonAgregarFuncion">botonAgregarFuncion	| venSL venPeli venFun nuevaFun salaSeleccionada peliSeleccionada |	venSL := WListaSalaSeleccion new.	venSL adm: adm.	venSL open.	venSL accept value ifFalse: [^self].	salaSeleccionada := venSL aspSalas selection.	venPeli := WListaPeliculaObraSeleccion new.	venPeli adm: adm.	venPeli open.	venPeli accept value ifFalse: [^self].	peliSeleccionada := venPeli aspPeliculasObras selection.	nuevaFun := Funcion new.	nuevaFun id: (adm ultimosIds at: Administrador ultimoIdFuncion) + 1.	nuevaFun idSala: salaSeleccionada id.	nuevaFun idPeliculaObra: peliSeleccionada id.	venFun := WFuncion new.	venFun funcion: nuevaFun.	venFun adm: adm.	venFun open.	venFun accept value		ifTrue: 			[Dialog warn: 'Guardando nueva función'.			adm agregarFuncion: venFun aspFuncion value.			adm funciones do: 					[:f |					f nombreSala: (adm salas detect: [:s | s id = f idSala]) nombre.					f nombreProduccion: (adm peliculas detect: [:p | p id = f idPeliculaObra])								titulo].			self aspFunciones list: adm funciones]</body></methods><methods><class-id>WFuncion</class-id> <category>actions</category><body package="Ventanas" selector="botonGuardarFuncion">botonGuardarFuncion
	"Le preguntamos al Administrador si choca"
	(adm existeSuperposicionCon: self aspFuncion value)
		ifTrue: [
			"Si da true, frenamos todo y mostramos cartel. La ventana NO se cierra."
			Dialog warn: 'Error: El horario se superpone con otra función en esa sala.'.
		]
		ifFalse: [
			"Si da false, está todo OK, dejamos que guarde y cierre como siempre"
			self accept value: true.
			self closeRequest.
		]</body></methods><do-it>'----SNAPSHOT----'</do-it><do-it>"#('c:\Users\Asus\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im' 'May 23, 2026' '8:47:32 PM')""An image file c:\Users\Asus\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im was created at 20:47:32 on 23 de mayo de 2026."</do-it><methods><class-id>WListaPeliculaObra class</class-id> <category>interface specs</category><body package="Ventanas" selector="windowSpec">windowSpec	"Tools.UIPainter new openOnClass: self andSelector: #windowSpec"	&lt;resource: #canvas&gt;	^#(#{UI.FullSpec} 		#window: 		#(#{UI.WindowSpec} 			#label: 'Peliculas y Obras' 			#bounds: #(#{Graphics.Rectangle} 107 31 1259 776 ) 			#flags: 8 ) 		#component: 		#(#{UI.SpecCollection} 			#collection: #(				#(#{UI.GroupBoxSpec} 					#layout: #(#{Graphics.LayoutFrame} 915 0 20 0 1068 0 169 0 ) 					#name: #GroupBox1 					#label: 'Produccion' ) 				#(#{UI.GroupBoxSpec} 					#layout: #(#{Graphics.LayoutFrame} 24 0 379 0 303 0 445 0 ) 					#name: #GroupBox2 					#label: 'Datos' ) 				#(#{UI.GroupBoxSpec} 					#layout: #(#{Graphics.LayoutFrame} 555 0 17 0 701 0 124 0 ) 					#name: #GroupBox3 					#label: 'Cartelera' ) 				#(#{UI.DataSetSpec} 					#properties: #(#{UI.PropertyListDictionary} #showHorizontalLines true #allowColumnResizing true #showVerticalLines true #allowColumnReordering false ) 					#layout: #(#{Graphics.LayoutFrame} 25 0 24 0 539 0 357 0 ) 					#name: #Dataset1 					#flags: 13 					#model: #aspPeliculasObras 					#columns: #(						#(#{UI.DataSetColumnSpec} 							#properties: #(#{UI.PropertyListDictionary} #allowSorting true #labelFromApplication false ) 							#model: #'aspPeliculaObra id' 							#label: 'Id' 							#labelIsImage: false 							#width: 80 							#rendererType: #Text 							#editorType: #None 							#type: #number 							#noScroll: false ) 						#(#{UI.DataSetColumnSpec} 							#properties: #(#{UI.PropertyListDictionary} #allowSorting true #labelF