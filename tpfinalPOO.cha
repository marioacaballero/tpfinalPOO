n idSala) and: [f fecha = nuevaFuncion fecha]	].		"Si no hay funciones ese dia en esa sala, pasa de largo"	funcionesMismoDiaYSala isEmpty ifTrue: [^false].		"2. Calculamos inicio y fin de la nueva funcion en segundos"	inicioNueva := nuevaFuncion horaInicio asSeconds.	finNueva := inicioNueva + ((self duracionDePelicula: nuevaFuncion idPeliculaObra) * 60).		"3. Comparamos contra las demas"	^funcionesMismoDiaYSala anySatisfy: [:funcionExistente | 		| inicioExistente finExistente |				"Ignoramos si se esta comparando con ella misma (en caso de modificacion)"		funcionExistente id ~= nuevaFuncion id 			ifTrue: [				inicioExistente := funcionExistente horaInicio asSeconds.				finExistente := inicioExistente + ((self duracionDePelicula: funcionExistente idPeliculaObra) * 60).								"Esta condicion da true si se pisan"				(inicioNueva &lt; finExistente) and: [inicioExistente &lt; finNueva]			]			ifFalse: [ false ]	].</body></methods><do-it>'----SNAPSHOT----'</do-it><do-it>"#('c:\Users\Asus\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im' 'May 23, 2026' '9:19:21 PM')""An image file c:\Users\Asus\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im was created at 21:19:21 on 23 de mayo de 2026."</do-it><do-it>'----SNAPSHOT----'</do-it><do-it>"#('c:\Users\Asus\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im' 'May 23, 2026' '9:20:57 PM')""An image file c:\Users\Asus\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im was created at 21:20:57 on 23 de mayo de 2026."</do-it><methods><class-id>WListaFunciones</class-id> <category>actions</category><body package="Ventanas" selector="botonModificarFuncion">botonModificarFuncion| Fun ventanaFuncion |	Fun := self aspFunciones selection.	Fun isNil		ifTrue: [Dialog warn: 'No hay funcion seleccionada']		ifFalse: 			[ventanaFuncion := WFuncion new.			ventanaFuncion funcion:Fun.			ventanaFuncion adm: adm.			ventanaFuncion open.			ventanaFuncion acepto				ifTrue: 					[adm modificarFuncion: ventanaFuncion aspFuncion value.					aspFunciones list: adm funciones]]</body></methods><do-it>'----SNAPSHOT----'</do-it><do-it>"#('c:\Users\Asus\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im' 'May 23, 2026' '10:24:42 PM')""An image file c:\Users\Asus\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im was created at 22:24:42 on 23 de mayo de 2026."</do-it><methods><class-id>WFuncion</class-id> <category>actions</category><body package="Ventanas" selector="botonGuardarFuncion">botonGuardarFuncion
    "Forzamos manualmente a cada adaptador a volcar su valor al objeto modelo"
    "Asumiendo que tus aspectos se llaman, por ejemplo: aspFecha, aspHoraInicio, etc."
    self aspFuncion fecha commit.
    self aspFuncion horaInicio commit.
    "O si tenés un adaptador para toda la funcion:"
    self aspFuncion commit. 

    "Ahora, como el objeto ya tiene los datos nuevos, validamos"
    (adm existeSuperposicionCon: self aspFuncion value)
        ifTrue: [ Dialog warn: 'Error: El horario se superpone...' ]
        ifFalse: [ 
            self accept value: true.
            self closeRequest.
        ]</body></methods><methods><class-id>WFuncion</class-id> <category>actions</category><body package="Ventanas" selector="botonGuardarFuncion">botonGuardarFuncion
    "Forzamos manualmente a cada adaptador a volcar su valor al objeto modelo"
    "Asumiendo que tus aspectos se llaman, por ejemplo: aspFecha, aspHoraInicio, etc."
    self aspFuncion fecha commit.
    self aspFuncion horaInicio commit.
    "O si tenés un adaptador para toda la funcion:"
    self aspFuncion commit. 

    "Ahora, como el objeto ya tiene los datos nuevos, validamos"
    (adm existeSuperposicionCon: self aspFuncion value)
        ifTrue: [ Dialog warn: 'Error: El horario se superpone con otra funcion' ]
        ifFalse: [ 
            self accept value: true.
            self closeRequest.
