n code *** "	^self</body></methods><methods><class-id>Administrador</class-id> <category>accessing</category><body package="TPFinal" selector="peliculas">peliculas	^peliculas reject: [:pel | pel borrado == true]</body></methods><do-it>'----SNAPSHOT----'</do-it><do-it>"#('c:\Users\Asus\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im' 'May 1, 2026' '1:13:40 PM')""An image file c:\Users\Asus\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im was created at 13:13:40 on 1 de mayo de 2026."</do-it><methods><class-id>WPelicula</class-id> <category>As yet unclassified</category><body package="Ventanas" selector="opcionesTipo">opcionesTipo	| opciones |	opciones := List new.	opciones add: 'Pelicula'.	opciones add: 'Obra Teatral'.	^opcionesCartel isNil		ifTrue: [opcionesCartel := opciones asValue]		ifFalse: [opcionesCartel]</body></methods><methods><class-id>WPelicula class</class-id> <category>interface specs</category><body package="Ventanas" selector="windowSpec">windowSpec	"Tools.UIPainter new openOnClass: self andSelector: #windowSpec"	&lt;resource: #canvas&gt;	^#(#{UI.FullSpec} 		#window: 		#(#{UI.WindowSpec} 			#label: 'Agregar Produccion' 			#min: #(#{Core.Point} 20 20 ) 			#max: #(#{Core.Point} 0 0 ) 			#bounds: #(#{Graphics.Rectangle} 328 114 1038 614 ) ) 		#component: 		#(#{UI.SpecCollection} 			#collection: #(				#(#{UI.GroupBoxSpec} 					#layout: #(#{Graphics.LayoutFrame} 100 0 413 0 490 0 459 0 ) 					#name: #GroupBox1 					#label: 'Acciones' ) 				#(#{UI.GroupBoxSpec} 					#layout: #(#{Graphics.LayoutFrame} 108 0 11 0 488 0 400 0 ) 					#name: #GroupBox2 					#label: 'Datos sobre la produccion' ) 				#(#{UI.InputFieldSpec} 					#layout: #(#{Graphics.LayoutFrame} 203 0 27 0 303 0 48 0 ) 					#name: #InputField1 					#model: #'aspPelicula id' 					#isReadOnly: true 					#type: #number ) 				#(#{UI.LabelSpec} 					#layout: #(#{Graphics.LayoutOrigin} 172 0 29 0 ) 					#name: #Label1 					#