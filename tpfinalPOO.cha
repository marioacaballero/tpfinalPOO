rSalas.	self iniciarButacas.	self iniciarFunciones</body></methods><do-it>'----SNAPSHOT----'</do-it><do-it>"#('/home/marito/vw8.2pul/bin/linuxx86_64/../../image/tpfinalPOO/tpfinalPOO.im' 'April 19, 2026' '6:43:10 PM')""An image file /home/marito/vw8.2pul/bin/linuxx86_64/../../image/tpfinalPOO/tpfinalPOO.im was created at 6:43:10 PM on April 19, 2026."</do-it><methods><class-id>WMenuAdministrador</class-id> <category>initialize-release</category><body package="Ventanas" selector="initialize">initialize	super initialize.	adm := Administrador new.	"Dialog warn: adm ultimosIds printString"</body></methods><methods><class-id>Administrador</class-id> <category>initialize-release</category><body package="TPFinal" selector="iniciarIds">iniciarIds	| fileIds bos datosCargados |	fileIds := 'databaseIds.b' asFilename.	fileIds exists		ifTrue: 			[bos := BinaryObjectStorage onOldNoScan: fileIds.			"1. Cargamos el objeto completo del archivo a una variable temporal"						[datosCargados := bos contents at: 1.self halt.			"2. Iteramos el diccionario cargado y pasamos los datos al nuestro"			datosCargados				keysAndValuesDo: [:clave :valor | ultimosIds at: clave put: valor]]					ensure: [bos close]]		ifFalse: 			[ultimosIds at: Administrador ultimoIdSocio put: 0.			ultimosIds at: Administrador ultimoIdPersona put: 0.			ultimosIds at: Administrador ultimoIdPelicula put: 0.			ultimosIds at: Administrador ultimoIdSala put: 0.			ultimosIds at: Administrador ultimoIdButaca put: 0]	"			[bos := BinaryObjectStorage onOldNoScan: fileIds.			[ultimosIds := bos contents at: 1] ensure: [bos close]]		Esta es la forma de Pascal		"</body></methods><methods><class-id>Administrador</class-id> <category>initialize-release</category><body package="TPFinal" selector="iniciarIds">iniciarIds	| fileIds bos datosCargados |	fileIds := 'databaseIds.b' asFilename.	fileIds exists		ifTrue: 			[bos := BinaryObjectStorage onOldNoScan: fileIds.			"1. Cargam