	^precioEntrada</body></methods><methods><class-id>Reserva</class-id> <category>accessing</category><body package="TPFinal" selector="precioEntrada:">precioEntrada: unPrecio
	precioEntrada := unPrecio</body></methods><methods><class-id>WListaReservas</class-id> <category>actions</category><body package="Ventanas" selector="botonNuevaReserva">botonNuevaReserva	| ventanaSocios ventanaFunciones ventanaDisponibilidad ventanaReserva socioSeleccionado funcionSeleccionada salaDeFuncion butacasElegidas nuevaReserva |	ventanaSocios := WSeleccionarSocio new.	ventanaSocios adm: adm.	ventanaSocios open.	ventanaSocios accept value ifFalse: [^self].	socioSeleccionado := ventanaSocios aspSocios selection.	ventanaFunciones := WSeleccionarFuncion new.	ventanaFunciones adm: adm.	ventanaFunciones open.	ventanaFunciones accept value ifFalse: [^self].	funcionSeleccionada := ventanaFunciones aspFunciones selection.	salaDeFuncion := adm salaConId: funcionSeleccionada idSala.	ventanaDisponibilidad := WDisponibilidadSala new.	ventanaDisponibilidad adm: adm.	ventanaDisponibilidad salaSeleccionada: salaDeFuncion.	ventanaDisponibilidad funcionSeleccionada: funcionSeleccionada.	ventanaDisponibilidad open.	ventanaDisponibilidad actualizar value ifFalse: [^self].	butacasElegidas := ventanaDisponibilidad butacasSeleccionadas.	nuevaReserva := Reserva new.	nuevaReserva id: (adm ultimosIds at: Administrador ultimoIdReserva) + 1.	nuevaReserva idSocio: socioSeleccionado id.	nuevaReserva idFuncion: funcionSeleccionada id.	nuevaReserva listaButacasReservadas: butacasElegidas.	nuevaReserva fechaReserva: Date today.	nuevaReserva fechaCancelacion: nuevaReserva calcularFechaCancelacion.	nuevaReserva		precioEntrada: (funcionSeleccionada calcularTotal: butacasElegidas size).	ventanaReserva := WReserva new.	ventanaReserva adm: adm.	ventanaReserva aspReserva value: nuevaReserva.	ventanaReserva open.	ventanaReserva accept value		ifTrue: 			[adm agregarReserva: nuevaReserva.			adm actualizarUltimoIdReserva: nuevaReserva id]</body></methods><do-it>'----SNAPSHOT----'</do-it><do-it>"#('c:\Users\Asus\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im' 'July 6, 2026' '10:25:53 PM')""An image file c:\Users\Asus\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im was created at 22:25:53 on 6 de julio de 2026."</do-it><methods><class-id>Reserva</class-id> <category>accessing</category><body package="TPFinal" selector="calcularFechaCancelacion">calcularFechaCancelacion
