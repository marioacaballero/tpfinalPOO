persona seleccionada']		ifFalse: 			[ventanaPersona := WPersona new.			ventanaPersona persona: per.			ventanaPersona open.			ventanaPersona acepto				ifTrue: 					[adm modificarPersona: ventanaPersona aspPersona value.					aspPersonas list: adm personas]]</body></methods><methods><class-id>WMenuAdministrador class</class-id> <category>interface specs</category><body package="Ventanas" selector="windowSpec">windowSpec	"Tools.UIPainter new openOnClass: self andSelector: #windowSpec"	&lt;resource: #canvas&gt;	^#(#{UI.FullSpec} 		#window: 		#(#{UI.WindowSpec} 			#label: 'Menu Administrador' 			#min: #(#{Core.Point} 20 20 ) 			#max: #(#{Core.Point} 0 0 ) 			#bounds: #(#{Graphics.Rectangle} 617 346 1017 796 ) ) 		#component: 		#(#{UI.SpecCollection} 			#collection: #(				#(#{UI.ActionButtonSpec} 					#layout: #(#{Graphics.LayoutSizedOrigin} 164 0 83 0 100 30 ) 					#name: #ButonMuestraPersonas 					#model: #muestraPersonas 					#label: 'Personas' 					#defaultable: true ) 				#(#{UI.ActionButtonSpec} 					#layout: #(#{Graphics.LayoutSizedOrigin} 164 0 129 0 100 30 ) 					#name: #ButonMuestraSocios 					#model: #muestraSocios 					#label: 'Socios' 					#defaultable: true ) 				#(#{UI.ActionButtonSpec} 					#layout: #(#{Graphics.LayoutSizedOrigin} 164 0 178 0 100 30 ) 					#name: #ButonMuestraPeliculas 					#model: #muestraPeliculas 					#label: 'Peliculas/Obras' 					#defaultable: true ) 				#(#{UI.ActionButtonSpec} 					#layout: #(#{Graphics.LayoutSizedOrigin} 164 0 220 0 100 30 ) 					#name: #ButonMuestraFunciones 					#model: #muestraFunciones 					#label: 'Funciones' 					#defaultable: true ) 				#(#{UI.ActionButtonSpec} 					#layout: #(#{Graphics.LayoutSizedOrigin} 164 0 268 0 100 30 ) 					#name: #ButonMuestraSalas 					#model: #muestraSalas 					#label: 'Salas' 					#defaultable: true ) 				#(#{UI.LabelSpec} 					#layout: #(#{Graphics.LayoutSizedOrigin} 135.5 0 26 0 200 20 ) 					#name: #Label1 					#label