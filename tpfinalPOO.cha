ue: [Dialog warn: 'No hay una critica seleccionada']	ifFalse: [Dialog informationSignal raiseWith: crit reseña]</body></methods><do-it>'----SNAPSHOT----'</do-it><do-it>"#('c:\Users\User\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im' 'May 21, 2026' '4:06:06 PM')""An image file c:\Users\User\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im was created at 16:06:06 on 21 de mayo de 2026."</do-it><methods><class-id>WListaCriticas</class-id> <category>actions</category><body package="Ventanas" selector="botonReseñaCompleta">botonReseñaCompleta	| crit |	crit := aspCriticas selection.	crit isNil	ifTrue: [Dialog warn: 'No hay una critica seleccionada']	ifFalse: [Dialog warn: crit reseña]</body></methods><methods><class-id>WSeleccionarCritico</class-id> <category>aspects</category><body package="Ventanas" selector="adm:">adm: unAdministrador	| critPelId criticosNoEnPel |	Dialog warn: unAdministrador printString.	adm := unAdministrador.	critPelId := (adm mostrarCriticasDe: idPelicula)				collect: [:c | c idCritico].	criticosNoEnPel := adm criticos				select: [:crit | (critPelId includes: crit id) not].	self aspCriticos list: criticosNoEnPel</body></methods><methods><class-id>WSeleccionarCritico</class-id> <category>aspects</category><body package="Ventanas" selector="adm:">adm: unAdministrador	| critPelId criticosNoEnPel |	Dialog warn: unAdministrador printString.	adm := unAdministrador.	"para colocar a los criticos que no hicieron la reseña de la pelicula"	critPelId := (adm mostrarCriticasDe: idPelicula)				collect: [:c | c idCritico].	criticosNoEnPel := adm criticos				select: [:crit | (critPelId includes: crit id) not].	self aspCriticos list: criticosNoEnPel</body></methods><do-it>'----SNAPSHOT----'</do-it><do-it>"#('c:\Users\User\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im' 'May 21, 2026' '4:42:00 PM')""An image file c:\Users\User\Documents\VisualWorks Projects\tpfinalPOO\tpfinalPOO.im was 