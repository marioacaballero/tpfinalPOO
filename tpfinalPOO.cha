dowSpec} 			#label: 'Lista Personas' 			#min: #(#{Core.Point} 20 20 ) 			#max: #(#{Core.Point} 0 0 ) 			#bounds: #(#{Graphics.Rectangle} 240 80 1040 680 ) ) 		#component: 		#(#{UI.SpecCollection} 			#collection: #(				#(#{UI.DataSetSpec} 					#properties: #(#{UI.PropertyListDictionary} #showHorizontalLines true #allowColumnResizing true #showVerticalLines true #allowColumnReordering false ) 					#layout: #(#{Graphics.LayoutSizedOrigin} 170 0 47 0 370 500 ) 					#name: #DataPersonas 					#flags: 13 					#model: #aspPersonas 					#columns: #(						#(#{UI.DataSetColumnSpec} 							#properties: #(#{UI.PropertyListDictionary} #allowSorting true #labelFromApplication false ) 							#model: #'aspPersona id' 							#label: 'ID' 							#labelIsImage: false 							#width: 80 							#rendererType: #Text 							#editorType: #None 							#type: #number 							#noScroll: false ) 						#(#{UI.DataSetColumnSpec} 							#properties: #(#{UI.PropertyListDictionary} #allowSorting true #labelFromApplication false ) 							#model: #'aspPersona nombre' 							#label: 'Nombre' 							#labelIsImage: false 							#width: 80 							#rendererType: #Text 							#editorType: #None 							#noScroll: false ) 						#(#{UI.DataSetColumnSpec} 							#properties: #(#{UI.PropertyListDictionary} #allowSorting true #labelFromApplication false ) 							#model: #'aspPersona dni' 							#label: 'DNI' 							#labelIsImage: false 							#width: 80 							#rendererType: #Text 							#editorType: #None 							#type: #number 							#noScroll: false ) 						#(#{UI.DataSetColumnSpec} 							#properties: #(#{UI.PropertyListDictionary} #allowSorting true #labelFromApplication false ) 							#model: #'aspPersona fechaNacimiento' 							#label: 'Fecha Nacimiento' 							#labelIsImage: false 							#width: 110 							#rendererType: #Text 							#editorType: #None 							#type: #date 							#noScroll: false 							#formatString: 'dd/mm/yyyy' ) ) ) 				#(#{UI.ActionButtonSpec} 					#properties: #(#{UI.PropertyListDictionary} #labelFromApplication false ) 					#layout: #(#{Graphics.LayoutSizedOrigin} 641 0 26 0 115 25 ) 					#name: #BotonAgregarPersona 					#model: #altaPersona 					#helpText: 'Agrega una persona a la lista del club' 					#label: 'Agregar Persona' 					#defaultable: true ) 				#(#{UI.ActionButtonSpec} 					#layout: #(#{Graphics.LayoutSizedOrigin} 641 0 66 0 115 25 ) 					#name: #BotonModificarPersona 					#model: #modificarPersona 					#helpText: 'Modifique los campos de la persona seleccionada en la lista' 					#label: 'Modificar Persona' 					#defaultable: true ) 				#(#{UI.ActionButtonSpec} 					#layout: #(#{Graphics.LayoutSizedOrigin} 641 0 107 0 115 25 ) 					#name: #BotonEliminarPersona 					#model: #eliminarPersona 					#helpText: 'Elimina una persona de la lista del club' 					#label: 'Eliminar Persona' 					#defaultable: true ) ) ) )</body></methods><methods><class-id>WListaPersonas</class-id> <category>aspects</category><body package="Ventanas" selector="aspPersona">aspPersona	"This method was generated by UIDefiner.  Any edits made here	may be lost whenever methods are automatically defined.  The	initialization provided below may have been preempted by an	initialize method."	^aspPersona isNil		ifTrue:			[aspPersona := nil asValue]		ifFalse:			[aspPersona]</body></methods><methods><class-id>WListaPersonas</class-id> <category>aspects</category><body package="Ventanas" selector="aspPersonas">aspPersonas	^aspPersonas isNil		ifTrue: 			[aspPersonas := SelectionInList new.			aspPersonas selectionIndexHolder				compute: [:v | self aspPersona value: aspPersonas selection].			aspPersonas]		ifFalse: [aspPersonas]</body></methods><methods><class-id>WListaPersonas</class-id> <category>accessing</category><body package="Ventanas" selector="adm:">adm: unAdministrador	adm := unAdministrador.	self aspPersonas list: adm personas</body></methods><methods><class-id>WListaPersonas</class-id> <category>accessing</category><body package="Ventanas" selector="adm">adm	^adm</body></methods><methods><class-id>WListaPersonas</class-id> <category>actions</category><body package="Ventanas" selector="altaPersona">altaPersona	| ventanaPersona nuevaPersona |	ventanaPersona := WPersona new.	nuevaPersona := Persona new				id: (adm ultimosIds at: Administrador ultimoIdPersona) + 1.	ventanaPersona persona: nuevaPersona.	ventanaPersona open.	ventanaPersona acepto		ifTrue: 			[adm agregarPersona: ventanaPersona aspPersona value.			aspPersonas list: adm personas]	"	Dialog warn: ventanaPersona aspPersona value printString"</body></methods><methods><class-id>WListaPersonas</class-id> <category>actions</category><body package="Ventanas" selector="eliminarPersona">eliminarPersona	| per |	per := self aspPersonas selection.	per isNil		ifTrue: [Dialog warn: 'No hay persona seleccionada']		ifFalse: 			[adm eliminarPersona: per id.			"Dialog warn: per id printString"			aspPersonas list: adm personas]</body></methods><methods><class-id>WListaPersonas</class-id> <category>actions</category><body package="Ventanas" selector="modificarPersona">modificarPersona	| per ventanaPersona |	per := self aspPersonas selection.	per isNil		ifTrue: [Dialog warn: 'No hay persona seleccionada']		ifFalse: 			[ventanaPersona := WPersona new.			ventanaPersona persona: per.			ventanaPersona open.			ventanaPersona acepto				ifTrue: 					[adm modificarPersona: ventanaPersona aspPersona value.					aspPersonas list: adm personas]]</body></methods><methods><class-id>WMenuAdministrador class</class-id> <category>interface specs</category><body package="Ventanas" selector="windowSpec">windowSpec	"Tools.UIPainter new openOnClass: self andSelector: #windowSpec"	&lt;resource: #canvas&gt;	^#(#{UI.FullSpec} 		#window: 		#(#{UI.WindowSpec} 			#label: 'Menu Administrador' 			#min: #(#{Core.Point} 20 20 ) 			#max