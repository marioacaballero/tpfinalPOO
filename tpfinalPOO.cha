sing</category><body package="TPFinal" selector="mostrarBanner">mostrarBanner	"Detecta el OS y abre la URL del banner en el navegador predeterminado"	| comando |	self banner ifNil: [^self].	"Salida temprana si no hay URL"	comando := nil.	OSHandle isMSWindows ifTrue: [comando := 'start '].	OSHandle isMacOSX ifTrue: [comando := 'open '].	OSHandle isUnix ifTrue: [comando := 'xdg-open '].	comando		ifNotNil: [ExternalProcess shOne: comando , self banner]		ifNil: 			["Si llegamos acá, el OS no es reconocido"			Dialog warn: 'Sistema operativo no soportado para apertura de URL']</body></methods><do-it>unaPelicula := PeliculaObra new.</do-it><do-it>unaPelicula banner: 'https://www.google.com'.</do-it><do-it>unaPelicula banner: 'https://www.google.com'.</do-it><do-it>unaPelicula mostrarBanner.</do-it><class><name>WPeliculaObra</name><environment>Smalltalk</environment><super>UI.ApplicationModel</super><private>false</private><indexed-type>none</indexed-type><inst-vars></inst-vars><class-inst-vars></class-inst-vars><imports></imports><category></category><attributes><package>Ventanas</package></attributes></class><component_definition_change><name>Ventanas</name> <type>package</type><definitionName>Root.Smalltalk.WPeliculaObra</definitionName> <definitionChange>removed</definitionChange></component_definition_change><component_definition_change><name>URISupport</name> <type>package</type><definitionName>Root.Smalltalk.WPeliculaObra</definitionName> <definitionChange>added</definitionChange></component_definition_change><class><name>PeliculaObra</name><environment>Smalltalk</environment><super>Core.Object</super><private>false</private><indexed-type>none</indexed-type><inst-vars>id titulo descripcion duracion clasificacion tipo elenco director criticas borrado estado banner </inst-vars><class-inst-vars></class-inst-vars><imports></imports><category></category><attributes><package>TPFinal</package></attributes></cla