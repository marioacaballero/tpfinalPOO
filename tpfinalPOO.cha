d> <selector>crear</selector></remove-selector><remove-selector><class-id>WPersona class</class-id> <selector>ver</selector></remove-selector><remove-selector><class-id>WPersona class</class-id> <selector>editar</selector></remove-selector><do-it>WPersona class organization removeCategory: #estados</do-it><methods><class-id>WListaPersonas</class-id> <category>actions</category><body package="Ventanas" selector="altaPersona">altaPersona	| ventanaPersona nuevaPersona |	ventanaPersona := WPersona new.	nuevaPersona := Persona new id: adm ultimoIdPersona + 1.	ventanaPersona persona: nuevaPersona.	ventanaPersona open.	"si acepta"	"adm personas add: aspPersona value.	adm actualizarUltimoIdPersona."</body></methods><methods><class-id>WListaPersonas</class-id> <category>actions</category><body package="Ventanas" selector="modificarPersona">modificarPersona	| per ventanaPersona |	per := self aspPersonas selection.	per isNil		ifTrue: [Dialog warn: 'No hay persona seleccionada']		ifFalse: 			[ventanaPersona := WPersona new.			ventanaPersona persona: per.			ventanaPersona open]</body></methods><methods><class-id>WListaPersonas</class-id> <category>actions</category><body package="Ventanas" selector="eliminarPersona">eliminarPersona	| per |	per := self aspPersonas selection.	per isNil		ifTrue: [Dialog warn: 'No hay persona seleccionada']		ifFalse: [adm eliminarPersona: per id]</body></methods><remove-selector><class-id>WListaPersonas</class-id> <selector>volerAtras</selector></remove-selector><remove-selector><class-id>WPersona</class-id> <selector>botonModificar</selector></remove-selector><methods><class-id>WPersona class</class-id> <category>interface specs</category><body package="Ventanas" selector="windowSpec">windowSpec	"Tools.UIPainter new openOnClass: self andSelector: #windowSpec"	&lt;resource: #canvas&gt;	^#(#{UI.FullSpec} 		#window: 		#(#{UI.WindowSpec} 			#label: 'Persona' 			#bounds: #(#{Graph